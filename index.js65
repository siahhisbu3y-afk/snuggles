    case"verify":{
      const username=ctx.gs("username")||ctx.ga(0);if(!username)return ctx.reply({embeds:[E.w("Usage: `s!verify <robloxUsername>`")]},true);
      if(ctx.slash)await ctx.i.deferReply({flags:MessageFlags.Ephemeral}).catch(()=>{});else ctx.channel.sendTyping().catch(()=>{});
      const rxUser=await fetchRxUser(username);if(!rxUser)return ctx.reply({embeds:[E.er("Roblox User Not Found").setDescription(`Could not find **${username}** on Roblox. Check the spelling.`)]},true);
      const code=genCode();data.verificationCodes[user.id]={code,robloxName:rxUser.name,robloxId:rxUser.id,expiresAt:Date.now()+10*60000};saveData();
      return ctx.reply({embeds:[E.rb("ðŸŸ£ Roblox Verification â€” Step 1").setDescription([`**Found:** [${rxUser.name}](https://www.roblox.com/users/${rxUser.id}/profile) *(ID: \`${rxUser.id}\`)*`,"","**How to Verify:**","â‘  Copy the code below","â‘¡ Go to [roblox.com/my/account](https://www.roblox.com/my/account) â†’ **About** tab","â‘¢ Paste the code anywhere in your bio and **save**","â‘£ Run `/checkverify <code>` here","","> â° Code expires in **10 minutes**"].join("\n")).addFields({name:"ðŸ”‘ Your Verification Code",value:`\`\`\`${code}\`\`\``}).setFooter({text:"Paste in Roblox bio â†’ /checkverify"}).setTimestamp()]},true);
    }
    case"checkverify":{
      const code=(ctx.gs("code")||ctx.ga(0)||"").toUpperCase();if(!code)return ctx.reply({embeds:[E.w("Usage: `s!checkverify <code>`")]},true);
      if(ctx.slash)await ctx.i.deferReply({flags:MessageFlags.Ephemeral}).catch(()=>{});
      const pending=data.verificationCodes[user.id];
      if(!pending)return ctx.reply({embeds:[E.er("No Pending Verification").setDescription("Start with `/verify <username>` first.")]},true);
      if(Date.now()>pending.expiresAt){delete data.verificationCodes[user.id];saveData();return ctx.reply({embeds:[E.er("Code Expired").setDescription("Run `/verify` again to get a new code.")]},true);}
      if(code!==pending.code)return ctx.reply({embeds:[E.er("Incorrect Code").setDescription(`Your code is: \`${pending.code}\``)]},true);
      const profile=await fetchRxProfile(pending.robloxId);
      if(!profile||!profile.description.includes(pending.code))return ctx.reply({embeds:[E.w("Code Not Found in Bio").setDescription(`We checked **${pending.robloxName}**'s profile but couldn't find the code.\n\nMake sure \`${pending.code}\` is in your **About** section, save it, then try again.`)]},true);
      const avatar=await fetchRxAvatar(pending.robloxId);
      data.robloxVerified[user.id]={robloxId:pending.robloxId,robloxName:pending.robloxName,robloxDisplayName:profile.displayName,verifiedAt:new Date().toISOString(),discordTag:user.tag};
