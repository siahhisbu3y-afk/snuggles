  .setFooter({text:`${{partnership:"ðŸ¤",inquiry:"ðŸ’¬",forum:"ðŸ“‹",chat:"ðŸ¤–"}[type]||"ðŸ¤–"} ${model||"AI"} Â· ${user}`})
  .setTimestamp();

async function logMod(guild,emb){const id=data.modLogChannels[guild?.id];if(!id)return;const ch=await guild.channels.fetch(id).catch(()=>null);if(ch?.isTextBased())ch.send({embeds:[emb]}).catch(()=>{});}
async function errLog(err,ctx=""){try{if(!ENV.HOME||!ENV.ERR)return;const g=client.guilds.cache.get(ENV.HOME);if(!g)return;const ch=await g.channels.fetch(ENV.ERR).catch(()=>null);if(!ch?.isTextBased())return;ch.send({embeds:[E.er("ðŸš¨ Error").addFields({name:"Context",value:ctx||"â€”"},{name:"Error",value:`\`\`\`${String(err?.message||err).slice(0,900)}\`\`\``}).setTimestamp()]});}catch{}}
async function rep(interaction,payload,eph=false){try{const flags=eph?MessageFlags.Ephemeral:undefined;const opt=typeof payload==="string"?{content:payload,flags}:{...payload,flags};if(interaction.deferred||interaction.replied)return interaction.editReply(opt);return interaction.reply(opt);}catch(e){console.error("[rep]",e.message);}}

// â”€â”€ SLASH COMMANDS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function buildSlash(){
  function o(b,type,name,desc,req,extra){
    const m={string:"addStringOption",integer:"addIntegerOption",user:"addUserOption",role:"addRoleOption",channel:"addChannelOption"};
    return b[m[type]](opt=>{
      opt.setName(name).setDescription(desc);
      if(req!=null)opt.setRequired(req);
      if(extra?.min!=null)opt.setMinValue(extra.min);
      if(extra?.max!=null)opt.setMaxValue(extra.max);
      if(extra?.choices)opt.addChoices(...extra.choices);
      return opt;
    });
  }
  const statusChoices=Object.entries(OS).map(([v,s])=>({name:`${s.emoji} ${s.label}`,value:v}));
  const styleChoices=Object.keys(IMG_STYLES).map(s=>({name:s,value:s}));
  const scriptChoices=[{name:"UI",value:"ui"},{name:"DataStore",value:"datastore"},{name:"RemoteEvent",value:"remote"},{name:"Movement",value:"movement"},{name:"Admin System",value:"admin"}];
  const rpsChoices=[{name:"Rock ðŸª¨",value:"rock"},{name:"Paper ðŸ“„",value:"paper"},{name:"Scissors âœ‚ï¸",value:"scissors"}];
  const actionChoices=[{name:"Kick",value:"kick"},{name:"Ban",value:"ban"},{name:"Alert Only",value:"none"}];
  const nukeChoices=[{name:"Ban",value:"ban"},{name:"Kick",value:"kick"},{name:"Strip Roles",value:"strip"}];

  const simple=[
    ["help","ðŸ“– All commands",[["integer","page","Page 1-6",false,{min:1,max:6}]]],
    ["info","ðŸ§¸ Bot info"],["ping","ðŸ“ Latency"],["status","ðŸŸ¢ Status"],["rules","ðŸ“œ Rules"],
    ["uptime","â±ï¸ Uptime"],["invite","ðŸ”— Invite bot"],["setup","âš™ï¸ Setup guide"],
    ["ai","ðŸ¤– Chat with AI",[["string","message","Your message",true]]],
    ["ai-reset","ðŸ”„ Clear AI history"],
    ["imagine","ðŸŽ¨ Generate image",[["string","prompt","Describe image",true],["string","style","Art style",false,{choices:styleChoices}]]],
    ["aioff","ðŸ”‡ Disable AI in ticket"],["aion","ðŸ”Š Enable AI in ticket"],
    ["services","ðŸ›ï¸ Services"],["prices","ðŸ’³ Pricing"],["pay","ðŸ’¸ Payment links"],
    ["orderinfo","ðŸ“¦ Check order",[["integer","id","Order ID",true]]],
    ["discount","ðŸŽŸï¸ Loyalty discount"],["ticket","ðŸŽ« Open ticket"],
    ["portfolio","ðŸŽ¨ Portfolio",[["integer","page","Page",false]]],
    ["script","ðŸ“œ Lua scripts",[["string","type","Type",true,{choices:scriptChoices}]]],
    ["snippet","ðŸ’¡ Random snippet"],["docs","ðŸ“š Docs"],["debug","ðŸ› Bug template"],["tip","ðŸ’¡ Tip"],
    ["level","ðŸ“Š Check XP",[["user","user","User",false]]],
    ["rank","ðŸ… Stats card",[["user","user","User",false]]],
    ["leaderboard","ðŸ† Top 10 XP"],
    ["balance","ðŸ’° Balance",[["user","user","User",false]]],
    ["dowork","ðŸ’¼ Earn coins"],["daily","ðŸŽ Daily reward"],["shop","ðŸ›’ Coin shop"],
    ["buy","ðŸ›ï¸ Buy item",[["string","item","Item ID",true]]],
    ["review","â­ Submit review",[["integer","rating","1-5 stars",true,{min:1,max:5}],["string","type","Commission type",true],["string","message","Your review",true]]],
    ["vouch","âœ… Quick vouch",[["string","text","Your vouch",true]]],
    ["quote","ðŸ’­ Quote"],["meme","ðŸ˜‚ Meme"],
    ["8ball","ðŸŽ± Magic 8-ball",[["string","question","Your question",true]]],
    ["rate","ðŸ“Š Rate something",[["string","thing","What to rate",true]]],
    ["coinflip","ðŸª™ Flip coin"],
    ["roll","ðŸŽ² Roll dice",[["integer","max","Max value",false,{min:2,max:10000}]]],
    ["rps","ðŸŽ® Rock paper scissors",[["string","choice","Your pick",true,{choices:rpsChoices}]]],
    ["trivia","ðŸ§  Scripting trivia"],
    ["remindme","â° Set reminder",[["string","time","e.g. 10m, 1h",true],["string","message","Reminder message",true]]],
    ["color","ðŸŽ¨ Preview hex color",[["string","hex","Hex e.g. FF8FB1",true]]],
    ["calc","ðŸ§® Calculator",[["string","expression","Math expression",true]]],
    ["userinfo","ðŸ‘¤ User details",[["user","user","User",false]]],
    ["serverinfo","ðŸ  Server details"],
    ["avatar","ðŸ–¼ï¸ Get avatar",[["user","user","User",false]]],
    ["banner","ðŸ–¼ï¸ Get banner",[["user","user","User",false]]],
    ["servericon","ðŸ–¼ï¸ Server icon"],["stats","ðŸ“ˆ Bot stats"],
    ["invites","ðŸ“¨ Invite count",[["user","user","User",false]]],
    ["inviteleaderboard","ðŸ“¨ Top inviters"],
    ["verify","ðŸŸ£ Link Roblox",[["string","username","Roblox username",true]]],
    ["checkverify","âœ… Complete verify",[["string","code","Verification code",true]]],
    ["whois","ðŸ” Roblox lookup",[["user","user","Discord user",false]]],
    ["unverify","âŒ Unlink Roblox"],
    ["verifypanel","ðŸŸ£ Post verify panel",[["channel","channel","Channel",true]]],
    ["reportscammer","ðŸš¨ Report scammer",[["user","user","Scammer",true],["string","evidence","Evidence",true],["string","amount","Amount scammed",false],["string","roblox","Roblox username",false]]],
    ["scammerlist","ðŸ“‹ Scam reports"],
    ["setscamchannel","ðŸš¨ Set scam channel",[["channel","channel","Channel",true]]],
    ["ban","ðŸ”¨ Ban member",[["user","user","User",true],["string","reason","Reason",false],["integer","days","Delete msg days (0-7)",false,{min:0,max:7}]]],
    ["softban","ðŸ§¹ Softban",[["user","user","User",true],["string","reason","Reason",false]]],
    ["kick","ðŸ‘¢ Kick member",[["user","user","User",true],["string","reason","Reason",false]]],
    ["mute","ðŸ”‡ Timeout member",[["user","user","User",true],["string","duration","e.g. 10m, 1h",true],["string","reason","Reason",false]]],
    ["unmute","ðŸ”Š Remove timeout",[["user","user","User",true]]],
    ["warn","âš ï¸ Warn member",[["user","user","User",true],["string","reason","Reason",true]]],
    ["warns","ðŸ“‹ View warnings",[["user","user","User",true]]],
    ["unwarn","âœ… Remove warning",[["integer","id","Warning ID",true]]],
    ["clearwarns","ðŸ—‘ï¸ Clear warnings",[["user","user","User",true]]],
    ["modlogs","ðŸ““ Mod history",[["user","user","User",true]]],
    ["purge","ðŸ—‘ï¸ Bulk delete",[["integer","count","1-100",true,{min:1,max:100}],["user","user","Filter user",false]]],
    ["lock","ðŸ”’ Lock channel"],["unlock","ðŸ”“ Unlock channel"],
    ["slowmode","ðŸ¢ Set slowmode",[["integer","seconds","0-21600",true,{min:0,max:21600}]]],
    ["nick","âœï¸ Set nickname",[["user","user","User",true],["string","name","New nickname",false]]],
    ["announce","ðŸ“¢ Announcement",[["string","message","Content",true],["channel","channel","Target channel",false]]],
    ["say","ðŸ’¬ Send as bot",[["string","message","Message",true]]],
    ["embed","ðŸ“‹ Custom embed",[["string","title","Title",true],["string","body","Body",true],["string","color","Hex color",false]]],
    ["poll","ðŸ“Š Create poll",[["string","question","Question",true],["string","options","Options separated by |",true]]],
    ["giveaway","ðŸŽ‰ Start giveaway",[["string","duration","e.g. 1h, 1d",true],["string","prize","Prize",true],["integer","winners","Winners (default 1)",false,{min:1,max:10}]]],
    ["addorder","ðŸ“¦ Add order",[["user","user","Customer",true],["string","details","Details",true]]],
    ["updateorder","ðŸ”„ Update order",[["integer","id","Order ID",true],["string","status","Status",true,{choices:statusChoices}],["string","note","Note",false]]],
    ["complete","âœ… Mark order complete",[["integer","id","Order ID",true]]],
    ["blacklist","ðŸš« Toggle blacklist",[["user","user","User",true]]],
    ["setlog","ðŸ““ Set mod log channel",[["channel","channel","Channel",false]]],
    ["setreviews","â­ Set reviews channel",[["channel","channel","Channel",false]]],
    ["settranscripts","ðŸ“„ Set transcripts channel",[["channel","channel","Channel",false]]],
    ["setverifyrole","ðŸŸ£ Set verify role",[["role","role","Role",true]]],
    ["setlevelupchannel","ðŸ“Š Set level-up channel",[["channel","channel","Channel",true]]],
    ["ticketpanel","ðŸŽ« Post ticket panel"],
    ["close","ðŸ”’ Close ticket",[["string","reason","Reason",true]]],
    ["addnote","ðŸ“ Add staff note",[["string","text","Note",true]]],
    ["givecoins","ðŸ’° Give coins",[["user","user","User",true],["integer","amount","Amount",true,{min:1}]]],
  ];

  const cmds = simple.map(([name,desc,opts])=>{
    let b=new SlashCommandBuilder().setName(name).setDescription(desc);
    if(opts)for(const opt of opts)b=o(b,...opt);
    return b;
  });

  const rr=new SlashCommandBuilder().setName("reactionrole").setDescription("ðŸŽ­ Reaction roles");
  rr.addSubcommand(s=>{ let b=s.setName("add").setDescription("Add reaction role"); b=o(b,"string","messageid","Message ID",true); b=o(b,"string","emoji","Emoji",true); b=o(b,"role","role","Role",true); return b; });
  rr.addSubcommand(s=>{ let b=s.setName("remove").setDescription("Remove reaction role"); b=o(b,"string","messageid","Message ID",true); b=o(b,"string","emoji","Emoji",true); return b; });
  rr.addSubcommand(s=>s.setName("list").setDescription("List reaction roles"));
  rr.addSubcommand(s=>{ let b=s.setName("panel").setDescription("Post role panel"); b=o(b,"string","title","Panel title",true); b=o(b,"string","description","Panel description",true); return b; });
  cmds.push(rr);

  const ar=new SlashCommandBuilder().setName("antiraid").setDescription("ðŸ›¡ï¸ Anti-Raid config");
  ar.addSubcommand(s=>s.setName("enable").setDescription("Enable anti-raid"));
  ar.addSubcommand(s=>s.setName("disable").setDescription("Disable anti-raid"));
  ar.addSubcommand(s=>s.setName("status").setDescription("View settings"));
  ar.addSubcommand(s=>{ let b=s.setName("config").setDescription("Configure"); b=o(b,"integer","threshold","Joins to trigger",false,{min:2,max:50}); b=o(b,"integer","window","Window seconds",false,{min:3,max:60}); b=o(b,"string","action","Action",false,{choices:actionChoices}); b=o(b,"integer","autounlock","Auto-unlock seconds",false,{min:0,max:3600}); b=o(b,"channel","notify","Notify channel",false); return b; });
  ar.addSubcommand(s=>o(s.setName("whitelist").setDescription("Exempt a user"),"user","user","User",true));
  ar.addSubcommand(s=>o(s.setName("unwhitelist").setDescription("Remove exemption"),"user","user","User",true));
  cmds.push(ar);

  const an=new SlashCommandBuilder().setName("antinuke").setDescription("â˜¢ï¸ Anti-Nuke config");
  an.addSubcommand(s=>s.setName("enable").setDescription("Enable anti-nuke"));
  an.addSubcommand(s=>s.setName("disable").setDescription("Disable anti-nuke"));
  an.addSubcommand(s=>s.setName("status").setDescription("View settings"));
  an.addSubcommand(s=>{ let b=s.setName("config").setDescription("Configure"); b=o(b,"integer","banth","Ban threshold",false,{min:1,max:20}); b=o(b,"integer","channelth","Channel delete threshold",false,{min:1,max:10}); b=o(b,"integer","roleth","Role delete threshold",false,{min:1,max:10}); b=o(b,"integer","kickth","Kick threshold",false,{min:1,max:20}); b=o(b,"string","action","Action",false,{choices:nukeChoices}); b=o(b,"channel","notify","Notify channel",false); return b; });
  an.addSubcommand(s=>o(s.setName("trust").setDescription("Trust a user"),"user","user","User",true));
  an.addSubcommand(s=>o(s.setName("untrust").setDescription("Remove trust"),"user","user","User",true));
  cmds.push(an);

  const bk=new SlashCommandBuilder().setName("backup").setDescription("ðŸ’¾ Server backup");
  bk.addSubcommand(s=>s.setName("create").setDescription("Create a backup"));
  bk.addSubcommand(s=>s.setName("list").setDescription("List saved backups"));
  bk.addSubcommand(s=>o(s.setName("view").setDescription("View a backup"),"string","id","Backup ID",true));
  cmds.push(bk);

  return cmds.map(c=>c.toJSON());
}
const slashCommands=buildSlash();

async function registerSlash(){
  if(!CLIENT_ID||!TOKEN)return console.warn("âš ï¸ Skipping slash registration");
  try{
    const rest=new REST({version:"10"}).setToken(TOKEN);
    console.log(`ðŸ“¡ Registering ${slashCommands.length} slash commandsâ€¦`);
    await rest.put(Routes.applicationCommands(CLIENT_ID),{body:slashCommands});
    console.log(`âœ… Registered ${slashCommands.length} slash commands`);
  }catch(e){console.error("Slash registration failed:",e.message);}
}

