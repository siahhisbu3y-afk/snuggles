    case"warns":{if(!hP(member,PermissionFlagsBits.ModerateMembers))return ctx.reply({embeds:[E.er("You need **Moderate Members** permission.")]},true);const target=ctx.gu("user");if(!target)return ctx.reply({embeds:[E.w("Provide a user.")]},true);const list=(data.warns[target.id]||[]).filter(w=>!w.type||w.type==="warn");const emb=E.mk(list.length?C.warn:C.success,`âš ï¸ Warnings â€” ${target.username}`).setThumbnail(target.displayAvatarURL());if(!list.length)emb.setDescription("âœ… This user has no warnings.");else list.slice(-10).forEach(w=>emb.addFields({name:`âš ï¸ Warning #${w.id}`,value:`**Reason:** ${w.reason||"â€”"}\n**By:** <@${w.modId}> Â· <t:${Math.floor(new Date(w.at).getTime()/1000)}:R>`,inline:true}));return ctx.reply({embeds:[emb.setFooter({text:FT}).setTimestamp()]});}
    case"unwarn":{if(!hP(member,PermissionFlagsBits.ModerateMembers))return ctx.reply({embeds:[E.er("You need **Moderate Members** permission.")]},true);const id=ctx.gi("id")||parseInt(ctx.ga(0),10);if(!id)return ctx.reply({embeds:[E.w("Provide a warning ID.")]},true);let found=false;for(const uid of Object.keys(data.warns)){const i=data.warns[uid].findIndex(w=>w.id===id);if(i!==-1){data.warns[uid].splice(i,1);found=true;break;}}if(!found)return ctx.reply({embeds:[E.er(`Warning #${id} not found.`)]},true);saveData();return ctx.reply({embeds:[E.ok(`âœ… Warning #${id} removed.`).setFooter({text:FT})]});}
    case"clearwarns":{if(!hP(member,PermissionFlagsBits.ModerateMembers))return ctx.reply({embeds:[E.er("You need **Moderate Members** permission.")]},true);const target=ctx.gu("user");if(!target)return ctx.reply({embeds:[E.w("Provide a user.")]},true);const count=(data.warns[target.id]||[]).length;data.warns[target.id]=[];saveData();return ctx.reply({embeds:[E.ok("âœ… Warnings Cleared").setDescription(`Removed **${count}** warning(s) from <@${target.id}>.`).setFooter({text:FT})]});}
    case"modlogs":{if(!hP(member,PermissionFlagsBits.ModerateMembers))return ctx.reply({embeds:[E.er("You need **Moderate Members** permission.")]},true);const target=ctx.gu("user");if(!target)return ctx.reply({embeds:[E.w("Provide a user.")]},true);const logs=(data.warns[target.id]||[]);const emb=E.mo(`ðŸ““ Mod Logs â€” ${target.username}`).setThumbnail(target.displayAvatarURL());if(!logs.length)emb.setDescription("âœ… No mod actions on record.");else logs.slice(-10).forEach(l=>emb.addFields({name:`${l.type==="ban"?"ðŸ”¨":l.type==="kick"?"ðŸ‘¢":"âš ï¸"} ${(l.type||"warn").toUpperCase()} #${l.id}`,value:`**Reason:** ${l.reason||"â€”"}\n**By:** <@${l.modId}> Â· <t:${Math.floor(new Date(l.at).getTime()/1000)}:R>`,inline:true}));return ctx.reply({embeds:[emb.setFooter({text:FT}).setTimestamp()]});}
    case"purge":{if(!hP(member,PermissionFlagsBits.ManageMessages))return ctx.reply({embeds:[E.er("You need **Manage Messages** permission.")]},true);const count=ctx.gi("count")||parseInt(ctx.ga(0),10)||10;const filterUser=ctx.gu("user");if(count<1||count>100)return ctx.reply({embeds:[E.w("Count must be 1-100.")]},true);if(ctx.slash)await ctx.i.deferReply({flags:MessageFlags.Ephemeral}).catch(()=>{});const msgs=await ctx.channel.messages.fetch({limit:100}).catch(()=>null);if(!msgs)return ctx.reply({embeds:[E.er("Failed to fetch messages.")]},true);let toDelete=msgs.filter(m=>!m.pinned&&Date.now()-m.createdTimestamp<1209600000);if(filterUser)toDelete=toDelete.filter(m=>m.author.id===filterUser.id);toDelete=toDelete.first(count);const deleted=await ctx.channel.bulkDelete(toDelete,true).catch(()=>null);return ctx.reply({embeds:[E.ok("ðŸ—‘ï¸ Messages Purged").addFields({name:"Deleted",value:`${deleted?.size||0} messages`,inline:true},...(filterUser?[{name:"Filter",value:`<@${filterUser.id}>`,inline:true}]:[]))],flags:MessageFlags.Ephemeral});}
    case"lock":{if(!hP(member,PermissionFlagsBits.ManageChannels))return ctx.reply({embeds:[E.er("You need **Manage Channels** permission.")]},true);await ctx.channel.permissionOverwrites.edit(guild.roles.everyone,{SendMessages:false}).catch(()=>{});return ctx.reply({embeds:[E.ok("ðŸ”’ Channel Locked").setDescription("Only staff can send messages here.").setFooter({text:FT})]});}
    case"unlock":{if(!hP(member,PermissionFlagsBits.ManageChannels))return ctx.reply({embeds:[E.er("You need **Manage Channels** permission.")]},true);await ctx.channel.permissionOverwrites.edit(guild.roles.everyone,{SendMessages:null}).catch(()=>{});return ctx.reply({embeds:[E.ok("ðŸ”“ Channel Unlocked").setFooter({text:FT})]});}
    case"slowmode":{if(!hP(member,PermissionFlagsBits.ManageChannels))return ctx.reply({embeds:[E.er("You need **Manage Channels** permission.")]},true);const secs=ctx.gi("seconds")??parseInt(ctx.ga(0)||"0");await ctx.channel.setRateLimitPerUser(secs).catch(()=>{});return ctx.reply({embeds:[E.ok("ðŸ¢ Slowmode Set").setDescription(secs===0?"Slowmode disabled.":`Messages limited to one per **${secs}s**.`).setFooter({text:FT})]});}
    case"nick":{if(!hP(member,PermissionFlagsBits.ManageNicknames))return ctx.reply({embeds:[E.er("You need **Manage Nicknames** permission.")]},true);const target=ctx.gu("user");if(!target)return ctx.reply({embeds:[E.w("Provide a user.")]},true);const name=ctx.gs("name")||ctx.gas().slice(1).join(" ")||null;const m2=await guild.members.fetch(target.id).catch(()=>null);if(!m2)return ctx.reply({embeds:[E.er("User not found.")]},true);await m2.setNickname(name,`By ${user.tag}`).catch(()=>{});return ctx.reply({embeds:[E.ok("âœï¸ Nickname Updated").addFields({name:"User",value:`<@${target.id}>`,inline:true},{name:"Nickname",value:name||"*(reset)*",inline:true}).setFooter({text:FT})]});}
    case"announce":{if(!isAdmin(member))return ctx.reply({embeds:[E.er("Administrator only.")]},true);const msg=ctx.gs("message")||ctx.gas().join(" ");if(!msg)return ctx.reply({embeds:[E.w("Provide a message.")]},true);const ch=ctx.gc("channel")||ctx.channel;await ch.send({embeds:[E.b("ðŸ“¢ Announcement").setDescription(msg).setFooter({text:`Announced by ${user.tag}`}).setTimestamp()]});if(ch.id!==ctx.channel.id)return ctx.reply({embeds:[E.ok(`âœ… Announcement posted in <#${ch.id}>!`)]});break;}
    case"say":{if(!isStaff(member))return ctx.reply({embeds:[E.er("Staff only.")]},true);const msg=ctx.gs("message")||ctx.gas().join(" ");if(!msg)return ctx.reply({embeds:[E.w("Provide a message.")]},true);if(ctx.slash)await ctx.i.deferReply({flags:MessageFlags.Ephemeral}).catch(()=>{});await ctx.channel.send({content:msg});if(ctx.slash)return ctx.reply({content:"âœ… Sent."});}
    case"embed":{if(!isStaff(member))return ctx.reply({embeds:[E.er("Staff only.")]},true);const title=ctx.gs("title")||ctx.ga(0)||"Embed";const body=ctx.gs("body")||ctx.gas().slice(1).join(" ")||"â€”";const hexStr=ctx.gs("color")||"FF8FB1";const color=parseInt(hexStr.replace("#",""),16)||C.brand;await ctx.channel.send({embeds:[new EmbedBuilder().setColor(color).setTitle(title).setDescription(body).setFooter({text:FT}).setTimestamp()]});if(ctx.slash)return ctx.reply({content:"âœ… Embed sent.",flags:MessageFlags.Ephemeral});break;}
    case"poll":{if(!isStaff(member))return ctx.reply({embeds:[E.er("Staff only.")]},true);const question=ctx.gs("question")||ctx.gas().slice(0,1).join(" ");const opts=(ctx.gs("options")||ctx.gas().slice(1).join(" ")||"").split("|").map(o=>o.trim()).filter(Boolean);if(!question)return ctx.reply({embeds:[E.w("Provide a question.")]},true);if(opts.length<2||opts.length>10)return ctx.reply({embeds:[E.w("Provide 2-10 options separated by `|`.")]},true);const nums=["1ï¸âƒ£","2ï¸âƒ£","3ï¸âƒ£","4ï¸âƒ£","5ï¸âƒ£","6ï¸âƒ£","7ï¸âƒ£","8ï¸âƒ£","9ï¸âƒ£","ðŸ”Ÿ"];const emb=E.b(`ðŸ“Š ${question}`).setDescription(opts.map((o,i)=>`${nums[i]} ${o}`).join("\n")).setFooter({text:`Poll by ${user.tag}`}).setTimestamp();const sent=await ctx.channel.send({embeds:[emb]});for(let i=0;i<opts.length;i++)await sent.react(nums[i]).catch(()=>{});if(ctx.slash)return ctx.reply({content:"âœ… Poll posted.",flags:MessageFlags.Ephemeral});break;}
    case"giveaway":{if(!isAdmin(member))return ctx.reply({embeds:[E.er("Administrator only.")]},true);const durStr=ctx.gs("duration")||ctx.ga(0);const prize=ctx.gs("prize")||ctx.gas().slice(1).join(" ");const winners=ctx.gi("winners")||1;if(!durStr||!prize)return ctx.reply({embeds:[E.w("Usage: `/giveaway <duration> <prize>`")]},true);const ms=parseDur(durStr);if(!ms)return ctx.reply({embeds:[E.er("Invalid duration.")]},true);const endAt=Date.now()+ms;const emb=E.ok("ðŸŽ‰ GIVEAWAY!").setDescription(`React with ðŸŽ‰ to enter!\n\n**Prize:** ${prize}\n**Winners:** ${winners}\n**Ends:** <t:${Math.floor(endAt/1000)}:R>`).setFooter({text:`Hosted by ${user.tag}`}).setTimestamp(endAt);const sent=await ctx.channel.send({embeds:[emb]});await sent.react("ðŸŽ‰");data.giveaways[sent.id]={prize,winners,guildId:guild.id,channelId:ctx.channel.id,endAt,ended:false};saveData();if(ctx.slash)return ctx.reply({content:"âœ… Giveaway started!",flags:MessageFlags.Ephemeral});break;}
    case"addorder":{if(!isStaff(member))return ctx.reply({embeds:[E.er("Staff only.")]},true);const target=ctx.gu("user");if(!target)return ctx.reply({embeds:[E.w("Provide a user.")]},true);const details=ctx.gs("details")||ctx.gas().slice(1).join(" ");if(!details)return ctx.reply({embeds:[E.w("Provide order details.")]},true);const o={id:data.nextOrderId++,userId:target.id,details,status:"not_started",createdAt:new Date().toISOString(),updatedAt:new Date().toISOString(),note:null};data.orders.push(o);data.stats.ordersCreated=(data.stats.ordersCreated||0)+1;saveData();updateOrderBoard().catch(()=>{});return ctx.reply({embeds:[E.ok(`âœ… Order #${o.id} Created`).addFields({name:"ðŸ‘¤ Customer",value:`<@${target.id}>`,inline:true},{name:"ðŸ“‹ Details",value:details}).setFooter({text:FT}).setTimestamp()]});}
    case"updateorder":{if(!isStaff(member))return ctx.reply({embeds:[E.er("Staff only.")]},true);const id=ctx.gi("id")||parseInt(ctx.ga(0),10);const status=ctx.gs("status")||ctx.ga(1);const note=ctx.gs("note")||null;const o=findOrder(id);if(!o)return ctx.reply({embeds:[E.er("Order not found.")]},true);if(status&&OS[status])o.status=status;if(note)o.note=note;o.updatedAt=new Date().toISOString();saveData();updateOrderBoard().catch(()=>{});const si=gOS(o.status);return ctx.reply({embeds:[E.mk(si.color,`ðŸ”„ Order #${o.id} Updated`).addFields({name:"ðŸ“Š Status",value:`${si.emoji} ${si.label}`,inline:true},{name:"ðŸ‘¤ Customer",value:`<@${o.userId}>`,inline:true},...(note?[{name:"ðŸ“‹ Note",value:note}]:[])).setFooter({text:FT}).setTimestamp()]});}
    case"complete":{if(!isStaff(member))return ctx.reply({embeds:[E.er("Staff only.")]},true);const id=ctx.gi("id")||parseInt(ctx.ga(0),10);const o=findOrder(id);if(!o)return ctx.reply({embeds:[E.er("Order not found.")]},true);o.status="completed";o.updatedAt=new Date().toISOString();data.stats.ordersCompleted=(data.stats.ordersCompleted||0)+1;saveData();updateOrderBoard().catch(()=>{});try{const u=await client.users.fetch(o.userId);u.send({embeds:[E.ok("âœ… Order Complete!").setDescription(`Your order **#${o.id}** has been marked as complete! ðŸŽ‰\n\nThank you for choosing ${NAME}! Leave a review with \`/review\` ðŸ’—`).setFooter({text:FT}).setTimestamp()]});}catch{}return ctx.reply({embeds:[E.ok(`âœ… Order #${o.id} Marked Complete`).addFields({name:"ðŸ‘¤ Customer",value:`<@${o.userId}>`,inline:true}).setFooter({text:FT}).setTimestamp()]});}
    case"blacklist":{if(!isAdmin(member))return ctx.reply({embeds:[E.er("Administrator only.")]},true);const target=ctx.gu("user");if(!target)return ctx.reply({embeds:[E.w("Provide a user.")]},true);const i=data.blacklist.indexOf(target.id);if(i!==-1){data.blacklist.splice(i,1);saveData();return ctx.reply({embeds:[E.ok("âœ… Blacklist Removed").setDescription(`<@${target.id}> can now use the bot.`).setFooter({text:FT})]});}data.blacklist.push(target.id);saveData();return ctx.reply({embeds:[E.er("ðŸš« User Blacklisted").setDescription(`<@${target.id}> can no longer use the bot.`).setFooter({text:FT})]});}
    case"setlog":{if(!isAdmin(member))return ctx.reply({embeds:[E.er("Administrator only.")]},true);const ch=ctx.gc("channel");if(ch){data.modLogChannels[guild.id]=ch.id;saveData();return ctx.reply({embeds:[E.ok("âœ… Mod Log Set").setDescription(`Logs will be sent to <#${ch.id}>`).setFooter({text:FT})]});}delete data.modLogChannels[guild.id];saveData();return ctx.reply({embeds:[E.ok("âœ… Mod Log Cleared").setFooter({text:FT})]});}
    case"setreviews":{if(!isAdmin(member))return ctx.reply({embeds:[E.er("Administrator only.")]},true);const ch=ctx.gc("channel");if(!ch)return ctx.reply({embeds:[E.w("Provide a channel.")]},true);gS(guild.id).reviewsChannelId=ch.id;saveData();return ctx.reply({embeds:[E.ok("âœ… Reviews Channel Set").setDescription(`Reviews will post in <#${ch.id}>`).setFooter({text:FT})]});}
    case"settranscripts":{if(!isAdmin(member))return ctx.reply({embeds:[E.er("Administrator only.")]},true);const ch=ctx.gc("channel");if(!ch)return ctx.reply({embeds:[E.w("Provide a channel.")]},true);gS(guild.id).transcriptsChannelId=ch.id;saveData();return ctx.reply({embeds:[E.ok("âœ… Transcripts Channel Set").setDescription(`Ticket transcripts will post in <#${ch.id}>`).setFooter({text:FT})]});}
    case"setverifyrole":{if(!isAdmin(member))return ctx.reply({embeds:[E.er("Administrator only.")]},true);const role=ctx.gr("role");if(!role)return ctx.reply({embeds:[E.w("Provide a role.")]},true);gS(guild.id).verifyRoleId=role.id;saveData();return ctx.reply({embeds:[E.ok("âœ… Verify Role Set").setDescription(`<@&${role.id}> will be given on verification.`).setFooter({text:FT})]});}
    case"setlevelupchannel":{if(!isAdmin(member))return ctx.reply({embeds:[E.er("Administrator only.")]},true);const ch=ctx.gc("channel");if(!ch)return ctx.reply({embeds:[E.w("Provide a channel.")]},true);gS(guild.id).levelUpChannelId=ch.id;saveData();return ctx.reply({embeds:[E.ok("âœ… Level-Up Channel Set").setDescription(`Level-up messages will post in <#${ch.id}>`).setFooter({text:FT})]});}
    case"ticketpanel":{if(!isAdmin(member))return ctx.reply({embeds:[E.er("Administrator only.")]},true);const{emb,row}=buildTicketPanel();await ctx.channel.send({embeds:[emb],components:[row]});if(ctx.slash)return ctx.reply({content:"âœ… Ticket panel posted!",flags:MessageFlags.Ephemeral});break;}
    case"close":{if(!ctx.channel?.name?.startsWith("ticket-"))return ctx.reply({embeds:[E.w("Only works inside ticket channels.")]},true);if(!isStaff(member))return ctx.reply({embeds:[E.er("Staff only.")]},true);const reason=ctx.gs("reason")||ctx.gas().join(" ")||"No reason";if(ctx.slash)await ctx.i.deferReply({flags:MessageFlags.Ephemeral}).catch(()=>{});await closeTicket(ctx.channel,member||user,reason,guild);if(ctx.slash)return ctx.reply({content:"ðŸ”’ Closing ticketâ€¦"});break;}
    case"addnote":{if(!ctx.channel?.name?.startsWith("ticket-"))return ctx.reply({embeds:[E.w("Only works inside ticket channels.")]},true);if(!isStaff(member))return ctx.reply({embeds:[E.er("Staff only.")]},true);const text=ctx.gs("text")||ctx.gas().join(" ");if(!text)return ctx.reply({embeds:[E.w("Provide note text.")]},true);return ctx.reply({embeds:[E.mk(C.note,"ðŸ“ Staff Note").setDescription(text).setFooter({text:`by ${user.tag}`}).setTimestamp()]});}
    case"givecoins":{if(!isAdmin(member))return ctx.reply({embeds:[E.er("Administrator only.")]},true);const target=ctx.gu("user");const amount=ctx.gi("amount")||parseInt(ctx.ga(1),10);if(!target||!amount||amount<1)return ctx.reply({embeds:[E.w("Usage: `/givecoins @user <amount>`")]},true);gE(target.id).coins=(gE(target.id).coins||0)+amount;saveData();return ctx.reply({embeds:[E.ok("ðŸ’° Coins Given").addFields({name:"ðŸ‘¤ User",value:`<@${target.id}>`,inline:true},{name:"ðŸ’° Amount",value:`+${amount} ðŸª™`,inline:true},{name:"ðŸ’¼ New Balance",value:`${gE(target.id).coins} ðŸª™`,inline:true}).setFooter({text:FT}).setTimestamp()]});}
    case"backup":{
      if(!guild)return ctx.reply({embeds:[E.er("Server only.")]},true);if(!isAdmin(member))return ctx.reply({embeds:[E.er("Administrator only.")]},true);
      const sub=ctx.gsub()||ctx.ga(0)||"";
      if(sub==="create"){if(ctx.slash)await ctx.i.deferReply().catch(()=>{});const bk=await createBackup(guild);return ctx.reply({embeds:[E.ok("ðŸ’¾ Backup Created").addFields({name:"ðŸ†” Backup ID",value:bk.id,inline:true},{name:"ðŸ“‹ Channels",value:`${bk.channels.length}`,inline:true},{name:"ðŸŽ­ Roles",value:`${bk.roles.length}`,inline:true}).setFooter({text:FT}).setTimestamp()]});}
      if(sub==="list"){const bks=data.serverBackups[guild.id]||[];if(!bks.length)return ctx.reply({embeds:[E.w("No backups yet. Use `backup create`.")]});return ctx.reply({embeds:[E.b("ðŸ’¾ Server Backups").setDescription(bks.map(b=>`\`${b.id}\` â€” ${b.channels.length} channels Â· ${b.roles.length} roles Â· <t:${Math.floor(new Date(b.createdAt).getTime()/1000)}:R>`).join("\n")).setFooter({text:FT})]});}
      if(sub==="view"){const id=ctx.gs("id")||ctx.ga(1);const bk=(data.serverBackups[guild.id]||[]).find(b=>b.id===id);if(!bk)return ctx.reply({embeds:[E.er("Backup not found.")]},true);return ctx.reply({embeds:[E.b(`ðŸ’¾ Backup â€” ${bk.id}`).addFields({name:"ðŸ  Server Name",value:bk.name,inline:true},{name:"ðŸ“… Created",value:`<t:${Math.floor(new Date(bk.createdAt).getTime()/1000)}:F>`,inline:true},{name:"ðŸ’¬ Channels",value:`${bk.channels.length}`,inline:true},{name:"ðŸŽ­ Roles",value:`${bk.roles.length}`,inline:true}).setFooter({text:FT}).setTimestamp()]});}
      return ctx.reply({embeds:[E.w("Subcommands: `create` Â· `list` Â· `view <id>`")]},true);
    }
    default:break;
  }
}

// â”€â”€ SLASH + PREFIX CONTEXT â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
function makeSlashCtx(interaction){
  return{
    slash:true,i:interaction,guild:interaction.guild,member:interaction.member,user:interaction.user,channel:interaction.channel,
    gs: k=>interaction.options?.getString?.(k)??null,
    gi: k=>interaction.options?.getInteger?.(k)??null,
    gu: k=>interaction.options?.getUser?.(k)??null,
    gr: k=>interaction.options?.getRole?.(k)??null,
    gc: k=>interaction.options?.getChannel?.(k)??null,
    gsub:()=>{try{return interaction.options?.getSubcommand();}catch{return null;}},
    ga:()=>null,gas:()=>[],grm:()=>null,
    reply:async(payload,eph=false)=>rep(interaction,payload,eph),
  };
}

function makePrefixCtx(msg,args){
  return{
    slash:false,i:null,guild:msg.guild,member:msg.member,user:msg.author,channel:msg.channel,
    gs:(_k,_r,idx=0)=>args[idx]||null,
    gi:(_k,_r,idx=0)=>args[idx]?parseInt(args[idx],10)||null:null,
    gu:(_k,idx=0)=>{const id=(args[idx]||"").replace(/[<@!>]/g,"");return id?client.users.cache.get(id)||null:null;},
    gr:(_k,idx=0)=>{if(!msg.guild)return null;const id=(args[idx]||"").replace(/[<@&>]/g,"");return id?msg.guild.roles.cache.get(id)||null:null;},
    gc:(_k,idx=0)=>{if(!msg.guild)return null;const id=(args[idx]||"").replace(/[<#>]/g,"");return id?msg.guild.channels.cache.get(id)||null:null;},
    gsub:()=>args[0]?.toLowerCase()||null,
    ga:idx=>args[idx]||null,
    gas:()=>args,
    grm:(idx)=>{if(!msg.guild)return null;const id=(args[idx]||"").replace(/[<@&>]/g,"");return id?msg.guild.roles.cache.get(id)||null:null;},
    reply:async(payload)=>{try{if(typeof payload==="string")return msg.channel.send({content:payload});const{flags:_f,...rest}=payload;return msg.channel.send({...rest,allowedMentions:{...rest.allowedMentions}});}catch(e){console.error("[prefixReply]",e.message);}},
  };
}

// â”€â”€ INTERACTION CREATE â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
client.on("interactionCreate",async interaction=>{
  try{
    if(data.blacklist.includes(interaction.user.id)&&interaction.isRepliable()){interaction.reply({content:"ðŸš« You are blacklisted.",flags:MessageFlags.Ephemeral}).catch(()=>{});return;}
    if(interaction.isChatInputCommand())return exec(interaction.commandName,makeSlashCtx(interaction));
    if(interaction.isButton()){
      const typeMap={ticket_order:"order",ticket_partner:"partnership",ticket_inquiry:"inquiry"};
      if(typeMap[interaction.customId]){
        const type=typeMap[interaction.customId];let modal;
        if(type==="order"){modal=new ModalBuilder().setCustomId("modal_order").setTitle("ðŸ“¦ Commission Order");modal.addComponents(new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("username").setLabel("Your Roblox Username").setStyle(TextInputStyle.Short).setMaxLength(100).setRequired(true)),new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("service").setLabel("Service Needed").setPlaceholder("e.g. UI, datastore, admin systemâ€¦").setStyle(TextInputStyle.Short).setMaxLength(200).setRequired(true)),new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("description").setLabel("Detailed Description").setStyle(TextInputStyle.Paragraph).setMaxLength(1000).setRequired(true)),new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("budget").setLabel("Your Budget").setPlaceholder("e.g. $25 USD, 5000 Robuxâ€¦").setStyle(TextInputStyle.Short).setMaxLength(100).setRequired(true)),new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("payment").setLabel("Payment Method").setPlaceholder("PayPal F&F, CashApp, Robux, Gift Cardâ€¦").setStyle(TextInputStyle.Short).setMaxLength(100).setRequired(true)));}
        else if(type==="partnership"){modal=new ModalBuilder().setCustomId("modal_partner").setTitle("ðŸ¤ Partnership Request");modal.addComponents(new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("serverName").setLabel("Server Name").setStyle(TextInputStyle.Short).setMaxLength(100).setRequired(true)),new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("invite").setLabel("Permanent Invite Link").setStyle(TextInputStyle.Short).setMaxLength(200).setRequired(true)),new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("memberCount").setLabel("Member Count").setPlaceholder("e.g. 150 (minimum 45 required)").setStyle(TextInputStyle.Short).setMaxLength(50).setRequired(true)),new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("focus").setLabel("Server Focus / Niche").setPlaceholder("e.g. Roblox scripting, game devâ€¦").setStyle(TextInputStyle.Short).setMaxLength(200).setRequired(true)),new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("offering").setLabel("What Can You Offer?").setPlaceholder("e.g. Ad in announcements, server promotionâ€¦").setStyle(TextInputStyle.Paragraph).setMaxLength(500).setRequired(true)));}
        else{modal=new ModalBuilder().setCustomId("modal_inquiry").setTitle("â“ Support Inquiry");modal.addComponents(new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("name").setLabel("Your Name or Username").setStyle(TextInputStyle.Short).setMaxLength(100).setRequired(true)),new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("topic").setLabel("Topic / Question Summary").setStyle(TextInputStyle.Short).setMaxLength(200).setRequired(true)),new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("details").setLabel("Full Details").setStyle(TextInputStyle.Paragraph).setMaxLength(1000).setRequired(true)),new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("urgency").setLabel("Urgency (optional)").setPlaceholder("Not urgent / Within a few days / ASAP").setStyle(TextInputStyle.Short).setMaxLength(100).setRequired(false)));}
        return interaction.showModal(modal);
      }
      if(interaction.customId==="ticket_close_btn"){const modal=new ModalBuilder().setCustomId("modal_close").setTitle("ðŸ”’ Close Ticket");modal.addComponents(new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("reason").setLabel("Reason for closing").setStyle(TextInputStyle.Paragraph).setMaxLength(500).setRequired(true)));return interaction.showModal(modal);}
      if(interaction.customId==="verify_start"){const modal=new ModalBuilder().setCustomId("modal_verify_start").setTitle("ðŸŸ£ Roblox Verification");modal.addComponents(new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("username").setLabel("Your Roblox Username").setStyle(TextInputStyle.Short).setMaxLength(50).setRequired(true)));return interaction.showModal(modal);}
    }
    if(interaction.isModalSubmit()){
      const typeMap={modal_order:"order",modal_partner:"partnership",modal_inquiry:"inquiry"};
      if(typeMap[interaction.customId]){
        await interaction.deferReply({flags:MessageFlags.Ephemeral});
        const type=typeMap[interaction.customId];let answers={};
        if(type==="order")answers={username:interaction.fields.getTextInputValue("username"),service:interaction.fields.getTextInputValue("service"),description:interaction.fields.getTextInputValue("description"),budget:interaction.fields.getTextInputValue("budget"),payment:interaction.fields.getTextInputValue("payment")};
        else if(type==="partnership")answers={serverName:interaction.fields.getTextInputValue("serverName"),invite:interaction.fields.getTextInputValue("invite"),memberCount:interaction.fields.getTextInputValue("memberCount"),focus:interaction.fields.getTextInputValue("focus"),offering:interaction.fields.getTextInputValue("offering")};
        else answers={name:interaction.fields.getTextInputValue("name"),topic:interaction.fields.getTextInputValue("topic"),details:interaction.fields.getTextInputValue("details"),urgency:interaction.fields.getTextInputValue("urgency")};
        const memberObj=interaction.member??await interaction.guild?.members.fetch(interaction.user.id).catch(()=>null);
        const result=await openTicket(interaction.guild,memberObj,type,answers);
        if(!result.ok)return interaction.editReply({content:`âŒ ${result.error}`});
        return interaction.editReply({content:`âœ… Your ticket has been created: <#${result.channel.id}>`});
      }
      if(interaction.customId==="modal_close"){const reason=interaction.fields.getTextInputValue("reason");if(!interaction.channel?.name?.startsWith("ticket-"))return interaction.reply({content:"âŒ Not a ticket channel.",flags:MessageFlags.Ephemeral});await interaction.deferReply({flags:MessageFlags.Ephemeral});await interaction.editReply({content:"ðŸ”’ Closing ticketâ€¦"});await closeTicket(interaction.channel,interaction.member||interaction.user,reason,interaction.guild);return;}
      if(interaction.customId==="modal_verify_start"){
        await interaction.deferReply({flags:MessageFlags.Ephemeral});
        const username=interaction.fields.getTextInputValue("username");
        const rxUser=await fetchRxUser(username);
        if(!rxUser)return interaction.editReply({content:"âŒ Roblox user not found. Check the spelling."});
        const code=genCode();data.verificationCodes[interaction.user.id]={code,robloxName:rxUser.name,robloxId:rxUser.id,expiresAt:Date.now()+10*60000};saveData();
        const avatar=await fetchRxAvatar(rxUser.id);
        const emb=E.rb("ðŸŸ£ Verification Code â€” Step 2").setDescription([`**Found:** [${rxUser.name}](https://www.roblox.com/users/${rxUser.id}/profile)`,"","**Steps:**","â‘  Copy the code below","â‘¡ Go to [roblox.com/my/account](https://www.roblox.com/my/account) â†’ **About** tab","â‘¢ Paste code in your bio and **save**",`â‘£ Run \`/checkverify ${code}\` here`,"","> â° Expires in **10 minutes**"].join("\n")).addFields({name:"ðŸ”‘ Your Code",value:`\`\`\`${code}\`\`\``}).setFooter({text:"Paste in Roblox bio â†’ /checkverify"}).setTimestamp();
        if(avatar)emb.setThumbnail(avatar);return interaction.editReply({embeds:[emb]});
      }
    }
  }catch(err){console.error("[Interaction]",err.message);await errLog(err,"Interaction handler");try{if(interaction.isRepliable()&&!interaction.replied&&!interaction.deferred)await interaction.reply({content:"âŒ An error occurred.",flags:MessageFlags.Ephemeral});}catch{}}
});

// â”€â”€ REACTIONS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
client.on("messageReactionAdd",   async(r,u)=>{if(u.bot)return;if(r.partial)try{await r.fetch();}catch{return;}await handleRR(r,u,true);});
client.on("messageReactionRemove",async(r,u)=>{if(u.bot)return;if(r.partial)try{await r.fetch();}catch{return;}await handleRR(r,u,false);});

// â”€â”€ MESSAGE CREATE â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
client.on("messageCreate",async msg=>{
  if(msg.author.bot||!msg.guild)return;
  if(msg.channel.id===ENV.STICKY)refreshSticky(msg.channel).catch(()=>{});
  if(pAwaitAd.has(msg.channel.id)){
    const pd=pAwaitAd.get(msg.channel.id);
    if(msg.author.id===pd.member.id&&msg.content.trim().length>=20){
      pAwaitAd.delete(msg.channel.id);
      setImmediate(async()=>{
        try{
          const{answers}=pd,adText=msg.content.trim(),banner=msg.attachments.first()?.url||null;
          if(!ENV.PAD)return;const g=client.guilds.cache.get(ENV.HOME);if(!g)return;
          const ch=await g.channels.fetch(ENV.PAD).catch(()=>null);if(!ch?.isTextBased())return;
          const emb=new EmbedBuilder().setColor(C.note).setTitle(answers.serverName||"New Partner").setDescription(`${adText}\n\u200b`).addFields({name:"ðŸ‘¥ Members",value:answers.memberCount||"â€”",inline:true},{name:"ðŸŽ¯ Focus",value:answers.focus||"â€”",inline:true},{name:"ðŸ¤ Offering",value:answers.offering||"â€”"},{name:"ðŸ”— Join",value:answers.invite||"â€”"}).setFooter({text:`${NAME} Partnerships`}).setTimestamp();
          if(banner)emb.setImage(banner);
          await ch.send({embeds:[emb]});
          await msg.channel.send({embeds:[E.ok("âœ… Partnership Posted!").setDescription(`Your ad is live in <#${ENV.PAD}>! ðŸ’—\n\nThis ticket closes in 15 seconds.`)]});
          setTimeout(()=>msg.channel.delete("Partnership posted").catch(()=>{}),15000);
        }catch(e){console.error("[PartnerAd]",e.message);}
      });
      return;
    }
  }

  // â”€â”€ Forum thread AI response â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  if(ENV.FORUM&&msg.channel.isThread?.()&&msg.channel.parentId===ENV.FORUM&&GEMINI_KEY){
    const forumKey=`forum_${msg.channel.id}`;
    if(!aiProcessing.has(forumKey)){
      const cdKey=`forum:${msg.channel.id}:${msg.author.id}`,last=aiCD.get(cdKey)||0;
      if(Date.now()-last>=8000){
        aiCD.set(cdKey,Date.now());
        aiProcessing.add(forumKey);
        setImmediate(async()=>{
          try{
            const{text,model}=await callTicketAI(forumKey,msg.content,"inquiry",null);
            if(text)await msg.channel.send({embeds:[aiE(text,model,msg.author.username,"forum")]}).catch(()=>{});
          }catch(e){console.error("[ForumAI]",e.message);}
          finally{aiProcessing.delete(forumKey);}
        });
      }
    }
    return;
  }

  // â”€â”€ Ticket AI response â€” one reply per user message â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
  if(msg.channel.name?.startsWith("ticket-")&&!msg.content.startsWith("s!")){
    const s=gS(msg.guild.id);const staff=isStaff(msg.member);
    const typeMatch=msg.channel.topic?.match(/^\[(\w+)\]/);const ticketType=typeMatch?typeMatch[1]:"inquiry";
    if(!staff&&s.ticketAI!==false&&GEMINI_KEY&&!tAIOff.has(msg.channel.id)&&ticketType!=="order"){
      const cdKey=`${msg.channel.id}:${msg.author.id}`,last=aiCD.get(cdKey)||0;
      if(Date.now()-last>=8000&&!aiProcessing.has(msg.channel.id)){
        aiCD.set(cdKey,Date.now());
        aiProcessing.add(msg.channel.id);
        setImmediate(async()=>{
          try{
            const{text,model}=await callTicketAI(msg.channel.id,msg.content,ticketType,null);
            if(text)await msg.channel.send({embeds:[aiE(text,model,msg.author.username,ticketType)]}).catch(()=>{});
          }catch(e){console.error("[TicketAI]",e.message);}
          finally{aiProcessing.delete(msg.channel.id);}
        });
      }
    }
  }

  if(!msg.content.startsWith("s!")){
    grantXP(msg).catch(()=>{});grantCoins(msg).catch(()=>{});
    if(data.triviaActive[msg.channel.id]){const tv=data.triviaActive[msg.channel.id];if(tv.answers.some(a=>msg.content.trim().toLowerCase().includes(a.toLowerCase()))){gE(msg.author.id).coins=(gE(msg.author.id).coins||0)+tv.coins;delete data.triviaActive[msg.channel.id];saveData();await msg.reply({embeds:[E.ok("ðŸ§  Correct!").setDescription(`**+${tv.coins} ðŸª™** added to your balance!`).setFooter({text:FT})]}).catch(()=>{});}}
    return;
  }
  if(data.blacklist.includes(msg.author.id))return;
  const rawArgs=msg.content.slice("s!".length).trim().split(/\s+/);
  const cmd=rawArgs.shift()?.toLowerCase();if(!cmd)return;
  const ctx=makePrefixCtx(msg,rawArgs);
  try{await exec(cmd,ctx);}catch(err){console.error(`[Prefix ${cmd}]`,err.message);await errLog(err,`Prefix: s!${cmd}`);}
});

// â”€â”€ FORUM THREAD CREATE â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
client.on("threadCreate",async thread=>{
  try{
    if(!ENV.FORUM||thread.parentId!==ENV.FORUM)return;
    await thread.join().catch(()=>{});
    if(!GEMINI_KEY)return;
    const{text,model}=await callTicketAI(`forum_${thread.id}`,`New support thread: "${thread.name}". Greet the user warmly, introduce yourself as Snuggles AI, and ask them to describe their Roblox scripting issue in detail.`,"inquiry",null);
    if(text)await thread.send({embeds:[aiE(text,model,"Support","forum")]});
  }catch(e){console.error("[threadCreate]",e.message);}
});

// â”€â”€ GUILD EVENTS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
client.on("guildCreate",async g=>{
  console.log(`Joined: ${g.name}`);updStat();await cacheInvites(g).catch(()=>{});
  const ch=g.channels.cache.filter(c=>c.type===ChannelType.GuildText&&c.permissionsFor(g.members.me)?.has(PermissionFlagsBits.SendMessages)).sort((a,b)=>a.rawPosition-b.rawPosition).first();
  if(ch)await ch.send({embeds:[E.b(`ðŸ§¸ ${NAME} v${VER} â€” Thanks for adding me!`).setDescription(["`/setlog #channel` â€” mod log","`/setreviews #channel` â€” reviews","`/settranscripts #channel` â€” transcripts","`/setverifyrole @role` â€” Roblox verify","`/setscamchannel #channel` â€” scam reports","`/ticketpanel` â€” post ticket panel","","Run `s!setup` for full guide | `s!help` for all commands"].join("\n")).setFooter({text:`${NAME} v${VER} Â· Made with ðŸ’— by ${OWNER}`}).setTimestamp()]}).catch(()=>{});
});
client.on("guildDelete",g=>{console.log(`Left: ${g.name}`);updStat();});
client.on("inviteCreate",inv=>{if(!inv.guild)return;if(!data.inviteCache[inv.guild.id])data.inviteCache[inv.guild.id]={};data.inviteCache[inv.guild.id][inv.code]=inv.uses||0;saveData();});
client.on("inviteDelete",inv=>{if(!inv.guild)return;if(data.inviteCache[inv.guild.id])delete data.inviteCache[inv.guild.id][inv.code];saveData();});

client.on("guildMemberAdd",async member=>{
  try{
    await handleRaidJoin(member);const g=member.guild;
    const newInv=await g.invites.fetch().catch(()=>null);
    if(newInv){const cached=data.inviteCache[g.id]||{};let inviterId=null;newInv.forEach(inv=>{if((inv.uses||0)>(cached[inv.code]||0)){inviterId=inv.inviter?.id;}cached[inv.code]=inv.uses||0;});data.inviteCache[g.id]=cached;if(inviterId){if(!data.invites[g.id])data.invites[g.id]={};if(!data.invites[g.id][inviterId])data.invites[g.id][inviterId]={invited:0,left:0};data.invites[g.id][inviterId].invited++;}saveData();}
    await logMod(g,E.ok("ðŸ“¥ Member Joined").addFields({name:"User",value:`<@${member.id}> (${member.user.tag})`},{name:"Account Age",value:`<t:${Math.floor(member.user.createdTimestamp/1000)}:R>`}).setThumbnail(member.user.displayAvatarURL()).setTimestamp());
  }catch{}
});

client.on("guildMemberRemove",async member=>{
  try{if(data.invites[member.guild.id]){for(const inv of Object.values(data.invites[member.guild.id])){inv.left++;break;}saveData();}await logMod(member.guild,E.er("ðŸ“¤ Member Left").addFields({name:"User",value:`<@${member.id}> (${member.user.tag})`}).setThumbnail(member.user.displayAvatarURL()).setTimestamp());}catch{}
});

client.on("messageDelete",async msg=>{try{if(!msg.guild||msg.author?.bot||msg.partial||!msg.content)return;await logMod(msg.guild,E.er("ðŸ—‘ï¸ Message Deleted").addFields({name:"Author",value:`<@${msg.author.id}>`,inline:true},{name:"Channel",value:`<#${msg.channel.id}>`,inline:true},{name:"Content",value:msg.content.slice(0,1024)}).setTimestamp());}catch{}});
client.on("messageUpdate",async(o,n)=>{try{if(!n.guild||n.author?.bot||o.partial||n.partial||o.content===n.content)return;await logMod(n.guild,E.w("âœï¸ Message Edited").addFields({name:"Author",value:`<@${n.author.id}>`,inline:true},{name:"Channel",value:`<#${n.channel.id}>`,inline:true},{name:"Before",value:(o.content||"â€”").slice(0,1024)},{name:"After",value:(n.content||"â€”").slice(0,1024)},{name:"Link",value:`[Jump](${n.url})`,inline:true}).setTimestamp());}catch{}});
client.on("channelDelete",async ch=>{try{if(!ch.guild)return;await logMod(ch.guild,E.er("ðŸ’¬ Channel Deleted").addFields({name:"Name",value:ch.name,inline:true}).setTimestamp());const logs=await ch.guild.fetchAuditLogs({type:AuditLogEvent.ChannelDelete,limit:1}).catch(()=>null);if(logs){const e=logs.entries.first();if(e)await checkNuke(ch.guild,e.executor.id,"channelDelete");}}catch{}});
client.on("roleDelete",async r=>{try{await logMod(r.guild,E.er("ðŸŽ­ Role Deleted").addFields({name:"Name",value:r.name,inline:true}).setTimestamp());const logs=await r.guild.fetchAuditLogs({type:AuditLogEvent.RoleDelete,limit:1}).catch(()=>null);if(logs){const e=logs.entries.first();if(e)await checkNuke(r.guild,e.executor.id,"roleDelete");}}catch{}});
client.on("guildBanAdd",async ban=>{try{await logMod(ban.guild,E.er("ðŸ”¨ Member Banned").addFields({name:"User",value:`${ban.user.tag}`},{name:"Reason",value:ban.reason||"No reason"}).setTimestamp());const logs=await ban.guild.fetchAuditLogs({type:AuditLogEvent.MemberBanAdd,limit:1}).catch(()=>null);if(logs){const e=logs.entries.first();if(e)await checkNuke(ban.guild,e.executor.id,"ban");}}catch{}});
client.on("guildBanRemove",async ban=>{try{await logMod(ban.guild,E.ok("ðŸ”“ Member Unbanned").addFields({name:"User",value:`${ban.user.tag}`}).setTimestamp());}catch{}});

// â”€â”€ ERROR HANDLERS â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
client.on("error",err=>{console.error("Client error:",err.message);errLog(err,"Client error");});
process.on("unhandledRejection",err=>{const msg=String(err?.message||err);if(msg.includes("Sign in to confirm")||msg.includes("live stream"))return;console.error("Unhandled rejection:",msg);errLog(err,"Unhandled rejection");});
process.on("uncaughtException",err=>{console.error("Uncaught exception:",err);errLog(err,"Uncaught exception");});

// â”€â”€ READY â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
client.once("clientReady",async()=>{
  console.log(`âœ…  ${NAME} v${VER} â€” ${client.user.tag}`);
  console.log(`ðŸ¤–  AI: ${GEMINI_KEY?"Gemini Enabled":"Disabled"}`);
  console.log(`ðŸ–¼ï¸   Images: ${STAB_KEY?"Stability AI":"Pollinations (fallback)"}`);
  await registerSlash();
  for(const[,g]of client.guilds.cache)await cacheInvites(g).catch(()=>{});
  updStat();
  setInterval(updStat,5*60000);
  setInterval(checkGiveaways,10000);
  setInterval(updateOrderBoard,3*3600000);
  setTimeout(updateOrderBoard,6000);
});

