  const icon=client.user?.displayAvatarURL(),auth={name:`${NAME} v${VER}`,iconURL:icon};
  const ftp=p=>({text:`Page ${p}/6  Â·  ${FT}`}),D="â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€";
  const pages=[
    E.b("ðŸ“– Help â€” General & AI").setAuthor(auth).setDescription(`> Prefix: \`s!\`  Â·  Slash: \`/\`  â€” both work!\n${D}`)
      .addFields(
        {name:"ðŸŒ  General",value:"`help [page]`  `info`  `ping`  `status`\n`rules`  `uptime`  `invite`  `setup`"},
        {name:"ðŸ¤–  AI & Images",value:"`ai <message>` â€” Chat with Snuggles AI\n`ai-reset` â€” Wipe conversation history\n`imagine <prompt> [style]` â€” Generate an AI image\n`aioff` / `aion` â€” Toggle AI in ticket *(staff)*\n\n**Styles:** `realistic` `anime` `cartoon` `fantasy` `minimal` `pixel` `oil` `sketch`"},
        {name:"ðŸ’¼  Commissions",value:"`services`  `prices`  `pay`  `ticket`  `discount`\n`orderinfo <id>`  `portfolio [page]`"},
      ).setFooter(ftp(1)),
    E.i("ðŸ“– Help â€” Scripting & Economy").setAuthor(auth).setDescription(D)
      .addFields(
        {name:"ðŸ–¥ï¸  Scripting",value:"`script <type>` â€” Example Lua scripts\n  Types: `ui` `datastore` `remote` `movement` `admin`\n`snippet`  `docs`  `debug`  `tip`"},
        {name:"ðŸ“Š  Leveling",value:"`level [@user]`  `rank [@user]`  `leaderboard`\n`setlevelupchannel <#ch>` *(admin)*"},
        {name:"ðŸ’°  Economy & Shop",value:"`balance [@user]`  `dowork` *(1h)*  `daily` *(24h)*\n`shop`  `buy <id>`\n\n**Items:** `role_color` 500ðŸª™  `code_review` 300ðŸª™  `priority_queue` 750ðŸª™\n`vip_ping` 1000ðŸª™  `og_badge` 2000ðŸª™  `ai_image` 150ðŸª™"},
        {name:"â­  Reviews",value:"`review <1-5> <type> <msg>`  `vouch <text>`"},
      ).setFooter(ftp(2)),
    E.g("ðŸ“– Help â€” Fun & Info").setAuthor(auth).setDescription(D)
      .addFields(
        {name:"ðŸŽ®  Fun & Games",value:"`8ball <q>`  `quote`  `meme`  `rate <thing>`\n`coinflip`  `roll [max]`  `rps <choice>`\n`trivia` â€” Win ðŸª™!  `remindme <time> <msg>`\n`color <hex>`  `calc <expr>`"},
        {name:"â„¹ï¸  Information",value:"`userinfo [@user]`  `serverinfo`  `avatar [@user]`\n`banner [@user]`  `servericon`  `stats`\n`invites [@user]`  `inviteleaderboard`"},
        {name:"ðŸŸ£  Roblox Verification",value:"`verify <username>` â€” Start account linking\n`checkverify <code>` â€” Complete verification\n`whois [@user]` â€” View Roblox profile\n`unverify` â€” Unlink account\n`verifypanel <#ch>` â€” Post panel *(admin)*"},
      ).setFooter(ftp(3)),
    E.mk(C.error,"ðŸ“– Help â€” Moderation & Admin").setAuthor(auth).setDescription(D)
      .addFields(
        {name:"ðŸ”¨  Moderation *(Manage Messages+)*",value:"`ban <@user> [reason] [days]`  `softban <@user>`\n`kick <@user>`  `mute <@user> <time>`  `unmute <@user>`\n`warn <@user> <reason>`  `warns`  `unwarn <id>`  `clearwarns`\n`modlogs <@user>`  `purge <count> [@user]`\n`lock`  `unlock`  `slowmode <s>`  `nick <@user> [name]`"},
        {name:"âš™ï¸  Admin *(Administrator)*",value:"`announce`  `say`  `embed`  `poll`  `giveaway`\n`ticketpanel`  `close <reason>`  `addnote <text>`\n`addorder`  `updateorder`  `complete`  `blacklist`  `givecoins`\n`setlog`  `setreviews`  `settranscripts`  `setverifyrole`\n`setscamchannel`  `setlevelupchannel`"},
        {name:"ðŸš¨  Scam Reports *(Staff)*",value:"`reportscammer <@user> <evidence>`  `scammerlist`"},
        {name:"ðŸ’¾  Backups *(Admin)*",value:"`backup create`  `backup list`  `backup view <id>`"},
      ).setFooter(ftp(4)),
    E.mk(C.mod,"ðŸ“– Help â€” Security").setAuthor(auth).setDescription(D)
      .addFields(
        {name:"ðŸ›¡ï¸  Anti-Raid *(Admin)*",value:"`antiraid enable / disable / status`\n`antiraid config [threshold] [window] [action] [autounlock] [#notify]`\n  `threshold` â€” Joins to trigger *(default 8)*\n  `window` â€” Detection window sec *(default 10)*\n  `action` â€” `kick` Â· `ban` Â· `none`\n`antiraid whitelist / unwhitelist <@user>`"},
        {name:"â˜¢ï¸  Anti-Nuke *(Admin)*",value:"`antinuke enable / disable / status`\n`antinuke config [banth] [channelth] [roleth] [kickth] [action] [#notify]`\n  `banth` â€” Ban threshold *(default 5)*\n  `channelth` â€” Channel deletion threshold *(default 3)*\n  `action` â€” `ban` Â· `kick` Â· `strip`\n`antinuke trust / untrust <@user>`"},
        {name:"ðŸŽ­  Reaction Roles *(Manage Roles)*",value:"`reactionrole add <msgID> <emoji> <@role>`\n`reactionrole remove <msgID> <emoji>`\n`reactionrole list`  `reactionrole panel <title> <desc>`"},
      ).setFooter(ftp(5)),
    E.mk(C.note,"ðŸ“– Help â€” Tickets & Setup").setAuthor(auth).setDescription(D)
      .addFields(
        {name:"ðŸŽ«  Ticket System",value:"Post panel with `ticketpanel` â€” members choose:\n  ðŸ“¦ **Order** â€” Commission work *(staff reviewed)*\n  ðŸ¤ **Partnership** â€” Partner with us *(AI, 45+ members)*\n  â“ **Inquiry** â€” Support & questions *(AI 24/7)*\n\n**In-ticket:** `close <reason>`  `addnote <text>`  `aioff`  `aion`"},
        {name:"âš™ï¸  Quick Setup",value:"`setup` â€” Full setup guide\n`ticketpanel` â€” Post support panel\n`setlog / setreviews / settranscripts`\n`setverifyrole`  `setlevelupchannel`  `setscamchannel`"},
      ).setFooter(ftp(6)),
  ];
  const p=Math.max(1,Math.min(page,pages.length));
  return pages[p-1];
}

// â”€â”€ AI â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
const tConvos=new Map(),tAIOff=new Set(),pAwaitAd=new Map(),aiCD=new Map(),uChat=new Map();
// Processing lock â€” prevents double AI responses in the same channel
const aiProcessing=new Set();

async function callGemini(messages,system,opts={}){
  if(!GEMINI_KEY)return{text:null,model:null};
  try{
    const contents=messages.map(m=>({
      role:m.role==="assistant"?"model":m.role,
      parts:[{text:m.content}],
    }));
    const res=await fetch(`https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=${GEMINI_KEY}`,{
      method:"POST",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({
        system_instruction:{parts:[{text:system}]},
        contents,
        generationConfig:{maxOutputTokens:opts.maxTokens||800,temperature:opts.temp??0.7},
      }),
    });
    if(!res.ok){const err=await res.text().catch(()=>"");console.error(`[Gemini] ${res.status}`,err.slice(0,200));return{text:null,model:null};}
    const j=await res.json();
    const text=j.candidates?.[0]?.content?.parts?.[0]?.text?.trim()||null;
    return{text,model:"Gemini 1.5 Flash"};
  }catch(e){console.error("[Gemini]",e.message);return{text:null,model:null};}
}

async function callTicketAI(chId,msg,type,ctx){
  if(!tConvos.has(chId))tConvos.set(chId,[]);
  const h=tConvos.get(chId);h.push({role:"user",content:msg});
  while(h.length>20)h.shift();
  const sys=(SYS[type]||SYS.inquiry)+(ctx?`\n\n## Ticket Form\n${ctx}`:"")+"\n\nIMPORTANT: Respond in ONE complete message.";
  const r=await callGemini(h,sys,{maxTokens:900});
  if(r.text)h.push({role:"assistant",content:r.text});
  return r;
}

async function enhancePrompt(raw){
  const{text}=await callGemini([{role:"user",content:`Enhance this image prompt: "${raw}"`}],SYS.img,{maxTokens:220,temp:0.8});
  return text||raw;
}

async function generateImage(prompt,style){
  const full=style?`${prompt}, ${IMG_STYLES[style]||""}`:prompt;
  if(STAB_KEY){
    try{
      const res=await fetch("https://api.stability.ai/v1/generation/stable-diffusion-xl-1024-v1-0/text-to-image",{
        method:"POST",headers:{"Content-Type":"application/json","Authorization":`Bearer ${STAB_KEY}`,"Accept":"application/json"},
        body:JSON.stringify({text_prompts:[{text:full,weight:1},{text:"blurry, bad quality, distorted, nsfw, ugly",weight:-1}],cfg_scale:7,height:1024,width:1024,steps:30,samples:1}),
      });
      if(res.ok){const j=await res.json(),b64=j.artifacts?.[0]?.base64;if(b64)return{buffer:Buffer.from(b64,"base64"),ext:"png",source:"Stability AI SDXL"};}
    }catch(e){console.warn("[ImgGen] Stability failed:",e.message);}
  }
  const url=`https://image.pollinations.ai/prompt/${encodeURIComponent(full)}?width=1024&height=1024&nologo=true&seed=${ri(0,999999)}&enhance=true`;
  const res=await fetch(url);if(!res.ok)throw new Error(`Pollinations error: ${res.status}`);
  return{buffer:Buffer.from(await res.arrayBuffer()),ext:"png",source:"Pollinations AI"};
}

// â”€â”€ ROBLOX â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€
async function fetchRxUser(username){try{const r=await fetch("https://users.roblox.com/v1/usernames/users",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify({usernames:[username],excludeBannedUsers:false})});if(!r.ok)return null;return(await r.json()).data?.[0]||null;}catch{return null;}}
async function fetchRxProfile(uid){try{const[ur,sr]=await Promise.all([fetch(`https://users.roblox.com/v1/users/${uid}`),fetch(`https://friends.roblox.com/v1/users/${uid}/friends/count`).catch(()=>null)]);const u=ur.ok?await ur.json():null,st=sr?.ok?await sr.json():null;if(!u)return null;return{id:u.id,name:u.name,displayName:u.displayName,description:u.description||"",created:u.created,isBanned:u.isBanned,friendCount:st?.count??null};}catch{return null;}}
async function fetchRxAvatar(uid){try{const r=await fetch(`https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds=${uid}&size=150x150&format=Png`);if(!r.ok)return null;return(await r.json()).data?.[0]?.imageUrl||null;}catch{return null;}}
const genCode=()=>"SNUG-"+Math.random().toString(36).substring(2,8).toUpperCase();

