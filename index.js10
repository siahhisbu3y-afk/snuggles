          "  • **roleth** — role deletion threshold (default 3)",
          "  • **kickth** — kick threshold (default 5)",
          "  • **action** — ban | kick | strip (remove all roles)",
          "`antinuke trust <@user>` — Trust a user (exempt from anti-nuke)",
          "`antinuke untrust <@user>` — Remove trust",
        ].join("\n")},
        {name:"🎭 Reaction Roles (Admin/Manage Roles)",value:[
          "`reactionrole add <msg_id> <emoji> <@role>` — Add reaction role",
          "`reactionrole remove <msg_id> <emoji>` — Remove reaction role",
          "`reactionrole list` — View all configured reaction roles",
          "`reactionrole panel <title> <description>` — Post a role panel",
          "",
          "**How to set up:** Post a message → copy its ID → run `reactionrole add`",
        ].join("\n")},
        {name:"🎫 Ticket System",value:[
          "Post the ticket panel with `ticketpanel` in your support channel",
          "Members click buttons to open tickets:",
          "  📦 **Order** — Commission a script (staff reviewed)",
          "  🤝 **Partnership** — Partner with us (AI handled, 45 member min)",
          "  ❓ **Inquiry** — Questions & support (AI handled 24/7)",
          "",
          "**Staff ticket commands:** `close <reason>` `addnote <text>` `aioff` `aion`",
        ].join("\n")},
      )
      .setFooter({text:"Page 5/5 • All commands work as s! prefix AND / slash commands"}),
  ];
  const idx = Math.max(0, Math.min(page-1, pages.length-1));
  return pages[idx];
}

// ═══════════════════════════════════════════════════════════════════════════
//  AI — GROQ CALLER
// ═══════════════════════════════════════════════════════════════════════════

const ticketConvos    = new Map();
const ticketAIOff     = new Set();
const partnerAwaitAd  = new Map();
const aiCooldowns     = new Map();
const userChatHistory = new Map();

async function callGroq(messages, systemPrompt, opts={}) {
  if (!GROQ_API_KEY) return {text:null,model:null};
  const maxTokens = opts.maxTokens||800;
  const temp = opts.temperature??0.7;
  for (const model of GROQ_MODELS) {
    try {
      const res = await fetch("https://api.groq.com/openai/v1/chat/completions", {
        method:"POST",
        headers:{"Content-Type":"application/json","Authorization":`Bearer ${GROQ_API_KEY}`},
        body:JSON.stringify({model:model.id,max_tokens:maxTokens,temperature:temp,messages:[{role:"system",content:systemPrompt},...messages]}),
      });
      if (!res.ok) continue;
      const json = await res.json();
      const text = json.choices?.[0]?.message?.content?.trim()||null;
      if (text) return {text,model:model.label};
    } catch (err) { console.error(`[AI] ${model.id}:`,err.message); }
  }
  return {text:null,model:null};
}

async function callTicketAI(channelId, userMsg, ticketType, formCtx) {
  if (!ticketConvos.has(channelId)) ticketConvos.set(channelId,[]);
  const history = ticketConvos.get(channelId);
  history.push({role:"user",content:userMsg});
  while (history.length>20) history.shift();
  const sysMap = {partnership:AI_PARTNERSHIP_SYSTEM,inquiry:AI_INQUIRY_SYSTEM,default:AI_INQUIRY_SYSTEM};
  const sys = (sysMap[ticketType]||sysMap.default)
    +(formCtx?`\n\n## Ticket Context\n${formCtx}`:"")
    +"\n\nIMPORTANT: Reply in ONE single complete message. Resolve everything in one response.";
  const result = await callGroq(history,sys,{maxTokens:900});
  if (result.text) history.push({role:"assistant",content:result.text});
  return result;
}

// ═══════════════════════════════════════════════════════════════════════════
//  IMAGE GENERATION
// ═══════════════════════════════════════════════════════════════════════════

async function enhanceImagePrompt(userPrompt) {
  const {text} = await callGroq([{role:"user",content:`Enhance this image prompt: "${userPrompt}"`}],AI_IMAGE_SYSTEM,{maxTokens:200,temperature:0.8});
  return text||userPrompt;
}

async function generateImageStability(prompt,style) {
  const fullPrompt = style?`${prompt}, ${IMG_STYLES[style]||""}`:prompt;
  const res = await fetch("https://api.stability.ai/v1/generation/stable-diffusion-xl-1024-v1-0/text-to-image",{
    method:"POST",headers:{"Content-Type":"application/json","Authorization":`Bearer ${STABILITY_API_KEY}`,"Accept":"application/json"},
    body:JSON.stringify({text_prompts:[{text:fullPrompt,weight:1},{text:"blurry, bad quality, distorted, ugly, nsfw",weight:-1}],cfg_scale:7,height:1024,width:1024,steps:30,samples:1}),
  });
  if (!res.ok) throw new Error(`Stability API: ${res.status}`);
  const json = await res.json();
  const b64 = json.artifacts?.[0]?.base64;
  if (!b64) throw new Error("No image in response");
  return {buffer:Buffer.from(b64,"base64"),ext:"png",source:"Stability AI SDXL"};
}

async function generateImagePollinations(prompt,style) {
  const styleTag = style?`, ${IMG_STYLES[style]}`:"";
  const encoded  = encodeURIComponent(`${prompt}${styleTag}`);
  const seed     = Math.floor(Math.random()*999_999);
  const url      = `https://image.pollinations.ai/prompt/${encoded}?width=1024&height=1024&nologo=true&seed=${seed}&enhance=true`;
  const res = await fetch(url);
  if (!res.ok) throw new Error(`Pollinations: ${res.status}`);
  return {buffer:Buffer.from(await res.arrayBuffer()),ext:"png",source:"Pollinations AI (free)"};
}

async function generateImage(prompt,style) {
  if (STABILITY_API_KEY) { try { return await generateImageStability(prompt,style); } catch(err){console.warn("[ImgGen] Stability failed:",err.message);} }
  return generateImagePollinations(prompt,style);
}

