//  HELP EMBEDS (5 pages — complete command list)
// ═══════════════════════════════════════════════════════════════════════════

function buildHelpEmbed(page=1) {
  const pages=[
    // PAGE 1 — General, AI, Commissions
    new EmbedBuilder().setColor(BRAND_COLOR)
      .setAuthor({name:`${BOT_NAME} v${BOT_VERSION}`,iconURL:client.user?.displayAvatarURL()})
      .setTitle("📖 Commands — Page 1/5 — General, AI & Commissions")
      .setDescription(`Both \`s!\` prefix and \`/\` slash work for all commands!\nAI: ${GROQ_API_KEY?"✅ Online":"❌ Offline"} | \`s!help 2\` for next page`)
      .addFields(
        {name:"🌐 General",value:[
          "`help [page]` — All commands (this menu, 5 pages)",
          "`info` — Bot info, version, uptime",
          "`ping` — Check bot latency",
          "`status` — Systems status overview",
          "`rules` — Server rules",
          "`uptime` — How long bot has been online",
          "`invite` — Get bot invite link",
          "`setup` — Full admin setup guide",
        ].join("\n")},
        {name:"🤖 AI",value:[
          "`ai <message>` — Chat with Snuggles AI (remembers conversation)",
          "`ai-reset` — Clear your AI chat history",
          "`imagine <prompt> [style]` — Generate an AI image",
          "`aioff` — Disable AI in this ticket (staff)",
          "`aion` — Re-enable AI in this ticket (staff)",
          "**Image styles:** realistic, anime, cartoon, fantasy, minimal, pixel, oil, sketch",
        ].join("\n")},
        {name:"💼 Commissions",value:[
          "`services` — View all available services",
          "`prices` — Pricing ranges & payment methods",
          "`pay` — Payment links (CashApp/PayPal)",
          "`orderinfo <id>` — Check an order's status",
