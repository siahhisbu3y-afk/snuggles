const STATUS_CYCLE = [
  n=>({name:`over ${n} server${n!==1?"s":""} 💗`,    type:ActivityType.Watching}),
  n=>({name:`${n} Roblox scripter${n!==1?"s":""} ✨`,type:ActivityType.Watching}),
  n=>({name:`s!help — ${BOT_NAME}`,                   type:ActivityType.Playing}),
  n=>({name:`commissions open! 💗`,                   type:ActivityType.Playing}),
];
let _statusIdx=0;
function updateStatus() {
  const n=client.guilds.cache.size;
  const s=STATUS_CYCLE[_statusIdx++%STATUS_CYCLE.length](n);
  client.user?.setActivity(s.name,{type:s.type});
}

// ═══════════════════════════════════════════════════════════════════════════
//  ANTI-RAID
// ═══════════════════════════════════════════════════════════════════════════

const raidTrackers = new Map();
const nukeTrackers = new Map();

async function handleAntiRaidJoin(member) {
  const s=getAntiRaid(member.guild.id);
  if (!s.enabled) return;
  if (s.whitelistedUsers?.includes(member.id)) return;
  if (s.whitelistedRoles?.some(r=>member.roles.cache.has(r))) return;

  if (!raidTrackers.has(member.guild.id)) raidTrackers.set(member.guild.id,{joins:[],locked:false,actioned:new Set()});
  const t=raidTrackers.get(member.guild.id), now=Date.now();
  t.joins=t.joins.filter(j=>now-j<s.window);
  t.joins.push(now);

  if (t.joins.length>=s.threshold&&!t.locked) {
    t.locked=true;
    console.log(`[AntiRaid] 🛡️ Raid detected in ${member.guild.name}! ${t.joins.length} joins in ${s.window/1000}s`);
    if (s.notifyChannel) {
      const ch=await member.guild.channels.fetch(s.notifyChannel).catch(()=>null);
      if (ch?.isTextBased()) await ch.send({embeds:[new EmbedBuilder().setColor(ERROR_COLOR).setTitle("🛡️ RAID DETECTED")
        .setDescription(`**${t.joins.length}** joins in **${s.window/1000}s**! Action: **${s.action.toUpperCase()}**`).setTimestamp()]}).catch(()=>{});
    }
    if (s.autoUnlock>0) {
      setTimeout(()=>{
        if (raidTrackers.has(member.guild.id)) {
          const tr=raidTrackers.get(member.guild.id);
          tr.locked=false; tr.actioned.clear();
          console.log(`[AntiRaid] Auto-unlocked in ${member.guild.name}`);
        }
      },s.autoUnlock);
    }
  }

  if (t.locked&&s.action!=="none"&&!t.actioned.has(member.id)) {
    t.actioned.add(member.id);
    if (s.dmOnAction) await member.user.send({content:`🛡️ **${member.guild.name}** — You were ${s.action==="ban"?"banned":"kicked"} by the anti-raid system. Contact a server admin if this was a mistake.`}).catch(()=>{});
    if (s.action==="ban")  await member.ban({reason:"Anti-Raid: raid in progress"}).catch(()=>{});
    if (s.action==="kick") await member.kick("Anti-Raid: raid in progress").catch(()=>{});
  }
}

async function checkNuke(guild, userId, type) {
  const s=getAntiNuke(guild.id);
  if (!s.enabled||userId===client.user?.id) return;
  if (s.trustedUsers?.includes(userId)) return;
  const key=`${guild.id}:${userId}`;
  if (!nukeTrackers.has(key)) nukeTrackers.set(key,{channelDeletes:[],bans:[],roleDeletes:[],kicks:[]});
  const t=nukeTrackers.get(key), now=Date.now();
  const map={
    channelDelete:{arr:"channelDeletes",th:s.channelDeleteThreshold,label:"channel deletions"},
    ban:          {arr:"bans",          th:s.banThreshold,           label:"bans"},
    roleDelete:   {arr:"roleDeletes",   th:s.roleDeleteThreshold,    label:"role deletions"},
    kick:         {arr:"kicks",         th:s.kickThreshold,          label:"kicks"},
  };
  const c=map[type]; if (!c) return;
  t[c.arr]=t[c.arr].filter(x=>now-x<s.window);
  t[c.arr].push(now);
  if (t[c.arr].length>=c.th) { t[c.arr]=[]; await triggerNuke(guild,userId,`${c.th} ${c.label} in ${s.window/1000}s`,s); }
}

async function triggerNuke(guild, userId, reason, s) {
  const member=await guild.members.fetch(userId).catch(()=>null); if (!member)return;
  if (member.permissions.has(PermissionFlagsBits.Administrator)) return;
  if (s.trustedRoles?.some(r=>member.roles.cache.has(r))) return;
  console.log(`[AntiNuke] ☢️ Triggered in ${guild.name} for ${member.user.tag}: ${reason}`);
  try {
    if (s.action==="ban")   await member.ban({reason:`Anti-Nuke: ${reason}`});
    if (s.action==="kick")  await member.kick(`Anti-Nuke: ${reason}`);
    if (s.action==="strip") await member.roles.set([],`Anti-Nuke: ${reason}`).catch(()=>{});
    await member.user.send({content:`🚨 **${guild.name}** — Anti-Nuke triggered. Action: **${s.action}**. Reason: ${reason}`}).catch(()=>{});
  } catch {}
  if (s.notifyChannel) {
    const ch=await guild.channels.fetch(s.notifyChannel).catch(()=>null);
    if (ch?.isTextBased()) await ch.send({embeds:[new EmbedBuilder().setColor(ERROR_COLOR).setTitle("☢️ ANTI-NUKE TRIGGERED")
      .addFields({name:"User",value:`<@${userId}> (${member.user.tag})`},{name:"Action",value:s.action.toUpperCase(),inline:true},{name:"Reason",value:reason}).setTimestamp()]}).catch(()=>{});
  }
}

// ═══════════════════════════════════════════════════════════════════════════
//  TICKET SYSTEM
// ═══════════════════════════════════════════════════════════════════════════

function buildTicketPanel() {
  const embed = new EmbedBuilder().setColor(BRAND_COLOR).setTitle(`🧸 ${BOT_NAME} — Open a Ticket`)
    .setDescription([
      "**Need help or want to commission something?**",
      "Choose your ticket type below!\n",
      "╔══════════════════════════════╗",
      "║  📦 **Order** — Commission a script/system",
      "║  🤝 **Partnership** — Partner with our server",
      "║  ❓ **Inquiry** — Questions & support",
      "╚══════════════════════════════╝\n",
      "*Partnership & Inquiry tickets handled by **Snuggles AI** — instant, 24/7!*",
      "*Order tickets are reviewed by staff.* 💗",
    ].join("\n"))
    .setFooter({text:`${BOT_NAME} v${BOT_VERSION} • AI-Powered Support`}).setTimestamp();
  const row = new ActionRowBuilder().addComponents(
    new ButtonBuilder().setCustomId("ticket_order").setLabel("Order").setStyle(ButtonStyle.Primary).setEmoji("📦"),
    new ButtonBuilder().setCustomId("ticket_partner").setLabel("Partnership").setStyle(ButtonStyle.Success).setEmoji("🤝"),
    new ButtonBuilder().setCustomId("ticket_inquiry").setLabel("Inquiry").setStyle(ButtonStyle.Secondary).setEmoji("❓"),
  );
  return {embed,row};
}

async function repostTicketPanel() {
  for (const [gid,s] of Object.entries(data.settings)) {
    if (!s.ticketPanelChannelId) continue;
    try {
      const g=client.guilds.cache.get(gid); if (!g)continue;
      const ch=await g.channels.fetch(s.ticketPanelChannelId).catch(()=>null); if (!ch?.isTextBased())continue;
      if (s.ticketPanelMsgId) { try{await ch.messages.delete(s.ticketPanelMsgId);}catch{} }
      const {embed,row}=buildTicketPanel();
      const sent=await ch.send({embeds:[embed],components:[row]});
      s.ticketPanelMsgId=sent.id; saveData();
    } catch {}
  }
}

async function openTicket(guild, member, ticketType, formAnswers) {
  if (!guild||!member) return {ok:false,error:"Must be used in a server."};
  const s=getSettings(guild.id);
  const safeName=member.user.username.toLowerCase().replace(/[^a-z0-9]/g,"").slice(0,16)||"user";
  let chanName=`ticket-${safeName}`;
  const maxOpen=s.maxOpenTickets||1;
  const existing=guild.channels.cache.filter(c=>c.type===ChannelType.GuildText&&c.name.startsWith("ticket-")&&c.permissionOverwrites.cache.has(member.id));
  if (existing.size>=maxOpen) return {ok:false,error:`You already have **${existing.size}** open ticket(s). Max: ${maxOpen}`};
  if (guild.channels.cache.find(c=>c.name===chanName)) chanName+=`-${Date.now().toString(36).slice(-4)}`;

  const staffRoles=s.ticketStaffRoles||[];
  const overwrites=[
    {id:guild.roles.everyone.id,deny:[PermissionFlagsBits.ViewChannel]},
    {id:member.id,allow:[PermissionFlagsBits.ViewChannel,PermissionFlagsBits.SendMessages,PermissionFlagsBits.ReadMessageHistory,PermissionFlagsBits.AttachFiles]},
    {id:client.user.id,allow:[PermissionFlagsBits.ViewChannel,PermissionFlagsBits.SendMessages,PermissionFlagsBits.ManageChannels,PermissionFlagsBits.ReadMessageHistory]},
  ];
  for (const r of staffRoles) overwrites.push({id:r,allow:[PermissionFlagsBits.ViewChannel,PermissionFlagsBits.SendMessages,PermissionFlagsBits.ReadMessageHistory,PermissionFlagsBits.AttachFiles,PermissionFlagsBits.ManageMessages]});
  guild.roles.cache.forEach(r=>{if(r.permissions.has(PermissionFlagsBits.ManageMessages)&&!r.managed&&!staffRoles.includes(r.id))overwrites.push({id:r.id,allow:[PermissionFlagsBits.ViewChannel,PermissionFlagsBits.SendMessages,PermissionFlagsBits.ReadMessageHistory,PermissionFlagsBits.AttachFiles]});});

  let created;
  try {
    created=await guild.channels.create({name:chanName,type:ChannelType.GuildText,topic:`[${ticketType}] ${member.user.tag}`,permissionOverwrites:overwrites,parent:s.ticketCategoryId||undefined,reason:`Ticket by ${member.user.tag}`});
  } catch { return {ok:false,error:"Failed to create channel. Check **Manage Channels** permission."}; }

  data.stats.ticketsOpened=(data.stats.ticketsOpened||0)+1; saveData();
  const closeRow=new ActionRowBuilder().addComponents(new ButtonBuilder().setCustomId("ticket_close_btn").setLabel("Close Ticket").setStyle(ButtonStyle.Danger).setEmoji("🔒"));

  let detailEmbed, formCtx="";
  if (ticketType==="order") {
    formCtx=`Roblox: ${formAnswers.username}\nService: ${formAnswers.service}\nDesc: ${formAnswers.description}\nBudget: ${formAnswers.budget}\nPayment: ${formAnswers.payment}`;
    detailEmbed=new EmbedBuilder().setColor(BRAND_COLOR).setTitle("📦 New Order Ticket")
      .setDescription("Thank you! Staff will review this shortly. 💗")
      .addFields({name:"👤 Roblox Username",value:formAnswers.username||"—"},{name:"🛠️ Service",value:formAnswers.service||"—"},{name:"📝 Description",value:formAnswers.description||"—"},{name:"💰 Budget",value:formAnswers.budget||"—",inline:true},{name:"💳 Payment",value:formAnswers.payment||"—",inline:true})
      .setFooter({text:`Order • ${member.user.tag}`}).setTimestamp();
    if (hasOrdered(member.id)) detailEmbed.addFields({name:"🎟️ Loyalty Discount",value:"✅ Returning customer — **5% off** applied!"});
  } else if (ticketType==="partnership") {
    formCtx=`Server: ${formAnswers.serverName}\nInvite: ${formAnswers.invite}\nMembers: ${formAnswers.memberCount}\nFocus: ${formAnswers.focus}\nOffering: ${formAnswers.offering}`;
    detailEmbed=new EmbedBuilder().setColor(SUCCESS_COLOR).setTitle("🤝 Partnership Ticket")
      .addFields({name:"🏠 Server",value:formAnswers.serverName||"—"},{name:"🔗 Invite",value:formAnswers.invite||"—"},{name:"👥 Members",value:formAnswers.memberCount||"—",inline:true},{name:"🎯 Focus",value:formAnswers.focus||"—",inline:true},{name:"🤝 Offering",value:formAnswers.offering||"—"})
      .setFooter({text:`Partnership • ${member.user.tag}`}).setTimestamp();
  } else {
    formCtx=`Name: ${formAnswers.name}\nTopic: ${formAnswers.topic}\nDetails: ${formAnswers.details}\nUrgency: ${formAnswers.urgency||"—"}`;
    detailEmbed=new EmbedBuilder().setColor(INFO_COLOR).setTitle("❓ Inquiry Ticket")
      .addFields({name:"👤 Name",value:formAnswers.name||"—"},{name:"❓ Topic",value:formAnswers.topic||"—"},{name:"📝 Details",value:formAnswers.details||"—"},{name:"⚡ Urgency",value:formAnswers.urgency||"Not specified",inline:true})
      .setFooter({text:`Inquiry • ${member.user.tag}`}).setTimestamp();
  }

  await created.send({content:`<@${member.id}> Welcome to your ticket!${s.ticketGreeting?`\n\n> ${s.ticketGreeting}`:""}`,embeds:[detailEmbed],components:[closeRow]});

  if (ticketType!=="order") {
    setImmediate(async()=>{
      try {
        let prompt;
        if (ticketType==="partnership") {
          const count=parseInt(String(formAnswers.memberCount||"0").replace(/,/g,"").match(/\d+/)?.[0]||"0",10);
          if (count>0&&count<45) {
            await created.send({embeds:[new EmbedBuilder().setColor(ERROR_COLOR).setTitle("❌ Partnership Declined")
              .setDescription(`Thank you for your interest in **${BOT_NAME}**!\n\nWe require a minimum of **45 members**. You have **${count}**.\n\nFeel free to apply again once you've grown! 🌸`)
              .setFooter({text:"Re-apply anytime!"}).setTimestamp()]});
            setTimeout(()=>created.delete("Partnership declined").catch(()=>{}),15_000);
            return;
          }
          partnerAwaitAd.set(created.id,{member,formAnswers,count});
          prompt=`New partnership ticket. Details:\n${formCtx}\n\nMember count: ${formAnswers.memberCount} (meets 45 min). Greet them warmly, confirm the partnership looks good, and ask them to send their server ad text. ONE message.`;
        } else {
          prompt=`New support inquiry.\n${formCtx}\n\nRespond helpfully and completely in ONE message.`;
        }
        const {text,model}=await callTicketAI(created.id,prompt,ticketType,formCtx);
        if (text) await created.send({embeds:[aiEmbed(text,model,member.user.username,ticketType)]});
      } catch(err){console.error("[TicketAI]",err.message);}
    });
  }
  return {ok:true,channel:created};
}

async function closeTicket(channel, closer, reason, guild) {
  let ownerId=null;
  for (const [id,o] of channel.permissionOverwrites.cache){if(o.type===1){ownerId=id;break;}}
  const msgs=[]; let lastId;
  for (let i=0;i<10;i++){
    const b=await channel.messages.fetch({limit:100,...(lastId?{before:lastId}:{})});
    if(!b.size)break; msgs.push(...b.values()); lastId=b.last().id; if(b.size<100)break;
  }
  msgs.sort((a,b)=>a.createdTimestamp-b.createdTimestamp);
  const transcript=[`Transcript: #${channel.name}`,`Closed: ${new Date().toISOString()}`,`Messages: ${msgs.length}`,"─".repeat(40),"",
    ...msgs.map(m=>`[${new Date(m.createdTimestamp).toISOString()}] ${m.author.tag}: ${m.content||""}${m.embeds.length?` [${m.embeds.length} embed(s)]`:""}`)
  ].join("\n");
  const file={attachment:Buffer.from(transcript,"utf8"),name:`${channel.name}-transcript.txt`};
  const s=getSettings(guild.id); const tcId=s.transcriptsChannelId||data.modLogChannels[guild.id];
  if(tcId){const tc=await guild.channels.fetch(tcId).catch(()=>null);if(tc?.isTextBased())await tc.send({embeds:[E.brand("🎟️ Ticket Closed").addFields({name:"Channel",value:`#${channel.name}`},{name:"Closed By",value:closer.user?.tag||closer.tag||"—",inline:true},{name:"Reason",value:reason,inline:true}).setTimestamp()],files:[file]}).catch(()=>{});}
  if(ownerId){try{const u=await client.users.fetch(ownerId);await u.send({embeds:[E.brand("🎟️ Ticket Closed").setDescription(`**#${channel.name}** closed.\n**Reason:** ${reason}`)],files:[{attachment:Buffer.from(transcript,"utf8"),name:`${channel.name}-transcript.txt`}]});}catch{}}
  ticketConvos.delete(channel.id); ticketAIOff.delete(channel.id); partnerAwaitAd.delete(channel.id);
  data.stats.ticketsClosed=(data.stats.ticketsClosed||0)+1; saveData();
  await channel.send({embeds:[E.warn("🔒 Closing in 5 seconds…").setDescription(`**Reason:** ${reason}`)]});
  setTimeout(()=>channel.delete(`Closed: ${reason}`).catch(()=>{}),5000);
}

// ═══════════════════════════════════════════════════════════════════════════
//  ORDER BOARD
// ═══════════════════════════════════════════════════════════════════════════

async function updateOrderBoard() {
  if (!HOME_GUILD_ID||!ORDER_CHANNEL_ID) return;
  try {
    const g=client.guilds.cache.get(HOME_GUILD_ID); if (!g)return;
    const ch=await g.channels.fetch(ORDER_CHANNEL_ID).catch(()=>null); if (!ch?.isTextBased())return;
    const active=data.orders.filter(o=>o.status!=="completed"&&o.status!=="cancelled");
    const doneToday=data.orders.filter(o=>o.status==="completed"&&Date.now()-new Date(o.updatedAt).getTime()<86_400_000);
    const emb=new EmbedBuilder().setColor(BRAND_COLOR).setTitle("📋 Commission Order Board")
      .setDescription(`**Updated:** <t:${Math.floor(Date.now()/1000)}:R> | **Active:** ${active.length} | **Done Today:** ${doneToday.length}\n\n> Use the ticket panel to commission! 💗`)
      .setFooter({text:`${BOT_NAME} • Updates every 3 hours`}).setTimestamp();
    if (!active.length) emb.addFields({name:"✅ Queue Clear",value:"No active orders!"});
    else for (const o of active.slice(0,10)){const si=getOrderStatus(o.status);emb.addFields({name:`${si.label} — #${o.id}`,value:`**Customer:** <@${o.userId}>\n**Details:** ${o.details.slice(0,100)}${o.details.length>100?"...":""}\n**Updated:** <t:${Math.floor(new Date(o.updatedAt).getTime()/1000)}:R>`});}
    if (active.length>10) emb.addFields({name:`+${active.length-10} more`,value:"Use `/orderinfo <id>`"});
    const s=getSettings(HOME_GUILD_ID);
    if (s.orderBoardMsgId){try{await ch.messages.delete(s.orderBoardMsgId);}catch{}}
    const sent=await ch.send({embeds:[emb]}); s.orderBoardMsgId=sent.id; saveData();
  } catch {}
}

// ═══════════════════════════════════════════════════════════════════════════
//  REACTION ROLES
// ═══════════════════════════════════════════════════════════════════════════

async function handleReactionRole(reaction, user, add) {
  try {
    if (user.bot) return;
    const guild=reaction.message.guild; if (!guild)return;
    const guildRR=data.reactionRoles[guild.id]; if (!guildRR)return;
    const msgRR=guildRR[reaction.message.id]; if (!msgRR)return;
    const emoji=reaction.emoji.id?`<:${reaction.emoji.name}:${reaction.emoji.id}>`:reaction.emoji.name;
    const roleId=msgRR[emoji]||msgRR[reaction.emoji.name]; if (!roleId)return;
    const member=await guild.members.fetch(user.id).catch(()=>null); if (!member)return;
    const role=guild.roles.cache.get(roleId); if (!role)return;
    if (add) await member.roles.add(role,"Reaction role").catch(()=>{});
    else await member.roles.remove(role,"Reaction role").catch(()=>{});
  } catch(err){console.error("[ReactionRole]",err.message);}
}

// ═══════════════════════════════════════════════════════════════════════════
//  LEVELING
// ═══════════════════════════════════════════════════════════════════════════

async function grantXP(msg) {
  const lv=getLv(msg.author.id), now=Date.now();
  if (now-lv.lastXpAt<XP_COOLDOWN_MS) return;
  lv.lastXpAt=now; lv.totalMessages=(lv.totalMessages||0)+1;
  lv.xp+=Math.max(1,XP_PER_MSG+Math.floor(Math.random()*XP_VARIANCE*2)-XP_VARIANCE);
  const needed=xpForLevel(lv.level);
  if (lv.xp>=needed) {
    lv.xp-=needed; lv.level++; saveData();
    if (!LEVELUP_CHANNEL_ID) return;
    const ch=msg.guild?.channels.cache.get(LEVELUP_CHANNEL_ID)||msg.channel;
    await ch.send({content:`<@${msg.author.id}>`,embeds:[E.xp("🎉 Level Up!").setDescription(`<@${msg.author.id}> reached **Level ${lv.level}**! 🚀`).setThumbnail(msg.author.displayAvatarURL()).setFooter({text:`Next level: ${xpForLevel(lv.level)} XP`}).setTimestamp()]}).catch(()=>{});
  } else saveData();
}

async function grantCoins(msg) {
  const eco=getEco(msg.author.id), now=Date.now();
  if (now-eco.lastCoinAt<COINS_CD_MS) return;
  eco.lastCoinAt=now; eco.coins=(eco.coins||0)+COINS_PER_MSG; saveData();
}

// ═══════════════════════════════════════════════════════════════════════════
//  INVITE TRACKING
// ═══════════════════════════════════════════════════════════════════════════

async function cacheInvites(guild) {
  try {
    const inv=await guild.invites.fetch();
    if (!data.inviteCache[guild.id]) data.inviteCache[guild.id]={};
    inv.forEach(i=>{data.inviteCache[guild.id][i.code]=i.uses||0;});
  } catch {}
}

// ═══════════════════════════════════════════════════════════════════════════
//  STICKY MESSAGES
// ═══════════════════════════════════════════════════════════════════════════

const STICKY_TEXT="✨ **Want to leave a review?**\n\nUse `/review <1-5> <type> <message>` to share your experience!\n\nYour feedback means the world to us 💗";

async function refreshSticky(channel) {
  if (!STICKY_CHANNEL_ID||channel.id!==STICKY_CHANNEL_ID) return;
  const prev=data.stickyMessages[channel.id];
  if (prev){try{await channel.messages.delete(prev);}catch{}}
  const sent=await channel.send({embeds:[E.brand("").setDescription(STICKY_TEXT).setFooter({text:`${BOT_NAME} • Sticky`})]}).catch(()=>null);
  if (sent){data.stickyMessages[channel.id]=sent.id;saveData();}
}

// ═══════════════════════════════════════════════════════════════════════════
//  GIVEAWAYS
// ═══════════════════════════════════════════════════════════════════════════

async function checkGiveaways() {
  const now=Date.now();
  for (const [msgId,ga] of Object.entries(data.giveaways)) {
    if (ga.ended||ga.endAt>now) continue;
    ga.ended=true; saveData();
    try {
      const g=client.guilds.cache.get(ga.guildId); if (!g)continue;
      const ch=await g.channels.fetch(ga.channelId).catch(()=>null); if (!ch)continue;
      const msg=await ch.messages.fetch(msgId).catch(()=>null); if (!msg)continue;
      const rxn=msg.reactions.cache.get("🎉");
      let entrants=[];
      if (rxn){let last;while(true){const b=await rxn.users.fetch({limit:100,...(last?{after:last}:{})}).catch(()=>null);if(!b||!b.size)break;entrants.push(...b.filter(u=>!u.bot).map(u=>u.id));if(b.size<100)break;last=b.last().id;}}
      if (!entrants.length) await ch.send({embeds:[E.warn("🎉 Giveaway Ended").setDescription(`**${ga.prize}** — No valid entries.`)]});
      else {
        const w=entrants[Math.floor(Math.random()*entrants.length)];
        await ch.send({content:`🎉 <@${w}>`,embeds:[E.success("🎉 Giveaway Winner!").setDescription(`<@${w}> won **${ga.prize}**!\nContact us to claim.`).addFields({name:"Entries",value:`${entrants.length}`}).setTimestamp()],allowedMentions:{users:[w]}});
      }
    } catch {}
  }
}

// ═══════════════════════════════════════════════════════════════════════════
//  READY
// ═══════════════════════════════════════════════════════════════════════════

client.once("clientReady", async () => {
  console.log(`✅  ${BOT_NAME} v${BOT_VERSION} — ${client.user.tag}`);
  console.log(`🤖  AI: ${GROQ_API_KEY?"Groq Enabled":"Disabled"}`);
  console.log(`🖼️   Image Gen: ${STABILITY_API_KEY?"Stability AI":"Pollinations (free)"}`);
  await registerSlashCommands();
  for (const [,g] of client.guilds.cache) await cacheInvites(g).catch(()=>{});
  updateStatus();
  setInterval(updateStatus,     5*60_000);
  setInterval(checkGiveaways,   10_000);
  setInterval(updateOrderBoard, 3*60*60_000);
  setInterval(repostTicketPanel,24*60*60_000);
  setTimeout(updateOrderBoard,  6_000);
  setTimeout(repostTicketPanel, 12_000);
});

// ═══════════════════════════════════════════════════════════════════════════
//  CORE COMMAND EXECUTOR — handles BOTH slash and prefix contexts
// ═══════════════════════════════════════════════════════════════════════════

async function execCommand(cmdName, ctx) {
  const { guild, member, user } = ctx;

  // Blacklist check
  if (data.blacklist.includes(user.id)&&cmdName!=="blacklist")
    return ctx.reply({embeds:[E.error("🚫 You are blacklisted.")]},true);

  // Cooldown check
  if (CD_CONFIG[cmdName]) {
    const w=checkCD(cmdName,user.id);
    if (w>0) return ctx.reply({embeds:[E.warn("⏰ Cooldown").setDescription(`Try again in **${w}s**.`)]},true);
    useCD(cmdName,user.id);
  }

  switch (cmdName) {

    // ── GENERAL ────────────────────────────────────────────────────────────
    case "help": {
      const page = ctx.getInteger("page")||parseInt(ctx.getArg(0)||"1",10)||1;
      return ctx.reply({embeds:[buildHelpEmbed(page)]});
    }

    case "setup": {
      const emb=new EmbedBuilder().setColor(BRAND_COLOR)
        .setAuthor({name:`${BOT_NAME} Setup Guide`,iconURL:client.user?.displayAvatarURL()})
        .setTitle("⚙️ Server Setup Guide")
        .setDescription("Follow these steps to configure the bot for your server.")
        .addFields(
          {name:"**Step 1 — Basic Config**",value:"`/setlog` `/setreviews` `/settranscripts` `/setverifyrole` `/setscamchannel`"},
          {name:"**Step 2 — Ticket System**",value:"Run `/ticketpanel` in your support channel. Members click buttons to open tickets. AI handles Partnership & Inquiry; staff handles Orders."},
          {name:"**Step 3 — Reaction Roles**",value:"Post a message → copy ID → `/reactionrole add <msgid> <emoji> <@role>`"},
          {name:"**Step 4 — Roblox Verification**",value:"`/setverifyrole @role` → members run `/verify <username>` → add code to bio → `/checkverify <code>`"},
          {name:"**Step 5 — Security**",value:"`/antiraid enable` then `/antiraid config` | `/antinuke enable` then `/antinuke config` | Trust your admins with `/antinuke trust @user`"},
          {name:"**Optional .env Channel IDs**",value:"HOME_GUILD_ID, ERROR_CHANNEL_ID, LEVELUP_CHANNEL_ID, STICKY_CHANNEL_ID, ORDER_CHANNEL_ID, FORUM_SUPPORT_CHANNEL_ID, PARTNER_AD_CHANNEL_ID"},
        ).setFooter({text:`${BOT_NAME} v${BOT_VERSION}`}).setTimestamp();
      return ctx.reply({embeds:[emb]});
    }

    case "info": {
      const up=process.uptime(),h=Math.floor(up/3600),m=Math.floor((up%3600)/60),s2=Math.floor(up%60);
      return ctx.reply({embeds:[E.brand(`🧸 ${BOT_NAME} v${BOT_VERSION}`)
        .addFields(
          {name:"🤖 Tag",value:client.user?.tag||"—",inline:true},
          {name:"📦 Version",value:`v${BOT_VERSION}`,inline:true},
          {name:"👑 Owner",value:BOT_OWNER,inline:true},
          {name:"🌐 Servers",value:`${client.guilds.cache.size}`,inline:true},
          {name:"⏱️ Uptime",value:`${h}h ${m}m ${s2}s`,inline:true},
          {name:"📋 Orders",value:`${data.orders.length}`,inline:true},
          {name:"🤖 AI",value:GROQ_API_KEY?"✅ Groq":"❌ Disabled",inline:true},
          {name:"🖼️ Images",value:STABILITY_API_KEY?"Stability AI":"Pollinations",inline:true},
          {name:"🟣 Verified",value:`${Object.keys(data.robloxVerified).length} users`,inline:true},
        ).setTimestamp()]});
    }

    case "ping": {
      // For slash we can do round-trip; for prefix just ws ping
      if (ctx.isSlash) {
        const sent=await ctx.interaction.reply({embeds:[E.info("🏓 Pinging…")],fetchReply:true});
        const latency=sent.createdTimestamp-ctx.interaction.createdTimestamp;
        return ctx.interaction.editReply({embeds:[E.success("🏓 Pong!").addFields({name:"⏱️ Round-trip",value:`${latency}ms`,inline:true},{name:"💓 Gateway",value:`${Math.round(client.ws.ping)}ms`,inline:true})]});
      }
      return ctx.reply({embeds:[E.success("🏓 Pong!").addFields({name:"💓 Gateway",value:`${Math.round(client.ws.ping)}ms`,inline:true})]});
    }

    case "status": {
      if (ctx.isSlash) await ctx.interaction.deferReply().catch(()=>{});
      return ctx.reply({embeds:[E.success("🟢 All Systems Operational")
        .addFields(
          {name:"🤖 Bot",    value:"🟢 Online",inline:true},
          {name:"📡 Gateway",value:`${Math.round(client.ws.ping)}ms`,inline:true},
          {name:"📋 Orders", value:`🟢 ${data.orders.filter(o=>o.status!=="completed").length} active`,inline:true},
          {name:"📊 Users",  value:`🟢 ${Object.keys(data.leveling).length} tracked`,inline:true},
          {name:"🤖 AI",     value:GROQ_API_KEY?"🟢 Groq Ready":"🔴 No key",inline:true},
          {name:"🟣 Roblox", value:`🟢 ${Object.keys(data.robloxVerified).length} verified`,inline:true},
          {name:"🛡️ Anti-Raid",value:guild&&getAntiRaid(guild.id).enabled?"🟢 Active":"🔴 Disabled",inline:true},
          {name:"☢️ Anti-Nuke",value:guild&&getAntiNuke(guild.id).enabled?"🟢 Active":"🔴 Disabled",inline:true},
        ).setTimestamp()]});
    }

    case "rules":
      return ctx.reply({embeds:[E.brand("📜 Server Rules").setDescription(SERVER_RULES.join("\n\n"))]});

    case "uptime":
      return ctx.reply({embeds:[E.brand("⏱️ Uptime").setDescription(`Online for **${fmtDuration(Math.floor(process.uptime()*1000))}**`)]});

    case "invite":
      return ctx.reply({embeds:[E.brand("🔗 Invite").setDescription(`[Click here to invite ${BOT_NAME}](https://discord.com/api/oauth2/authorize?client_id=${CLIENT_ID}&permissions=8&scope=bot%20applications.commands)`)]});

    // ── AI ──────────────────────────────────────────────────────────────────
    case "ai": {
      if (!GROQ_API_KEY) return ctx.reply({embeds:[E.error("AI Disabled").setDescription("No GROQ_API_KEY configured.")]},true);
      const prompt=ctx.getString("message",true)||ctx.getArgs().join(" ");
      if (!prompt) return ctx.reply({embeds:[E.warn("Usage: `s!ai <message>` or `/ai <message>`")]});
      if (ctx.isSlash) await ctx.interaction.deferReply().catch(()=>{});
      else await ctx.channel.sendTyping().catch(()=>{});
      const uid=user.id;
      if (!userChatHistory.has(uid)) userChatHistory.set(uid,[]);
      const hist=userChatHistory.get(uid);
      hist.push({role:"user",content:prompt});
      while (hist.length>20) hist.shift();
      const {text,model}=await callGroq(hist,AI_CHAT_SYSTEM,{maxTokens:1000,temperature:0.75});
      if (!text) return ctx.reply({content:"❌ AI is busy, try again later."});
      hist.push({role:"assistant",content:text});
      return ctx.reply({embeds:[new EmbedBuilder().setColor(AI_COLOR).setAuthor({name:"Snuggles AI",iconURL:client.user?.displayAvatarURL()}).setDescription(text.length>4000?text.slice(0,4000)+"…":text).setFooter({text:`🤖 ${model||"AI"} • asked by ${user.username}`}).setTimestamp()],allowedMentions:{users:[]}});
    }

    case "ai-reset":
      userChatHistory.delete(user.id);
      return ctx.reply({embeds:[E.success("✅ AI Memory Cleared")]},true);

    case "aioff":
    case "aion": {
      if (!isStaff(member)) return ctx.reply({embeds:[E.error("Staff only.")]},true);
      if (!ctx.channel?.name?.startsWith("ticket-")) return ctx.reply({embeds:[E.warn("Only works in ticket channels.")]},true);
      if (cmdName==="aioff") ticketAIOff.add(ctx.channel.id);
      else ticketAIOff.delete(ctx.channel.id);
      return ctx.reply({content:`${cmdName==="aioff"?"🔇 AI Off":"🔊 AI On"} for this ticket.`});
    }

    case "imagine": {
      const prompt=ctx.getString("prompt",true)||ctx.getArgs().join(" ");
      const style=ctx.getString("style")||null;
      if (!prompt) return ctx.reply({embeds:[E.warn("Usage: `s!imagine <prompt>` or `/imagine <prompt>`")]});
      if (ctx.isSlash) await ctx.interaction.deferReply().catch(()=>{});
      else await ctx.channel.sendTyping().catch(()=>{});
      try {
        const enhanced=await enhanceImagePrompt(`${prompt}${style?`, ${IMG_STYLES[style]}`:""}`);
        const {buffer,ext,source}=await generateImage(enhanced,style);
        const ts=Date.now();
        const attachment=new AttachmentBuilder(buffer,{name:`snuggles-ai-${ts}.${ext}`});
        data.stats.imagesGenerated=(data.stats.imagesGenerated||0)+1; saveData();
        return ctx.reply({embeds:[new EmbedBuilder().setColor(IMG_COLOR)
          .setAuthor({name:"Snuggles AI — Image Generator",iconURL:client.user?.displayAvatarURL()})
          .setTitle("🎨 Image Generated!")
          .setDescription(`**Prompt:** ${prompt}${style?`\n**Style:** \`${style}\``:""}\n*Enhanced with AI*`)
          .setImage(`attachment://snuggles-ai-${ts}.${ext}`)
          .addFields({name:"🔧 Engine",value:source,inline:true},{name:"📐 Resolution",value:"1024×1024",inline:true})
          .setFooter({text:`Snuggles AI • ${user.username}`}).setTimestamp()],files:[attachment]});
      } catch(err){return ctx.reply({embeds:[E.error("Generation Failed").setDescription(err.message)]});}
    }

    // ── COMMISSIONS ─────────────────────────────────────────────────────────
    case "services":
      return ctx.reply({embeds:[E.brand("🛍️ Services").addFields(SERVICES).setTimestamp()]});

    case "prices":
      return ctx.reply({embeds:[new EmbedBuilder().setColor(SUCCESS_COLOR).setTitle("💳 Payment Methods").addFields(...PAYMENT_INFO.methods,{name:"⚠️ Refund Policy",value:PAYMENT_INFO.note}).setTimestamp()]});

    case "pay":
      return ctx.reply({embeds:[E.brand("💸 Payment Details").addFields({name:"💵 CashApp",value:"[$siahhispaid](https://cash.app/$siahhispaid)",inline:true},{name:"🅿️ PayPal",value:"[paypal.me/snugglesscripting](https://paypal.me/snugglesscripting)",inline:true},{name:"⚠️ Note",value:"**F&F only** — All sales final, no refunds."})]});

    case "orderinfo": {
      const id=ctx.getInteger("id")||parseInt(ctx.getArg(0),10);
      const o=findOrder(id);
      if (!o) return ctx.reply({embeds:[E.error("Order not found.")]},true);
      const si=getOrderStatus(o.status);
      const emb=new EmbedBuilder().setColor(si.color).setTitle(`📦 Order #${o.id}`)
        .addFields({name:"📊 Status",value:si.label,inline:true},{name:"👤 Customer",value:`<@${o.userId}>`,inline:true},{name:"📝 Details",value:o.details},{name:"📅 Created",value:`<t:${Math.floor(new Date(o.createdAt).getTime()/1000)}:f>`,inline:true},{name:"🔄 Updated",value:`<t:${Math.floor(new Date(o.updatedAt).getTime()/1000)}:R>`,inline:true});
      if (o.note) emb.addFields({name:"📋 Note",value:o.note});
      return ctx.reply({embeds:[emb.setTimestamp()]});
    }

    case "discount": {
      if (!hasOrdered(user.id)) return ctx.reply({embeds:[E.info("🎟️ Loyalty Discount").setDescription("No orders yet! After your first order you'll get **5% off** future commissions. 💗")]});
      return ctx.reply({embeds:[E.success("🎟️ Loyalty Discount!").setDescription("You qualify for **5% off** your next commission!\n\nOpen a ticket and mention the discount. 💗").addFields({name:"Your Orders",value:`${data.orders.filter(o=>o.userId===user.id).length} total`}).setTimestamp()]});
    }

    case "ticket":
      return ctx.reply({embeds:[E.brand("🎫 Open a Ticket").setDescription("Use the **ticket panel** in the support channel!\n\n📦 **Order** — Commission (staff reviewed)\n🤝 **Partnership** — Partner with us (AI)\n❓ **Inquiry** — Questions & support (AI)")]});

    case "work": {
      if (!data.portfolio.length) return ctx.reply({embeds:[E.brand("🎨 Portfolio").setDescription("No work added yet.")]});
      const total=data.portfolio.length;
      let page=ctx.getInteger("page")||parseInt(ctx.getArg(0)||"1",10)||1;
      if (page>total) page=total;
      const work=[...data.portfolio].reverse()[page-1];
      const isVid=/\.(mov|mp4|webm)(?:\?|$)/i.test(work.url||"");
      const emb=E.brand(`🎨 ${work.title||`Entry #${work.id}`}`).setURL(work.url).addFields({name:"🆔 ID",value:`#${work.id}`,inline:true},{name:"Type",value:isVid?"🎥 Video":"🖼️ Image",inline:true}).setFooter({text:`Page ${page}/${total}`});
      if (!isVid) emb.setImage(work.url);
      return ctx.reply({embeds:[emb]});
    }

    // ── SCRIPTING ────────────────────────────────────────────────────────────
    case "script": {
      const t=ctx.getString("type",true)||ctx.getArg(0)||"";
      const ex=SCRIPT_EXAMPLES[t.toLowerCase()];
      if (!ex) return ctx.reply({embeds:[E.warn("Types: `ui` `datastore` `remote` `movement` `admin`")]},true);
      return ctx.reply({embeds:[E.brand(`📜 ${ex.title}`).setDescription("```lua\n"+ex.code+"\n```")]});
    }

    case "snippet": {
      const s2=SNIPPETS[Math.floor(Math.random()*SNIPPETS.length)];
      return ctx.reply({embeds:[E.brand(`💡 ${s2.title}`).setDescription("```lua\n"+s2.code+"\n```")]});
    }

    case "docs":
      return ctx.reply({embeds:[E.brand("📚 Resources").addFields(DOCS.map(d=>({name:d.name,value:d.value})))]});

    case "debug":
      return ctx.reply({embeds:[E.warn("🐛 Debug Template").setDescription("```\nGoal:\n<what you're trying to do>\n\nIssue:\n<what's happening>\n\nError:\n<paste from Output>\n\nCode:\n<broken section>\n\nAttempted:\n<what you've tried>\n```")]});

    case "tip":
      return ctx.reply({embeds:[E.brand("💡 Scripting Tip").setDescription(TIPS[Math.floor(Math.random()*TIPS.length)])]});

    // ── LEVELING / ECONOMY ───────────────────────────────────────────────────
    case "level": {
      const target=ctx.getUser("user")||user;
      const lv=getLv(target.id), needed=xpForLevel(lv.level);
      const prog=Math.min(20,Math.floor((lv.xp/needed)*20));
      return ctx.reply({embeds:[E.xp(`📊 Level — ${target.username}`).setThumbnail(target.displayAvatarURL())
        .addFields({name:"🏆 Level",value:`${lv.level}`,inline:true},{name:"✨ XP",value:`${lv.xp}/${needed}`,inline:true},{name:"💬 Messages",value:`${lv.totalMessages||0}`,inline:true},{name:"📈 Progress",value:`\`${"█".repeat(prog)}${"░".repeat(20-prog)}\` ${Math.floor((lv.xp/needed)*100)}%`}).setTimestamp()]});
    }

    case "rank": {
      const target=ctx.getUser("user")||user;
      const lv=getLv(target.id), eco=getEco(target.id), needed=xpForLevel(lv.level);
      const sorted=Object.entries(data.leveling).sort((a,b)=>b[1].level!==a[1].level?b[1].level-a[1].level:b[1].xp-a[1].xp);
      const rank=sorted.findIndex(([id])=>id===target.id)+1;
      const roblox=data.robloxVerified[target.id];
      return ctx.reply({embeds:[E.xp(`🏅 Rank — ${target.username}`).setThumbnail(target.displayAvatarURL())
        .addFields(
          {name:"🌍 Rank",value:rank>0?`#${rank}`:"Unranked",inline:true},
          {name:"🏆 Level",value:`${lv.level}`,inline:true},
          {name:"✨ XP",value:`${lv.xp}/${needed}`,inline:true},
          {name:"💰 Coins",value:`${eco.coins||0}`,inline:true},
          {name:"💬 Messages",value:`${lv.totalMessages||0}`,inline:true},
          {name:"⚠️ Warns",value:`${(data.warns[target.id]||[]).length}`,inline:true},
          ...(roblox?[{name:"🟣 Roblox",value:`[${roblox.robloxName}](https://www.roblox.com/users/${roblox.robloxId}/profile)`,inline:true}]:[]),
        ).setTimestamp()]});
    }

    case "leaderboard": {
      if (ctx.isSlash) await ctx.interaction.deferReply().catch(()=>{});
      const top=Object.entries(data.leveling).map(([id,d])=>({id,level:d.level||1,xp:d.xp||0})).sort((a,b)=>b.level!==a.level?b.level-a.level:b.xp-a.xp).slice(0,10);
      if (!top.length) return ctx.reply({embeds:[E.brand("📊 Leaderboard").setDescription("No data yet!")]});
      const medals=["🥇","🥈","🥉"];
      const lines=await Promise.all(top.map(async(e,i)=>{let tag=`<@${e.id}>`;try{const u=await client.users.fetch(e.id);tag=u.username;}catch{}return `${medals[i]||`**${i+1}.**`} ${tag} — Lv **${e.level}** (${e.xp} XP)`;}));
      return ctx.reply({embeds:[E.gold("🏆 XP Leaderboard").setDescription(lines.join("\n")).setTimestamp()]});
    }

    case "balance": {
      const target=ctx.getUser("user")||user;
      const eco=getEco(target.id);
      return ctx.reply({embeds:[E.gold(`💰 Balance — ${target.username}`).setThumbnail(target.displayAvatarURL()).addFields({name:"💰 Coins",value:`${eco.coins||0} 🪙`,inline:true},{name:"🎒 Items",value:`${(eco.inventory||[]).length}`,inline:true}).setTimestamp()]});
    }

    case "dowork": {
      const eco=getEco(user.id);
      const job=WORK_RESPONSES[Math.floor(Math.random()*WORK_RESPONSES.length)];
      const earned=Math.floor(Math.random()*(job.coins[1]-job.coins[0]))+job.coins[0];
      eco.coins=(eco.coins||0)+earned; saveData();
      return ctx.reply({embeds:[E.success("💼 Work Complete!").setDescription(`> ${job.text}\n\n**+${earned} 🪙**`).addFields({name:"💰 Balance",value:`${eco.coins} 🪙`}).setTimestamp()]});
    }

    case "daily": {
      const uid=user.id, last=data.dailyClaims[uid]||0, elapsed=Date.now()-last;
      if (elapsed<86_400_000){const r=86_400_000-elapsed;return ctx.reply({embeds:[E.warn("⏰ Already Claimed").setDescription(`Come back in **${Math.floor(r/3_600_000)}h ${Math.floor((r%3_600_000)/60_000)}m**.`)]},true);}
      data.dailyClaims[uid]=Date.now();
      const reward=DAILY_REWARDS[Math.floor(Math.random()*DAILY_REWARDS.length)];
      getEco(uid).coins=(getEco(uid).coins||0)+reward.coins; saveData();
      return ctx.reply({embeds:[E.success("🎁 Daily Reward!").setDescription(`${reward.text}\n\n**+${reward.coins} 🪙**`).setTimestamp()]});
    }

    case "shop":
      return ctx.reply({embeds:[E.gold("🛒 Coin Shop").setDescription("Use `s!buy <id>` or `/buy <id>` to purchase.").addFields(SHOP_ITEMS.map(i=>({name:`${i.name} — ${i.price} 🪙`,value:`${i.desc}\n\`ID: ${i.id}\``}))).setTimestamp()]});

    case "buy": {
      const id=(ctx.getString("item",true)||ctx.getArg(0)||"").toLowerCase();
      const item=SHOP_ITEMS.find(i=>i.id===id);
      if (!item) return ctx.reply({embeds:[E.error("Item not found. Use `s!shop` to browse.")]},true);
      const eco=getEco(user.id);
      if ((eco.coins||0)<item.price) return ctx.reply({embeds:[E.error("Not Enough Coins").setDescription(`Need **${item.price} 🪙**, have **${eco.coins||0} 🪙**.`)]},true);
      if ((eco.inventory||[]).includes(id)) return ctx.reply({embeds:[E.warn("Already owned.")]},true);
      eco.coins-=item.price; if(!eco.inventory)eco.inventory=[]; eco.inventory.push(id); saveData();
      return ctx.reply({embeds:[E.success("✅ Purchased!").addFields({name:"Item",value:item.name},{name:"Redeem",value:item.desc}).setTimestamp()]});
    }

    // ── REVIEWS ──────────────────────────────────────────────────────────────
    case "review": {
      if (!guild) return ctx.reply({embeds:[E.error("Server only.")]},true);
      const rating=ctx.getInteger("rating")||parseInt(ctx.getArg(0),10);
      const type=ctx.getString("type")||ctx.getArg(1)||"General";
      const txt=ctx.getString("message")||ctx.getArgs().slice(2).join(" ");
      if (!rating||rating<1||rating>5) return ctx.reply({embeds:[E.warn("Rating must be 1–5.")]},true);
      if (!txt||txt.length<10) return ctx.reply({embeds:[E.error("Review must be at least 10 characters.")]},true);
      const ck=`review_guild:${user.id}:${guild.id}`,last=_cds.get(ck)||0;
      if (Date.now()-last<3_600_000&&last!==0) return ctx.reply({embeds:[E.warn("⏰ Review cooldown (1hr)")]},true);
      _cds.set(ck,Date.now());
      const rev={id:data.nextReviewId++,userId:user.id,username:user.tag,commissionType:type,rating,message:txt,at:new Date().toISOString()};
      data.reviews.push(rev); data.stats.reviewsSubmitted=(data.stats.reviewsSubmitted||0)+1; saveData();
      const stars="⭐".repeat(rating)+"☆".repeat(5-rating);
      const emb=new EmbedBuilder().setColor(BRAND_COLOR).setTitle("⭐ New Review").setThumbnail(user.displayAvatarURL())
        .addFields({name:"👤 From",value:user.tag,inline:true},{name:"🛠️ Commission",value:type,inline:true},{name:"📊 Rating",value:`${stars} (${rating}/5)`},{name:"💬 Review",value:txt}).setTimestamp();
      const s2=getSettings(guild.id);
      if (s2.reviewsChannelId){const ch=await guild.channels.fetch(s2.reviewsChannelId).catch(()=>null);if(ch?.isTextBased()){await ch.send({embeds:[emb]});return ctx.reply({embeds:[E.success("✅ Review Posted!").setDescription(`Posted in <#${s2.reviewsChannelId}>! 💗`)]});}}
      return ctx.reply({embeds:[emb]});
    }

    case "vouch": {
      if (!guild) return ctx.reply({embeds:[E.error("Server only.")]},true);
      const t=ctx.getString("text")||ctx.getArgs().join(" ");
      if (!t) return ctx.reply({embeds:[E.warn("Usage: `s!vouch <text>`")]},true);
      const emb=E.success("✅ Vouch").setDescription(`> ${t}`).setThumbnail(user.displayAvatarURL()).setFooter({text:`by ${user.tag}`}).setTimestamp();
      const s2=getSettings(guild.id);
      if (s2.reviewsChannelId){const ch=await guild.channels.fetch(s2.reviewsChannelId).catch(()=>null);if(ch?.isTextBased()){await ch.send({embeds:[emb]});return ctx.reply({embeds:[E.success("✅ Vouch Posted!")]});}}
      return ctx.reply({embeds:[emb]});
    }

    // ── FUN ──────────────────────────────────────────────────────────────────
    case "quote":
      return ctx.reply({embeds:[E.brand("💭 Quote").setDescription(`*${QUOTES[Math.floor(Math.random()*QUOTES.length)]}*`).setFooter({text:`${BOT_NAME} 🧸`})]});

    case "meme": {
      try {
        const r=await fetch("https://meme-api.com/gimme/wholesomememes");
        const m=await r.json();
        if (m.nsfw||m.spoiler) throw new Error();
        return ctx.reply({embeds:[E.brand(m.title||"Meme").setURL(m.postLink).setImage(m.url)]});
      } catch { return ctx.reply({embeds:[E.error("Meme unavailable — try again!")]}); }
    }

    case "8ball": {
      const q=ctx.getString("question")||ctx.getArgs().join(" ");
      if (!q) return ctx.reply({embeds:[E.warn("Usage: `s!8ball <question>`")]},true);
      return ctx.reply({embeds:[E.brand("🎱 Magic 8-Ball").addFields({name:"❓",value:q.slice(0,1000)},{name:"🎱",value:`**${EIGHT_BALL[Math.floor(Math.random()*EIGHT_BALL.length)]}**`})]});
    }

    case "rate": {
      const t=ctx.getString("thing")||ctx.getArgs().join(" ");
      if (!t) return ctx.reply({embeds:[E.warn("Usage: `s!rate <thing>`")]},true);
      const s2=Math.floor(Math.random()*11),e=s2>=8?"🔥":s2>=5?"😊":s2>=3?"😐":"💀";
      return ctx.reply({embeds:[E.brand("📊 Rating").setDescription(`${e} **${t}** — **${s2}/10**\n\`${"█".repeat(s2)}${"░".repeat(10-s2)}\``)]});
    }

    case "coinflip": {
      const r=Math.random()<.5?"Heads":"Tails";
      return ctx.reply({embeds:[E.brand("🪙 Coin Flip").setDescription(`**${r}!** ${r==="Heads"?"👑":"🌊"}`)]});
    }

    case "roll": {
      const max=ctx.getInteger("max")||parseInt(ctx.getArg(0)||"6",10)||6;
      return ctx.reply({embeds:[E.brand("🎲 Roll").setDescription(`You rolled **${Math.floor(Math.random()*max)+1}** (1–${max})`)]});
    }

    case "rps": {
      const pick=(ctx.getString("choice")||ctx.getArg(0)||"").toLowerCase();
      if (!["rock","paper","scissors"].includes(pick)) return ctx.reply({embeds:[E.warn("Choose: `rock`, `paper`, or `scissors`")]},true);
      const choices=["rock","paper","scissors"],emoji={rock:"🪨",paper:"📄",scissors:"✂️"};
      const bot2=choices[Math.floor(Math.random()*3)];
      const outcome=pick===bot2?"🤝 Tie!":((pick==="rock"&&bot2==="scissors")||(pick==="paper"&&bot2==="rock")||(pick==="scissors"&&bot2==="paper"))?"🎉 You win!":"🤖 I win!";
      return ctx.reply({embeds:[E.brand("🎮 Rock Paper Scissors").addFields({name:"You",value:`${emoji[pick]} ${pick}`,inline:true},{name:"Me",value:`${emoji[bot2]} ${bot2}`,inline:true},{name:"Result",value:outcome})]});
    }

    case "trivia": {
      if (!guild) return ctx.reply({embeds:[E.error("Server only.")]},true);
      if (data.triviaActive[ctx.channel.id]) return ctx.reply({embeds:[E.warn("Trivia already active in this channel!")]},true);
      const q=TRIVIA_QUESTIONS[Math.floor(Math.random()*TRIVIA_QUESTIONS.length)];
      const coins=50+Math.floor(Math.random()*50);
      data.triviaActive[ctx.channel.id]={q:q.q,answers:q.a,coins}; saveData();
      await ctx.reply({embeds:[E.info("🧠 Scripting Trivia!").setDescription(`**${q.q}**\n\n*Hint: ${q.hint}*`).addFields({name:"💰 Reward",value:`${coins} 🪙`}).setFooter({text:"Type your answer — 60 second timeout"})]});
      setTimeout(async()=>{
        if (data.triviaActive[ctx.channel.id]){delete data.triviaActive[ctx.channel.id];saveData();
          await ctx.channel.send({embeds:[E.warn("⏰ Trivia Expired").setDescription(`Answer was: **${q.a[0]}**`)]}).catch(()=>{});}
      },60_000);
      break;
    }

    case "remindme": {
      const timeStr=ctx.getString("time")||ctx.getArg(0);
      const text=ctx.getString("message")||ctx.getArgs().slice(1).join(" ");
      if (!timeStr||!text) return ctx.reply({embeds:[E.warn("Usage: `s!remindme 10m <message>` or `/remindme`")]},true);
      const ms=parseDuration(timeStr);
      if (!ms||ms>7*TIME.d) return ctx.reply({embeds:[E.error("Invalid duration (max 7d).")]},true);
      await ctx.reply({embeds:[E.success("⏰ Reminder Set!").setDescription(`Pinging you in **${fmtDuration(ms)}**\n> ${text}`)]});
      setTimeout(async()=>ctx.channel.send({content:`<@${user.id}>`,embeds:[E.brand("⏰ Reminder!").setDescription(`> ${text}`).setTimestamp()]}).catch(()=>{}),ms);
      break;
    }

    case "color": {
      const hex=(ctx.getString("hex")||ctx.getArg(0)||"").replace("#","").trim();
      if (!/^[0-9A-Fa-f]{6}$/.test(hex)) return ctx.reply({embeds:[E.warn("Invalid hex. Example: `FF8FB1`")]},true);
      const r=parseInt(hex.slice(0,2),16),g=parseInt(hex.slice(2,4),16),b=parseInt(hex.slice(4,6),16);
      return ctx.reply({embeds:[new EmbedBuilder().setColor(parseInt(hex,16)).setTitle(`🎨 #${hex.toUpperCase()}`).addFields({name:"HEX",value:`#${hex.toUpperCase()}`,inline:true},{name:"RGB",value:`${r},${g},${b}`,inline:true},{name:"INT",value:`${parseInt(hex,16)}`,inline:true}).setImage(`https://singlecolorimage.com/get/${hex}/200x80`).setTimestamp()]});
    }

    case "calc": {
      const expr=(ctx.getString("expression")||ctx.getArgs().join(" ")||"").replace(/[^0-9+\-*/.() %^]/g,"");
      if (!expr) return ctx.reply({embeds:[E.warn("Usage: `s!calc 2+2`")]},true);
      try {
        // eslint-disable-next-line no-new-func
        const result=Function('"use strict";return('+expr+')')();
        if (!isFinite(result)) throw new Error("Not finite");
        return ctx.reply({embeds:[E.brand("🧮 Calculator").addFields({name:"Input",value:`\`${expr}\``,inline:true},{name:"Result",value:`\`${result}\``,inline:true})]});
      } catch { return ctx.reply({embeds:[E.error("Invalid expression.")]},true); }
    }

    // ── INFO ─────────────────────────────────────────────────────────────────
    case "userinfo": {
      if (!guild) return ctx.reply({embeds:[E.error("Server only.")]},true);
      const target=ctx.getUser("user")||user;
      let gm=null; try{gm=await guild.members.fetch(target.id);}catch{}
      const emb=E.brand(`👤 ${target.tag}`).setThumbnail(target.displayAvatarURL({size:256}))
        .addFields({name:"🆔 ID",value:target.id,inline:true},{name:"🤖 Bot",value:target.bot?"Yes":"No",inline:true},{name:"📅 Created",value:`<t:${Math.floor(target.createdTimestamp/1000)}:F>`});
      if (gm){
        if(gm.joinedTimestamp)emb.addFields({name:"📥 Joined",value:`<t:${Math.floor(gm.joinedTimestamp/1000)}:F>`});
        const roles=gm.roles.cache.filter(r=>r.id!==guild.id).sort((a,b)=>b.position-a.position).map(r=>`<@&${r.id}>`).slice(0,15);
        if(roles.length)emb.addFields({name:`🎭 Roles (${roles.length})`,value:roles.join(" ")});
        const lv2=getLv(target.id),eco=getEco(target.id);
        emb.addFields({name:"🏆 Level",value:`${lv2.level}`,inline:true},{name:"💰 Coins",value:`${eco.coins||0}`,inline:true},{name:"⚠️ Warns",value:`${(data.warns[target.id]||[]).length}`,inline:true});
      }
      const roblox=data.robloxVerified[target.id];
      if(roblox)emb.addFields({name:"🟣 Roblox",value:`[${roblox.robloxName}](https://www.roblox.com/users/${roblox.robloxId}/profile)`,inline:true});
      return ctx.reply({embeds:[emb.setTimestamp()]});
    }

    case "serverinfo": {
      if (!guild) return ctx.reply({embeds:[E.error("Server only.")]},true);
      const owner=await guild.fetchOwner().catch(()=>null);
      const ch2=guild.channels.cache;
      return ctx.reply({embeds:[E.brand(`🏠 ${guild.name}`).setThumbnail(guild.iconURL({size:256})||null)
        .addFields({name:"🆔 ID",value:guild.id,inline:true},{name:"👑 Owner",value:owner?.user.tag||"—",inline:true},{name:"📅 Created",value:`<t:${Math.floor(guild.createdTimestamp/1000)}:F>`},{name:"👥 Members",value:`${guild.memberCount}`,inline:true},{name:"🎭 Roles",value:`${guild.roles.cache.size}`,inline:true},{name:"😄 Emojis",value:`${guild.emojis.cache.size}`,inline:true},{name:"💬 Text",value:`${ch2.filter(c=>c.type===ChannelType.GuildText).size}`,inline:true},{name:"🔊 Voice",value:`${ch2.filter(c=>c.type===ChannelType.GuildVoice).size}`,inline:true})
        .setTimestamp()]});
    }

    case "avatar": {
      const target=ctx.getUser("user")||user;
      const url=target.displayAvatarURL({size:1024,extension:"png"});
      return ctx.reply({embeds:[E.brand(`🖼️ ${target.tag}`).setURL(url).setImage(url)]});
    }

    case "banner": {
      const target=ctx.getUser("user")||user;
      const u2=await client.users.fetch(target.id,{force:true}).catch(()=>null);
      if (!u2?.bannerURL()) return ctx.reply({embeds:[E.warn("No banner set.")]},true);
      const url=u2.bannerURL({size:1024});
      return ctx.reply({embeds:[E.brand(`🖼️ ${u2.username}'s Banner`).setURL(url).setImage(url)]});
    }

    case "servericon": {
      if (!guild?.iconURL()) return ctx.reply({embeds:[E.error("No server icon.")]},true);
      const url=guild.iconURL({size:1024,extension:"png"});
      return ctx.reply({embeds:[E.brand(`🖼️ ${guild.name}`).setURL(url).setImage(url)]});
    }

    case "stats": {
      const active=data.orders.filter(o=>o.status!=="completed"&&o.status!=="cancelled").length;
      const done=data.orders.filter(o=>o.status==="completed").length;
      const avg=data.reviews.length?(data.reviews.reduce((s2,r)=>s2+r.rating,0)/data.reviews.length).toFixed(2):"—";
      return ctx.reply({embeds:[E.brand("📈 Bot Statistics").addFields({name:"📦 Active Orders",value:`${active}`,inline:true},{name:"✅ Completed",value:`${done}`,inline:true},{name:"🎟️ Tickets Opened",value:`${data.stats.ticketsOpened||0}`,inline:true},{name:"⭐ Reviews",value:`${data.reviews.length} (avg ${avg}⭐)`,inline:true},{name:"🖼️ AI Images",value:`${data.stats.imagesGenerated||0}`,inline:true},{name:"🟣 Verified",value:`${Object.keys(data.robloxVerified).length}`,inline:true}).setTimestamp()]});
    }

    case "invites": {
      if (!guild) return ctx.reply({embeds:[E.error("Server only.")]},true);
      const target=ctx.getUser("user")||user;
      const inv=(data.invites[guild.id]||{})[target.id]||{invited:0,left:0};
      return ctx.reply({embeds:[E.info(`📨 Invites — ${target.username}`).addFields({name:"📬 Invited",value:`${inv.invited}`,inline:true},{name:"🚪 Left",value:`${inv.left}`,inline:true},{name:"✅ Net",value:`${inv.invited-inv.left}`,inline:true}).setTimestamp()]});
    }

    case "inviteleaderboard": {
      if (!guild) return ctx.reply({embeds:[E.error("Server only.")]},true);
      const inv=data.invites[guild.id]||{};
      const entries=Object.entries(inv).map(([id,d])=>({id,net:d.invited-d.left})).sort((a,b)=>b.net-a.net).slice(0,10);
      return ctx.reply({embeds:[E.gold("📨 Invite Leaderboard").setDescription(entries.length?entries.map((e,i)=>`**${i+1}.** <@${e.id}> — **${e.net}** net`).join("\n"):"No invite data.").setTimestamp()]});
    }

    // ── ROBLOX VERIFICATION ──────────────────────────────────────────────────
    case "verify": {
      const username=ctx.getString("username",true)||ctx.getArg(0);
      if (!username) return ctx.reply({embeds:[E.warn("Usage: `s!verify <robloxUsername>`")]},true);
      if (ctx.isSlash) await ctx.interaction.deferReply({flags:MessageFlags.Ephemeral}).catch(()=>{});
      const robloxUser=await fetchRobloxUser(username);
      if (!robloxUser) return ctx.reply({embeds:[E.error("Roblox User Not Found").setDescription(`Could not find **${username}**. Check the spelling.`)]});
      const code=generateVerifyCode();
      data.verificationCodes[user.id]={code,robloxName:robloxUser.name,robloxId:robloxUser.id,expiresAt:Date.now()+10*60_000};
      saveData();
      return ctx.reply({embeds:[new EmbedBuilder().setColor(INFO_COLOR).setTitle("🟣 Roblox Verification")
        .setDescription([
          `**Found:** ${robloxUser.name} (ID: \`${robloxUser.id}\`)`,
          "",
          "**Step 1:** Copy the verification code below",
          "**Step 2:** Go to your [Roblox Profile](https://www.roblox.com/my/account) → **About** tab",
          "**Step 3:** Paste the code anywhere in your **bio** and save",
          "**Step 4:** Run `/checkverify <code>` or `s!checkverify <code>`",
          "",
          "⏰ Code expires in **10 minutes**",
        ].join("\n"))
        .addFields({name:"🔑 Your Code",value:`\`\`\`${code}\`\`\``})
        .setFooter({text:"Add code to Roblox bio → checkverify"}).setTimestamp()]},true);
    }

    case "checkverify": {
      const code=ctx.getString("code",true)||ctx.getArg(0);
      if (!code) return ctx.reply({embeds:[E.warn("Usage: `s!checkverify <code>`")]},true);
      if (ctx.isSlash) await ctx.interaction.deferReply({flags:MessageFlags.Ephemeral}).catch(()=>{});
      const pending=data.verificationCodes[user.id];
      if (!pending) return ctx.reply({embeds:[E.error("No Pending Verification").setDescription("Run `/verify <username>` first.")]});
      if (Date.now()>pending.expiresAt){delete data.verificationCodes[user.id];saveData();return ctx.reply({embeds:[E.error("Code Expired").setDescription("Run `/verify` again.")]});}
      if (code.toUpperCase()!==pending.code) return ctx.reply({embeds:[E.error("Wrong Code").setDescription(`Your code is: \`${pending.code}\``)]});
      const desc=await fetchRobloxDescription(pending.robloxId);
      if (!desc.includes(pending.code)) return ctx.reply({embeds:[E.warn("Code Not Found In Bio").setDescription([
        `We checked **${pending.robloxName}**'s Roblox profile but couldn't find the code.`,
        ``,
        `Make sure \`${pending.code}\` is in your Roblox **About** section, save it, then try again.`,
      ].join("\n"))]});
      data.robloxVerified[user.id]={robloxId:pending.robloxId,robloxName:pending.robloxName,verifiedAt:new Date().toISOString(),discordTag:user.tag};
      delete data.verificationCodes[user.id]; saveData();
      if (guild){
        const gm=await guild.members.fetch(user.id).catch(()=>null);
        if (gm){
          await gm.setNickname(pending.robloxName,"Roblox verification").catch(()=>{});
          const s2=getSettings(guild.id);
          if (s2.verifyRoleId){const role=guild.roles.cache.get(s2.verifyRoleId);if(role)await gm.roles.add(role,"Roblox verified").catch(()=>{});}
        }
      }
      return ctx.reply({embeds:[E.success("✅ Roblox Verified!")
        .setDescription(`You are now verified as **[${pending.robloxName}](https://www.roblox.com/users/${pending.robloxId}/profile)**!`)
        .addFields({name:"🟣 Roblox",value:pending.robloxName,inline:true},{name:"🆔 ID",value:`${pending.robloxId}`,inline:true}).setTimestamp()]},true);
    }

    case "whois": {
      const target=ctx.getUser("user")||user;
      const roblox=data.robloxVerified[target.id];
      if (!roblox) return ctx.reply({embeds:[E.warn("Not Verified").setDescription(`<@${target.id}> has not linked a Roblox account. They can use \`/verify\`.`)]});
      return ctx.reply({embeds:[new EmbedBuilder().setColor(INFO_COLOR).setTitle(`🟣 Roblox — ${target.username}`).setThumbnail(target.displayAvatarURL())
        .addFields({name:"🟣 Roblox Username",value:`[${roblox.robloxName}](https://www.roblox.com/users/${roblox.robloxId}/profile)`,inline:true},{name:"🆔 Roblox ID",value:`${roblox.robloxId}`,inline:true},{name:"✅ Verified",value:`<t:${Math.floor(new Date(roblox.verifiedAt).getTime()/1000)}:R>`,inline:true}).setTimestamp()]});
    }

    case "unverify": {
      if (!data.robloxVerified[user.id]) return ctx.reply({embeds:[E.warn("You are not verified.")]},true);
      delete data.robloxVerified[user.id]; saveData();
      return ctx.reply({embeds:[E.success("✅ Unverified").setDescription("Your Roblox account has been unlinked.")]});
    }

    // ── SCAM REPORTS ─────────────────────────────────────────────────────────
    case "reportscammer": {
      if (!guild) return ctx.reply({embeds:[E.error("Server only.")]},true);
      if (!isStaff(member)) return ctx.reply({embeds:[E.error("Staff only.")]},true);
      if (ctx.isSlash) await ctx.interaction.deferReply({flags:MessageFlags.Ephemeral}).catch(()=>{});
      const target=ctx.getUser("user")||ctx.getMentionUser(0);
      if (!target) return ctx.reply({embeds:[E.warn("Usage: `s!reportscammer @user <evidence> [amount] [roblox]`")]},true);
      const evidence=ctx.getString("evidence")||ctx.getArgs().slice(1).join(" ")||"No evidence provided";
      const amount=ctx.getString("amount")||"Unknown";
      const roblox=ctx.getString("roblox")||"Unknown";
      const report={id:data.nextScamId++,userId:target.id,userTag:target.tag,robloxName:roblox,evidence,amount,reportedBy:user.id,reporterTag:user.tag,guildId:guild.id,at:new Date().toISOString()};
      data.scamReports.push(report); saveData();
      const emb=new EmbedBuilder().setColor(SCAM_COLOR).setTitle(`🚨 SCAMMER REPORT #${report.id}`).setThumbnail(target.displayAvatarURL())
        .setDescription("⚠️ **DO NOT** pay this person or engage with their offers.")
        .addFields({name:"👤 Discord",value:`${target.tag} (<@${target.id}>)`,inline:true},{name:"🆔 Discord ID",value:target.id,inline:true},{name:"🟣 Roblox",value:roblox,inline:true},{name:"💸 Amount",value:amount,inline:true},{name:"📋 Evidence",value:evidence},{name:"🔖 Reported By",value:user.tag,inline:true},{name:"📅 Date",value:`<t:${Math.floor(Date.now()/1000)}:F>`,inline:true})
        .setFooter({text:`${BOT_NAME} • Report #${report.id}`}).setTimestamp();
      const s2=getSettings(guild.id);
      if (s2.scamChannelId){const ch=await guild.channels.fetch(s2.scamChannelId).catch(()=>null);if(ch?.isTextBased()){await ch.send({embeds:[emb]});return ctx.reply({embeds:[E.success(`✅ Report #${report.id} posted in <#${s2.scamChannelId}>`)]});}}
      await ctx.reply({content:"⚠️ No scam channel set (`/setscamchannel`). Posting here:"});
      await ctx.channel.send({embeds:[emb]});
      break;
    }

    case "scammerlist": {
      if (!data.scamReports.length) return ctx.reply({embeds:[E.success("✅ No Reports").setDescription("No scammers have been reported.")]});
      const recent=data.scamReports.slice(-10).reverse();
      return ctx.reply({embeds:[new EmbedBuilder().setColor(SCAM_COLOR).setTitle("🚨 Recent Scam Reports").setDescription(recent.map(r=>`**#${r.id}** — ${r.userTag} | Roblox: ${r.robloxName} | ${r.amount}`).join("\n")).setFooter({text:`Total reports: ${data.scamReports.length}`}).setTimestamp()]});
    }

    case "setscamchannel": {
      if (!isAdmin(member)) return ctx.reply({embeds:[E.error("Admin only.")]},true);
      const ch=ctx.getChannel("channel")||ctx.getMentionChannel(0);
      if (!ch) return ctx.reply({embeds:[E.warn("Usage: `s!setscamchannel #channel`")]},true);
      getSettings(guild.id).scamChannelId=ch.id; saveData();
      return ctx.reply({embeds:[E.success("✅ Scam Channel Set").setDescription(`Reports → <#${ch.id}>`)]});
    }

    // ── REACTION ROLES ────────────────────────────────────────────────────────
    case "reactionrole": {
      if (!guild) return ctx.reply({embeds:[E.error("Server only.")]},true);
      if (!isAdmin(member)&&!hasPerm(member,PermissionFlagsBits.ManageRoles)) return ctx.reply({embeds:[E.error("You need Manage Roles permission.")]},true);
      const sub=ctx.getSubcommand()||ctx.getArg(0)||"";

      if (sub==="add") {
        const msgId=ctx.getString("messageid")||ctx.getArg(1);
        const emoji=ctx.getString("emoji")||ctx.getArg(2);
        const role=ctx.getRole("role")||ctx.getMentionRole(3);
        if (!msgId||!emoji||!role) return ctx.reply({embeds:[E.warn("Usage: `s!reactionrole add <msgId> <emoji> <@role>`")]},true);
        let targetMsg=null;
        for (const ch2 of guild.channels.cache.filter(c=>c.isTextBased()).values()){try{targetMsg=await ch2.messages.fetch(msgId);if(targetMsg)break;}catch{}}
        if (!targetMsg) return ctx.reply({embeds:[E.error("Message not found. Make sure the bot can see the channel.")]},true);
        if (!data.reactionRoles[guild.id]) data.reactionRoles[guild.id]={};
        if (!data.reactionRoles[guild.id][msgId]) data.reactionRoles[guild.id][msgId]={};
        data.reactionRoles[guild.id][msgId][emoji]=role.id; saveData();
        await targetMsg.react(emoji).catch(()=>{});
        return ctx.reply({embeds:[E.success("✅ Reaction Role Added").addFields({name:"Message",value:`[Jump](${targetMsg.url})`,inline:true},{name:"Emoji",value:emoji,inline:true},{name:"Role",value:`<@&${role.id}>`,inline:true})]});
      }
      if (sub==="remove") {
        const msgId=ctx.getString("messageid")||ctx.getArg(1);
        const emoji=ctx.getString("emoji")||ctx.getArg(2);
        if (!msgId||!emoji) return ctx.reply({embeds:[E.warn("Usage: `s!reactionrole remove <msgId> <emoji>`")]},true);
        if (data.reactionRoles[guild.id]?.[msgId]?.[emoji]){
          delete data.reactionRoles[guild.id][msgId][emoji];
          if (!Object.keys(data.reactionRoles[guild.id][msgId]).length) delete data.reactionRoles[guild.id][msgId];
          saveData(); return ctx.reply({embeds:[E.success("✅ Reaction Role Removed")]});
        }
        return ctx.reply({embeds:[E.error("Reaction role not found.")]},true);
      }
      if (sub==="list") {
        const gRR=data.reactionRoles[guild.id];
        if (!gRR||!Object.keys(gRR).length) return ctx.reply({embeds:[E.info("No reaction roles configured.")]});
        const lines=[];
        for (const [msgId,emojis] of Object.entries(gRR)){lines.push(`**Message:** \`${msgId}\``);for(const [e,rId]of Object.entries(emojis))lines.push(`  ${e} → <@&${rId}>`);}
        return ctx.reply({embeds:[E.info("🎭 Reaction Roles").setDescription(lines.join("\n")).setTimestamp()]});
      }
      if (sub==="panel") {
        const title=ctx.getString("title")||ctx.getArgs().slice(1,2).join(" ");
        const desc=ctx.getString("description")||ctx.getArgs().slice(2).join(" ");
        if (!title||!desc) return ctx.reply({embeds:[E.warn("Usage: `s!reactionrole panel <title> <description>`")]},true);
        if (ctx.isSlash) await ctx.interaction.deferReply({flags:MessageFlags.Ephemeral}).catch(()=>{});
        const sent=await ctx.channel.send({embeds:[new EmbedBuilder().setColor(BRAND_COLOR).setTitle(title).setDescription(desc+"\n\n*React below to get a role!*").setFooter({text:`${BOT_NAME} • Reaction Roles`}).setTimestamp()]});
        return ctx.reply({content:`✅ Panel posted! Run \`s!reactionrole add ${sent.id} <emoji> <@role>\``, ...(ctx.isSlash?{flags:MessageFlags.Ephemeral}:{})});
      }
      return ctx.reply({embeds:[E.warn("Subcommands: `add` `remove` `list` `panel`")]},true);
    }

    // ── ANTI-RAID ─────────────────────────────────────────────────────────────
    case "antiraid": {
      if (!guild) return ctx.reply({embeds:[E.error("Server only.")]},true);
      if (!isAdmin(member)) return ctx.reply({embeds:[E.error("Admin only.")]},true);
      const sub=ctx.getSubcommand()||ctx.getArg(0)||"";
      const s=getAntiRaid(guild.id);

      if (sub==="enable")  { s.enabled=true;saveData();return ctx.reply({embeds:[E.success("🛡️ Anti-Raid Enabled").setDescription(`Triggers on **${s.threshold}** joins in **${s.window/1000}s**. Action: **${s.action}**`)]}); }
      if (sub==="disable") { s.enabled=false;saveData();return ctx.reply({embeds:[E.warn("🛡️ Anti-Raid Disabled")]}); }
      if (sub==="status") {
        return ctx.reply({embeds:[new EmbedBuilder().setColor(s.enabled?SUCCESS_COLOR:WARN_COLOR).setTitle(`🛡️ Anti-Raid — ${s.enabled?"🟢 Active":"🔴 Disabled"}`)
          .addFields({name:"Threshold",value:`${s.threshold} joins`,inline:true},{name:"Window",value:`${s.window/1000}s`,inline:true},{name:"Action",value:s.action,inline:true},{name:"Auto-unlock",value:s.autoUnlock?`${s.autoUnlock/1000}s`:"Manual",inline:true},{name:"DM on action",value:s.dmOnAction?"Yes":"No",inline:true},{name:"Whitelisted",value:`${s.whitelistedUsers?.length||0} users`,inline:true}).setTimestamp()]});
      }
      if (sub==="config") {
        const threshold=ctx.getInteger("threshold")||parseInt(ctx.getArg(1)||"",10)||null;
        const window=ctx.getInteger("window")||parseInt(ctx.getArg(2)||"",10)||null;
        const action=ctx.getString("action")||ctx.getArg(3)||null;
        const autounlock=ctx.getInteger("autounlock")||parseInt(ctx.getArg(4)||"",10)||null;
        if (threshold!=null)  s.threshold=threshold;
        if (window!=null)     s.window=window*1000;
        if (action!=null)     s.action=action;
        if (autounlock!=null) s.autoUnlock=autounlock*1000;
        saveData();
        return ctx.reply({embeds:[E.success("🛡️ Anti-Raid Updated").addFields({name:"Threshold",value:`${s.threshold} joins`,inline:true},{name:"Window",value:`${s.window/1000}s`,inline:true},{name:"Action",value:s.action,inline:true},{name:"Auto-unlock",value:s.autoUnlock?`${s.autoUnlock/1000}s`:"Manual",inline:true}).setTimestamp()]});
      }
      if (sub==="whitelist") {
        const target=ctx.getUser("user")||ctx.getMentionUser(1);
        if (!target) return ctx.reply({embeds:[E.warn("Usage: `s!antiraid whitelist @user`")]},true);
        if (!s.whitelistedUsers) s.whitelistedUsers=[];
        if (!s.whitelistedUsers.includes(target.id)) s.whitelistedUsers.push(target.id);
        saveData();
        return ctx.reply({embeds:[E.success("✅ Whitelisted").setDescription(`<@${target.id}> is now exempt from anti-raid.`)]});
      }
      if (sub==="unwhitelist") {
        const target=ctx.getUser("user")||ctx.getMentionUser(1);
        if (!target) return ctx.reply({embeds:[E.warn("Usage: `s!antiraid unwhitelist @user`")]},true);
        s.whitelistedUsers=(s.whitelistedUsers||[]).filter(id=>id!==target.id);
        saveData();
        return ctx.reply({embeds:[E.success("✅ Removed from whitelist")]});
      }
      return ctx.reply({embeds:[E.warn("Subcommands: `enable` `disable` `status` `config` `whitelist` `unwhitelist`")]},true);
    }

    // ── ANTI-NUKE ─────────────────────────────────────────────────────────────
    case "antinuke": {
      if (!guild) return ctx.reply({embeds:[E.error("Server only.")]},true);
      if (!isAdmin(member)) return ctx.reply({embeds:[E.error("Admin only.")]},true);
      const sub=ctx.getSubcommand()||ctx.getArg(0)||"";
      const s=getAntiNuke(guild.id);

      if (sub==="enable")  { s.enabled=true;saveData();return ctx.reply({embeds:[E.success("☢️ Anti-Nuke Enabled").setDescription(`Watching for mass actions. Action: **${s.action}**`)]}); }
      if (sub==="disable") { s.enabled=false;saveData();return ctx.reply({embeds:[E.warn("☢️ Anti-Nuke Disabled")]}); }
      if (sub==="status") {
        return ctx.reply({embeds:[new EmbedBuilder().setColor(s.enabled?SUCCESS_COLOR:WARN_COLOR).setTitle(`☢️ Anti-Nuke — ${s.enabled?"🟢 Active":"🔴 Disabled"}`)
          .addFields({name:"Ban Threshold",value:`${s.banThreshold}`,inline:true},{name:"Channel Del",value:`${s.channelDeleteThreshold}`,inline:true},{name:"Role Del",value:`${s.roleDeleteThreshold}`,inline:true},{name:"Kick Threshold",value:`${s.kickThreshold}`,inline:true},{name:"Window",value:`${s.window/1000}s`,inline:true},{name:"Action",value:s.action,inline:true},{name:"Trusted Users",value:`${s.trustedUsers?.length||0}`,inline:true},{name:"Trusted Roles",value:`${s.trustedRoles?.length||0}`,inline:true}).setTimestamp()]});
      }
      if (sub==="config") {
        const banth=ctx.getInteger("banth")||parseInt(ctx.getArg(1)||"",10)||null;
        const channelth=ctx.getInteger("channelth")||parseInt(ctx.getArg(2)||"",10)||null;
        const roleth=ctx.getInteger("roleth")||parseInt(ctx.getArg(3)||"",10)||null;
        const kickth=ctx.getInteger("kickth")||parseInt(ctx.getArg(4)||"",10)||null;
        const action=ctx.getString("action")||ctx.getArg(5)||null;
        if (banth!=null)     s.banThreshold=banth;
        if (channelth!=null) s.channelDeleteThreshold=channelth;
        if (roleth!=null)    s.roleDeleteThreshold=roleth;
        if (kickth!=null)    s.kickThreshold=kickth;
        if (action!=null)    s.action=action;
        saveData();
        return ctx.reply({embeds:[E.success("☢️ Anti-Nuke Updated").addFields({name:"Ban Threshold",value:`${s.banThreshold}`,inline:true},{name:"Channel Del",value:`${s.channelDeleteThreshold}`,inline:true},{name:"Role Del",value:`${s.roleDeleteThreshold}`,inline:true},{name:"Kick Threshold",value:`${s.kickThreshold}`,inline:true},{name:"Action",value:s.action,inline:true}).setTimestamp()]});
      }
      if (sub==="trust") {
        const target=ctx.getUser("user")||ctx.getMentionUser(1);
        if (!target) return ctx.reply({embeds:[E.warn("Usage: `s!antinuke trust @user`")]},true);
        if (!s.trustedUsers) s.trustedUsers=[];
        if (!s.trustedUsers.includes(target.id)) s.trustedUsers.push(target.id);
        saveData();
        return ctx.reply({embeds:[E.success("✅ Trusted").setDescription(`<@${target.id}> is now trusted and exempt from anti-nuke.`)]});
      }
      if (sub==="untrust") {
        const target=ctx.getUser("user")||ctx.getMentionUser(1);
        if (!target) return ctx.reply({embeds:[E.warn("Usage: `s!antinuke untrust @user`")]},true);
        s.trustedUsers=(s.trustedUsers||[]).filter(id=>id!==target.id);
        saveData();
        return ctx.reply({embeds:[E.success("✅ Trust removed")]});
      }
      return ctx.reply({embeds:[E.warn("Subcommands: `enable` `disable` `status` `config` `trust` `untrust`")]},true);
    }

    // ── MODERATION ────────────────────────────────────────────────────────────
    case "ban": {
      if (!hasPerm(member,PermissionFlagsBits.BanMembers)) return ctx.reply({embeds:[E.error("You need Ban Members permission.")]},true);
      const target=ctx.getUser("user")||ctx.getMentionUser(0);
      if (!target) return ctx.reply({embeds:[E.warn("Usage: `s!ban @user [reason]`")]},true);
      const reason=ctx.getString("reason")||ctx.getArgs().slice(ctx.isSlash?0:1).join(" ")||"No reason provided";
      try{await guild.bans.create(target.id,{reason:`By ${user.tag}: ${reason}`});}
      catch{return ctx.reply({embeds:[E.error("Ban failed. Check bot permissions.")]},true);}
      const emb=E.error("🔨 Banned").addFields({name:"User",value:`<@${target.id}>`,inline:true},{name:"Reason",value:reason},{name:"By",value:user.tag}).setTimestamp();
      await ctx.reply({embeds:[emb]}); await logMod(guild,emb); break;
    }

    case "kick": {
      if (!hasPerm(member,PermissionFlagsBits.KickMembers)) return ctx.reply({embeds:[E.error("You need Kick Members permission.")]},true);
      const target=ctx.getUser("user")||ctx.getMentionUser(0);
      if (!target) return ctx.reply({embeds:[E.warn("Usage: `s!kick @user [reason]`")]},true);
      const reason=ctx.getString("reason")||ctx.getArgs().slice(1).join(" ")||"No reason provided";
      const m2=await guild.members.fetch(target.id).catch(()=>null);
      if (!m2?.kickable) return ctx.reply({embeds:[E.error("Can't kick this user.")]},true);
      await m2.kick(reason);
      const emb=E.warn("👢 Kicked").addFields({name:"User",value:`<@${target.id}>`,inline:true},{name:"Reason",value:reason},{name:"By",value:user.tag}).setTimestamp();
      await ctx.reply({embeds:[emb]}); await logMod(guild,emb); break;
    }

    case "mute": {
      if (!hasPerm(member,PermissionFlagsBits.ModerateMembers)) return ctx.reply({embeds:[E.error("You need Moderate Members permission.")]},true);
      const target=ctx.getUser("user")||ctx.getMentionUser(0);
      const durStr=ctx.getString("duration")||ctx.getArg(1)||"";
      const reason=ctx.getString("reason")||ctx.getArgs().slice(2).join(" ")||"No reason provided";
      if (!target||!durStr) return ctx.reply({embeds:[E.warn("Usage: `s!mute @user <duration> [reason]`")]},true);
      const ms=parseDuration(durStr);
      if (!ms||ms>28*TIME.d) return ctx.reply({embeds:[E.error("Invalid duration (max 28d).")]},true);
      const m2=await guild.members.fetch(target.id).catch(()=>null);
      if (!m2?.moderatable) return ctx.reply({embeds:[E.error("Can't mute this user.")]},true);
      await m2.timeout(ms,reason);
      const emb=E.warn("🔇 Muted").addFields({name:"User",value:`<@${target.id}>`,inline:true},{name:"Duration",value:fmtDuration(ms),inline:true},{name:"Reason",value:reason},{name:"By",value:user.tag}).setTimestamp();
      await ctx.reply({embeds:[emb]}); await logMod(guild,emb); break;
    }

    case "warn": {
      if (!hasPerm(member,PermissionFlagsBits.ModerateMembers)) return ctx.reply({embeds:[E.error("You need Moderate Members permission.")]},true);
      const target=ctx.getUser("user")||ctx.getMentionUser(0);
      const reason=ctx.getString("reason")||ctx.getArgs().slice(1).join(" ")||"";
      if (!target||!reason) return ctx.reply({embeds:[E.warn("Usage: `s!warn @user <reason>`")]},true);
      const w={id:data.nextWarnId++,reason,modId:user.id,at:new Date().toISOString()};
      if (!data.warns[target.id]) data.warns[target.id]=[];
      data.warns[target.id].push(w); saveData();
      const emb=E.warn("⚠️ Warned").addFields({name:"User",value:`<@${target.id}>`,inline:true},{name:"Warn #",value:`${w.id}`,inline:true},{name:"Total",value:`${data.warns[target.id].length}`,inline:true},{name:"Reason",value:reason},{name:"By",value:user.tag}).setTimestamp();
      await ctx.reply({embeds:[emb]}); await logMod(guild,emb);
      try{const u2=await client.users.fetch(target.id);await u2.send({embeds:[E.warn(`⚠️ Warned in ${guild.name}`).addFields({name:"Reason",value:reason}).setTimestamp()]});}catch{}
      break;
    }

    case "warns": {
      if (!hasPerm(member,PermissionFlagsBits.ModerateMembers)) return ctx.reply({embeds:[E.error("You need Moderate Members permission.")]},true);
      const target=ctx.getUser("user")||ctx.getMentionUser(0);
      if (!target) return ctx.reply({embeds:[E.warn("Usage: `s!warns @user`")]},true);
      const list=data.warns[target.id]||[];
      const emb=new EmbedBuilder().setTitle(`⚠️ Warnings (${list.length})`).setColor(list.length?WARN_COLOR:SUCCESS_COLOR).setDescription(`<@${target.id}>`);
      if (!list.length) emb.addFields({name:"✅ Clean",value:"No warnings."});
      else list.slice(-10).forEach(w=>emb.addFields({name:`#${w.id}`,value:`**Reason:** ${w.reason||"—"}`,inline:true}));
      return ctx.reply({embeds:[emb]});
    }

    case "unwarn": {
      if (!hasPerm(member,PermissionFlagsBits.ModerateMembers)) return ctx.reply({embeds:[E.error("You need Moderate Members permission.")]},true);
      const id=ctx.getInteger("id")||parseInt(ctx.getArg(0),10);
      if (!id) return ctx.reply({embeds:[E.warn("Usage: `s!unwarn <warn_id>`")]},true);
      let found=false;
      for (const [uid,list] of Object.entries(data.warns)){
        const i=list.findIndex(w=>w.id===id);
        if (i!==-1){list.splice(i,1);if(!list.length)delete data.warns[uid];saveData();await ctx.reply({embeds:[E.success("✅ Warning Removed").addFields({name:"ID",value:`#${id}`,inline:true},{name:"User",value:`<@${uid}>`,inline:true}).setTimestamp()]});found=true;break;}
      }
      if (!found) return ctx.reply({embeds:[E.error("Warning not found.")]},true);
      break;
    }

    case "purge": {
      if (!hasPerm(member,PermissionFlagsBits.ManageMessages)) return ctx.reply({embeds:[E.error("You need Manage Messages permission.")]},true);
      const count=ctx.getInteger("count")||parseInt(ctx.getArg(0),10)||0;
      if (count<1||count>100) return ctx.reply({embeds:[E.warn("Count must be 1–100.")]},true);
      if (ctx.isSlash) await ctx.interaction.deferReply({ephemeral:true}).catch(()=>{});
      try {
        const d=await ctx.channel.bulkDelete(count,true);
        return ctx.reply({content:`✅ Deleted ${d.size} messages.`});
      } catch { return ctx.reply({embeds:[E.error("Purge failed — messages may be older than 14 days.")]}); }
    }

    case "lock": {
      if (!hasPerm(member,PermissionFlagsBits.ManageChannels)) return ctx.reply({embeds:[E.error("You need Manage Channels permission.")]},true);
      await ctx.channel.permissionOverwrites.edit(guild.roles.everyone,{SendMessages:false});
      return ctx.reply({embeds:[E.error("🔒 Channel Locked")]});
    }

    case "unlock": {
      if (!hasPerm(member,PermissionFlagsBits.ManageChannels)) return ctx.reply({embeds:[E.error("You need Manage Channels permission.")]},true);
      await ctx.channel.permissionOverwrites.edit(guild.roles.everyone,{SendMessages:null});
      return ctx.reply({embeds:[E.success("🔓 Channel Unlocked")]});
    }

    case "slowmode": {
      if (!hasPerm(member,PermissionFlagsBits.ManageChannels)) return ctx.reply({embeds:[E.error("You need Manage Channels permission.")]},true);
      const secs=ctx.getInteger("seconds")||parseInt(ctx.getArg(0)||"0",10)||0;
      await ctx.channel.setRateLimitPerUser(secs);
      return ctx.reply({embeds:[E.success("🐢 Slowmode Updated").setDescription(secs===0?"Disabled.":`Set to **${secs}s**`)]});
    }

    case "nick": {
      if (!hasPerm(member,PermissionFlagsBits.ManageNicknames)) return ctx.reply({embeds:[E.error("You need Manage Nicknames permission.")]},true);
      const target=ctx.getUser("user")||ctx.getMentionUser(0);
      if (!target) return ctx.reply({embeds:[E.warn("Usage: `s!nick @user [new name]`")]},true);
      const nick=ctx.getString("name")||ctx.getArgs().slice(1).join(" ")||null;
      const m2=await guild.members.fetch(target.id).catch(()=>null);
      if (!m2?.manageable) return ctx.reply({embeds:[E.error("Can't edit this member.")]},true);
      await m2.setNickname(nick);
      return ctx.reply({embeds:[E.success("✅ Nickname updated.").addFields({name:"User",value:`<@${target.id}>`,inline:true},{name:"Nick",value:nick||"(cleared)",inline:true})]});
    }

    // ── ADMIN ─────────────────────────────────────────────────────────────────
    case "announce": {
      if (!isAdmin(member)&&!hasPerm(member,PermissionFlagsBits.ManageGuild)) return ctx.reply({embeds:[E.error("You need Manage Guild permission.")]},true);
      const text=ctx.getString("message")||ctx.getArgs().join(" ");
      if (!text) return ctx.reply({embeds:[E.warn("Usage: `s!announce <message>`")]},true);
      const channel=ctx.getChannel("channel")||ctx.getMentionChannel(0)||ctx.channel;
      if (ctx.isSlash) await ctx.interaction.reply({content:"✅ Announcement sent!",flags:MessageFlags.Ephemeral}).catch(()=>{});
      await channel.send({content:"@everyone",embeds:[new EmbedBuilder().setColor(BRAND_COLOR).setAuthor({name:`${BOT_NAME} — Announcement`,iconURL:client.user?.displayAvatarURL()}).setDescription(`╔══════════════════════════════════╗\n\u200b\n${text}\n\u200b\n╚══════════════════════════════════╝`).setFooter({text:`Posted by ${user.tag}`,iconURL:user.displayAvatarURL()}).setTimestamp()]});
      if (!ctx.isSlash) await ctx.reply({content:"✅ Announcement sent!"});
      break;
    }

    case "say": {
      if (!isAdmin(member)&&!hasPerm(member,PermissionFlagsBits.ManageMessages)) return ctx.reply({embeds:[E.error("You need Manage Messages permission.")]},true);
      const text=ctx.getString("message")||ctx.getArgs().join(" ");
      if (!text) return ctx.reply({embeds:[E.warn("Usage: `s!say <message>`")]},true);
      if (ctx.isSlash) await ctx.interaction.reply({content:"✅",flags:MessageFlags.Ephemeral}).catch(()=>{});
      await ctx.channel.send({content:text,allowedMentions:{users:[]}});
      if (!ctx.isSlash) await ctx.channel.send({content:"✅"}).then(m=>setTimeout(()=>m.delete().catch(()=>{}),2000));
      break;
    }

    case "embed": {
      if (!isAdmin(member)&&!hasPerm(member,PermissionFlagsBits.ManageMessages)) return ctx.reply({embeds:[E.error("You need Manage Messages permission.")]},true);
      const title=ctx.getString("title")||ctx.getArgs().slice(0,1).join(" ");
      const body=ctx.getString("body")||ctx.getArgs().slice(1).join(" ");
      if (!title||!body) return ctx.reply({embeds:[E.warn("Usage: `s!embed <title> | <body>`")]},true);
      if (ctx.isSlash) await ctx.interaction.reply({content:"✅",flags:MessageFlags.Ephemeral}).catch(()=>{});
      await ctx.channel.send({embeds:[new EmbedBuilder().setColor(BRAND_COLOR).setTitle(title).setDescription(body).setTimestamp()]});
      break;
    }

    case "poll": {
      if (!isAdmin(member)&&!hasPerm(member,PermissionFlagsBits.ManageMessages)) return ctx.reply({embeds:[E.error("You need Manage Messages permission.")]},true);
      const q=ctx.getString("question")||ctx.getArgs()[0];
      const optsRaw=ctx.getString("options")||(ctx.getArgs().slice(1).join(" "));
      if (!q||!optsRaw) return ctx.reply({embeds:[E.warn("Usage: `s!poll <question> | <opt1> | <opt2>`")]},true);
      const opts=optsRaw.split("|").map(s2=>s2.trim()).filter(Boolean).slice(0,9);
      if (opts.length<2) return ctx.reply({embeds:[E.warn("Need at least 2 options separated by `|`")]},true);
      const nums=["1️⃣","2️⃣","3️⃣","4️⃣","5️⃣","6️⃣","7️⃣","8️⃣","9️⃣"];
      if (ctx.isSlash) await ctx.interaction.reply({content:"✅",flags:MessageFlags.Ephemeral}).catch(()=>{});
      const sent=await ctx.channel.send({embeds:[new EmbedBuilder().setColor(INFO_COLOR).setTitle(`📊 ${q}`).setDescription(opts.map((o,i)=>`${nums[i]} ${o}`).join("\n\n")).setFooter({text:"React to vote!"}).setTimestamp()]});
      for (let i=0;i<opts.length;i++) await sent.react(nums[i]).catch(()=>{});
      break;
    }

    case "giveaway": {
      if (!isAdmin(member)&&!hasPerm(member,PermissionFlagsBits.ManageGuild)) return ctx.reply({embeds:[E.error("You need Manage Guild permission.")]},true);
      const durStr=ctx.getString("duration")||ctx.getArg(0);
      const prize=ctx.getString("prize")||ctx.getArgs().slice(1).join(" ");
      if (!durStr||!prize) return ctx.reply({embeds:[E.warn("Usage: `s!giveaway <duration> <prize>`")]},true);
      const ms=parseDuration(durStr);
      if (!ms) return ctx.reply({embeds:[E.error("Invalid duration.")]},true);
      const endAt=Date.now()+ms;
      const sent=await ctx.channel.send({content:"@here",embeds:[new EmbedBuilder().setColor(GOLD_COLOR).setTitle("🎉 GIVEAWAY!").setDescription(`React 🎉 to enter!\n\n**Prize:** ${prize}`).addFields({name:"⏰ Ends",value:`<t:${Math.floor(endAt/1000)}:R>`,inline:true},{name:"🎁 Prize",value:prize,inline:true},{name:"🏠 Host",value:`<@${user.id}>`,inline:true}).setFooter({text:"React 🎉 to enter!"}).setTimestamp()],allowedMentions:{users:[]}});
      await sent.react("🎉").catch(()=>{});
      data.giveaways[sent.id]={prize,endAt,channelId:ctx.channel.id,guildId:guild.id,hostId:user.id,ended:false}; saveData();
      return ctx.reply({content:"✅ Giveaway started!",...(ctx.isSlash?{flags:MessageFlags.Ephemeral}:{})});
    }

    case "addorder": {
      if (!isAdmin(member)) return ctx.reply({embeds:[E.error("Admin only.")]},true);
      const target=ctx.getUser("user")||ctx.getMentionUser(0);
      const details=ctx.getString("details")||ctx.getArgs().slice(1).join(" ");
      if (!target||!details) return ctx.reply({embeds:[E.warn("Usage: `s!addorder @user <details>`")]},true);
      const now2=new Date().toISOString();
      const o={id:data.nextOrderId++,userId:target.id,details,status:"not_started",createdAt:now2,updatedAt:now2,createdBy:user.id,note:null};
      data.orders.push(o); data.stats.ordersCreated=(data.stats.ordersCreated||0)+1; saveData(); updateOrderBoard().catch(()=>{});
      return ctx.reply({embeds:[E.success(`✅ Order #${o.id} Created`).addFields({name:"Customer",value:`<@${target.id}>`},{name:"Details",value:details}).setTimestamp()]});
    }

    case "updateorder": {
      if (!isAdmin(member)&&!hasPerm(member,PermissionFlagsBits.ManageMessages)) return ctx.reply({embeds:[E.error("No permission.")]},true);
      const id=ctx.getInteger("id")||parseInt(ctx.getArg(0),10);
      const status=ctx.getString("status")||ctx.getArg(1);
      const note=ctx.getString("note")||null;
      if (!id||!status) return ctx.reply({embeds:[E.warn("Usage: `s!updateorder <id> <status> [note]`")]},true);
      const o=findOrder(id);
      if (!o) return ctx.reply({embeds:[E.error("Order not found.")]},true);
      if (!ORDER_STATUSES[status]) return ctx.reply({embeds:[E.warn(`Valid statuses: ${Object.keys(ORDER_STATUSES).join(", ")}`)]},true);
      const old=o.status; o.status=status; o.updatedAt=new Date().toISOString();
      if (note) o.note=note;
      if (status==="completed") data.stats.ordersCompleted=(data.stats.ordersCompleted||0)+1;
      saveData(); updateOrderBoard().catch(()=>{});
      const si=getOrderStatus(status);
      await ctx.reply({embeds:[new EmbedBuilder().setColor(si.color).setTitle(`✅ Order #${o.id} Updated`).addFields({name:"Old",value:getOrderStatus(old).label,inline:true},{name:"New",value:si.label,inline:true},{name:"Customer",value:`<@${o.userId}>`,inline:true}).setTimestamp()]});
      try{const u2=await client.users.fetch(o.userId);await u2.send({embeds:[new EmbedBuilder().setColor(si.color).setTitle(`📦 Order #${o.id} Updated`).setDescription(`Status → **${si.label}**${note?`\n\n**Note:** ${note}`:""}`).setTimestamp()]});}catch{}
      break;
    }

    case "complete": {
      if (!isAdmin(member)) return ctx.reply({embeds:[E.error("Admin only.")]},true);
      const id=ctx.getInteger("id")||parseInt(ctx.getArg(0),10);
      const o=findOrder(id);
      if (!o) return ctx.reply({embeds:[E.error("Order not found.")]},true);
      if (o.status==="completed") return ctx.reply({embeds:[E.warn("Already completed.")]},true);
      o.status="completed"; o.updatedAt=new Date().toISOString();
      data.stats.ordersCompleted=(data.stats.ordersCompleted||0)+1; saveData(); updateOrderBoard().catch(()=>{});
      return ctx.reply({embeds:[E.success(`✅ Order #${o.id} Completed`).addFields({name:"Customer",value:`<@${o.userId}>`}).setTimestamp()]});
    }

    case "blacklist": {
      if (!isAdmin(member)) return ctx.reply({embeds:[E.error("Admin only.")]},true);
      const target=ctx.getUser("user")||ctx.getMentionUser(0);
      if (!target) return ctx.reply({embeds:[E.warn("Usage: `s!blacklist @user`")]},true);
      const i=data.blacklist.indexOf(target.id);
      if (i===-1) data.blacklist.push(target.id); else data.blacklist.splice(i,1);
      saveData();
      return ctx.reply({embeds:[new EmbedBuilder().setColor(i===-1?ERROR_COLOR:SUCCESS_COLOR).setTitle("🚫 Blacklist").setDescription(`<@${target.id}> ${i===-1?"added to":"removed from"} blacklist.`).setTimestamp()]});
    }

    case "setlog": {
      if (!isAdmin(member)) return ctx.reply({embeds:[E.error("Admin only.")]},true);
      const ch=ctx.getChannel("channel")||ctx.getMentionChannel(0);
      if (!ch){delete data.modLogChannels[guild.id];saveData();return ctx.reply({embeds:[E.warn("Mod log disabled.")]});}
      data.modLogChannels[guild.id]=ch.id; saveData();
      return ctx.reply({embeds:[E.success("📓 Mod Log Set").setDescription(`Logging to <#${ch.id}>`)]});
    }

    case "setreviews": {
      if (!isAdmin(member)) return ctx.reply({embeds:[E.error("Admin only.")]},true);
      const ch=ctx.getChannel("channel")||ctx.getMentionChannel(0);
      getSettings(guild.id).reviewsChannelId=ch?.id||null; saveData();
      return ctx.reply({embeds:[E.success(`✅ Reviews ${ch?`→ <#${ch.id}>`:"cleared."}`)]});
    }

    case "settranscripts": {
      if (!isAdmin(member)) return ctx.reply({embeds:[E.error("Admin only.")]},true);
      const ch=ctx.getChannel("channel")||ctx.getMentionChannel(0);
      getSettings(guild.id).transcriptsChannelId=ch?.id||null; saveData();
      return ctx.reply({embeds:[E.success(`✅ Transcripts ${ch?`→ <#${ch.id}>`:"cleared."}`)]});
    }

    case "setverifyrole": {
      if (!isAdmin(member)) return ctx.reply({embeds:[E.error("Admin only.")]},true);
      const role=ctx.getRole("role")||ctx.getMentionRole(0);
      if (!role) return ctx.reply({embeds:[E.warn("Usage: `s!setverifyrole @role`")]},true);
      getSettings(guild.id).verifyRoleId=role.id; saveData();
      return ctx.reply({embeds:[E.success("✅ Verify Role Set").setDescription(`Users receive <@&${role.id}> on Roblox verification.`)]});
    }

    case "ticketpanel": {
      if (!isAdmin(member)&&!hasPerm(member,PermissionFlagsBits.ManageChannels)) return ctx.reply({embeds:[E.error("You need Manage Channels permission.")]},true);
      const s2=getSettings(guild.id);
      s2.ticketPanelChannelId=ctx.channel.id; saveData();
      const {embed,row}=buildTicketPanel();
      const sent=await ctx.channel.send({embeds:[embed],components:[row]});
      s2.ticketPanelMsgId=sent.id; saveData();
      return ctx.reply({content:"✅ Ticket panel posted!",...(ctx.isSlash?{flags:MessageFlags.Ephemeral}:{})});
    }

    case "close": {
      if (!ctx.channel?.name?.startsWith("ticket-")) return ctx.reply({embeds:[E.error("Only works inside ticket channels.")]},true);
      const reason=ctx.getString("reason")||ctx.getArgs().join(" ")||"No reason provided";
      if (ctx.isSlash) await ctx.interaction.reply({content:"🔒 Closing…",flags:MessageFlags.Ephemeral}).catch(()=>{});
      await closeTicket(ctx.channel,member||user,reason,guild);
      break;
    }

    case "addnote": {
      if (!ctx.channel?.name?.startsWith("ticket-")) return ctx.reply({embeds:[E.error("Ticket channels only.")]},true);
      if (!isStaff(member)) return ctx.reply({embeds:[E.error("Staff only.")]},true);
      const text=ctx.getString("text")||ctx.getArgs().join(" ");
      if (!text) return ctx.reply({embeds:[E.warn("Usage: `s!addnote <text>`")]},true);
      if (ctx.isSlash) await ctx.interaction.reply({content:"✅ Note added!",flags:MessageFlags.Ephemeral}).catch(()=>{});
      await ctx.channel.send({embeds:[new EmbedBuilder().setColor(NOTE_COLOR).setTitle("📝 Staff Note").setDescription(text).setFooter({text:`by ${user.tag}`}).setTimestamp()]});
      break;
    }

    case "givecoins": {
      if (!isAdmin(member)) return ctx.reply({embeds:[E.error("Admin only.")]},true);
      const target=ctx.getUser("user")||ctx.getMentionUser(0);
      const amt=ctx.getInteger("amount")||parseInt(ctx.getArg(1),10)||0;
      if (!target||amt<1) return ctx.reply({embeds:[E.warn("Usage: `s!givecoins @user <amount>`")]},true);
      const eco=getEco(target.id); eco.coins=(eco.coins||0)+amt; saveData();
      return ctx.reply({embeds:[E.success("💰 Coins Given").addFields({name:"User",value:`<@${target.id}>`,inline:true},{name:"Amount",value:`${amt} 🪙`,inline:true},{name:"Balance",value:`${eco.coins} 🪙`,inline:true}).setTimestamp()]});
    }

    default:
      return ctx.reply({content:`❓ Unknown command: \`${cmdName}\``},true);
  }
}

// ═══════════════════════════════════════════════════════════════════════════
//  CONTEXT FACTORIES
// ═══════════════════════════════════════════════════════════════════════════

function makeSlashCtx(interaction) {
  return {
    isSlash:      true,
    guild:        interaction.guild,
    member:       interaction.member,
    user:         interaction.user,
    channel:      interaction.channel,
    interaction,
    getString:    (k)   => interaction.options?.getString?.(k)??null,
    getInteger:   (k)   => interaction.options?.getInteger?.(k)??null,
    getUser:      (k)   => interaction.options?.getUser?.(k)??null,
    getRole:      (k)   => interaction.options?.getRole?.(k)??null,
    getChannel:   (k)   => interaction.options?.getChannel?.(k)??null,
    getSubcommand:()    => { try{return interaction.options?.getSubcommand();}catch{return null;} },
    getArg:       ()    => null,
    getArgs:      ()    => [],
    getMentionUser:()   => null,
    getMentionRole:()   => null,
    getMentionChannel:()=> null,
    reply: async (payload, ephemeral=false) => sendReply(interaction, payload, ephemeral),
  };
}

function makePrefixCtx(msg, args) {
  let _lastReply=null;
  const guild=msg.guild;
  return {
    isSlash:  false,
    guild,
    member:   msg.member,
    user:     msg.author,
    channel:  msg.channel,
    interaction: null,
    getString:    (_k,_r,idx=0) => args[idx]||null,
    getInteger:   (_k,_r,idx=0) => args[idx]?parseInt(args[idx],10)||null:null,
    getUser:      (_k,idx=0)    => { const id=(args[idx]||"").replace(/[<@!>]/g,""); return id?client.users.cache.get(id)||null:null; },
    getRole:      (_k,idx=0)    => { if(!guild)return null; const id=(args[idx]||"").replace(/[<@&>]/g,""); return id?guild.roles.cache.get(id)||null:null; },
    getChannel:   (_k,idx=0)    => { if(!guild)return null; const id=(args[idx]||"").replace(/[<#>]/g,""); return id?guild.channels.cache.get(id)||null:null; },
    getSubcommand:()    => args[0]?.toLowerCase()||null,
    getArg:       (idx) => args[idx]||null,
    getArgs:      ()    => args,
    getMentionUser:  (idx) => { const id=(args[idx]||"").replace(/[<@!>]/g,""); return id?client.users.cache.get(id)||null:null; },
    getMentionRole:  (idx) => { if(!guild)return null; const id=(args[idx]||"").replace(/[<@&>]/g,""); return id?guild.roles.cache.get(id)||null:null; },
    getMentionChannel:(idx)=> { if(!guild)return null; const id=(args[idx]||"").replace(/[<#>]/g,""); return id?guild.channels.cache.get(id)||null:null; },
    reply: async (payload, _ephemeral=false) => {
      try {
        if (typeof payload==="string") { _lastReply=await msg.channel.send({content:payload,allowedMentions:{users:[]}}); }
        else { const {flags:_f,...rest}=payload; _lastReply=await msg.channel.send({...rest,allowedMentions:{...rest.allowedMentions,parse:rest.allowedMentions?.parse||[]}}); }
      } catch(err){console.error("[prefixReply]",err.message);}
      return _lastReply;
    },
  };
}

// ═══════════════════════════════════════════════════════════════════════════
//  INTERACTION CREATE
// ═══════════════════════════════════════════════════════════════════════════

client.on("interactionCreate", async interaction => {
  try {
    if (data.blacklist.includes(interaction.user.id)&&interaction.isRepliable()) {
      await interaction.reply({content:"🚫 Blacklisted.",flags:MessageFlags.Ephemeral}).catch(()=>{});
      return;
    }

    // Slash commands
    if (interaction.isChatInputCommand()) {
      const ctx=makeSlashCtx(interaction);
      return await execCommand(interaction.commandName, ctx);
    }

    // Buttons
    if (interaction.isButton()) {
      const buttonMap={ticket_order:"order",ticket_partner:"partnership",ticket_inquiry:"inquiry"};
      if (buttonMap[interaction.customId]) {
        const type=buttonMap[interaction.customId];
        let modal;
        if (type==="order") {
          modal=new ModalBuilder().setCustomId("modal_order").setTitle("📦 Commission Order");
          modal.addComponents(
            new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("username").setLabel("Your Roblox Username").setStyle(TextInputStyle.Short).setMaxLength(100).setRequired(true)),
            new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("service").setLabel("Service Needed").setPlaceholder("UI, datastore, admin system...").setStyle(TextInputStyle.Short).setMaxLength(200).setRequired(true)),
            new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("description").setLabel("Detailed Description").setStyle(TextInputStyle.Paragraph).setMaxLength(1000).setRequired(true)),
            new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("budget").setLabel("Budget").setPlaceholder("e.g. $25 USD, 5000 Robux").setStyle(TextInputStyle.Short).setMaxLength(100).setRequired(true)),
            new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("payment").setLabel("Payment Method").setPlaceholder("PayPal F&F, CashApp, Robux, Gift Card").setStyle(TextInputStyle.Short).setMaxLength(100).setRequired(true)),
          );
        } else if (type==="partnership") {
          modal=new ModalBuilder().setCustomId("modal_partner").setTitle("🤝 Partnership Request");
          modal.addComponents(
            new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("serverName").setLabel("Server Name").setStyle(TextInputStyle.Short).setMaxLength(100).setRequired(true)),
            new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("invite").setLabel("Server Invite Link").setStyle(TextInputStyle.Short).setMaxLength(200).setRequired(true)),
            new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("memberCount").setLabel("Member Count").setStyle(TextInputStyle.Short).setMaxLength(50).setRequired(true)),
            new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("focus").setLabel("Server Focus / Niche").setStyle(TextInputStyle.Short).setMaxLength(200).setRequired(true)),
            new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("offering").setLabel("What can you offer us?").setStyle(TextInputStyle.Paragraph).setMaxLength(500).setRequired(true)),
          );
        } else {
          modal=new ModalBuilder().setCustomId("modal_inquiry").setTitle("❓ General Inquiry");
          modal.addComponents(
            new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("name").setLabel("Your Name / Username").setStyle(TextInputStyle.Short).setMaxLength(100).setRequired(true)),
            new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("topic").setLabel("Topic / Question").setStyle(TextInputStyle.Short).setMaxLength(200).setRequired(true)),
            new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("details").setLabel("Details").setStyle(TextInputStyle.Paragraph).setMaxLength(1000).setRequired(true)),
            new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("urgency").setLabel("Urgency (optional)").setPlaceholder("Not urgent / Few days / ASAP").setStyle(TextInputStyle.Short).setMaxLength(100).setRequired(false)),
          );
        }
        await interaction.showModal(modal); return;
      }

      if (interaction.customId==="ticket_close_btn") {
        const modal=new ModalBuilder().setCustomId("modal_close").setTitle("🔒 Close Ticket");
        modal.addComponents(new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("reason").setLabel("Reason for closing").setStyle(TextInputStyle.Paragraph).setMaxLength(500).setRequired(true)));
        await interaction.showModal(modal); return;
      }
    }

    // Modal submits
    if (interaction.isModalSubmit()) {
      const typeMap={modal_order:"order",modal_partner:"partnership",modal_inquiry:"inquiry"};
      if (typeMap[interaction.customId]) {
        await interaction.deferReply({flags:MessageFlags.Ephemeral});
        const type=typeMap[interaction.customId];
        let answers={};
        if (type==="order") answers={username:interaction.fields.getTextInputValue("username"),service:interaction.fields.getTextInputValue("service"),description:interaction.fields.getTextInputValue("description"),budget:interaction.fields.getTextInputValue("budget"),payment:interaction.fields.getTextInputValue("payment")};
        else if (type==="partnership") answers={serverName:interaction.fields.getTextInputValue("serverName"),invite:interaction.fields.getTextInputValue("invite"),memberCount:interaction.fields.getTextInputValue("memberCount"),focus:interaction.fields.getTextInputValue("focus"),offering:interaction.fields.getTextInputValue("offering")};
        else answers={name:interaction.fields.getTextInputValue("name"),topic:interaction.fields.getTextInputValue("topic"),details:interaction.fields.getTextInputValue("details"),urgency:interaction.fields.getTextInputValue("urgency")};
        const memberObj=interaction.member??await interaction.guild?.members.fetch(interaction.user.id).catch(()=>null);
        const result=await openTicket(interaction.guild,memberObj,type,answers);
        if (!result.ok) return interaction.editReply({content:`❌ ${result.error}`});
        return interaction.editReply({content:`✅ Ticket created: <#${result.channel.id}>`});
      }

      if (interaction.customId==="modal_close") {
        const reason=interaction.fields.getTextInputValue("reason");
        if (!interaction.channel?.name?.startsWith("ticket-")) return interaction.reply({content:"❌ Not a ticket channel.",flags:MessageFlags.Ephemeral});
        await interaction.deferReply({flags:MessageFlags.Ephemeral});
        await interaction.editReply({content:"🔒 Closing ticket…"});
        await closeTicket(interaction.channel,interaction.member||interaction.user,reason,interaction.guild);
        return;
      }
    }
  } catch(err) {
    console.error("[Interaction]",err.message);
    await sendErrorLog(err,"Interaction handler");
    try{if(interaction.isRepliable()&&!interaction.replied&&!interaction.deferred)await interaction.reply({content:"❌ An error occurred.",flags:MessageFlags.Ephemeral});}catch{}
  }
});

// ═══════════════════════════════════════════════════════════════════════════
//  REACTION ADD / REMOVE
// ═══════════════════════════════════════════════════════════════════════════

client.on("messageReactionAdd", async (reaction,user)=>{
  if (user.bot) return;
  if (reaction.partial) try{await reaction.fetch();}catch{return;}
  await handleReactionRole(reaction,user,true);
});
client.on("messageReactionRemove", async (reaction,user)=>{
  if (user.bot) return;
  if (reaction.partial) try{await reaction.fetch();}catch{return;}
  await handleReactionRole(reaction,user,false);
});

// ═══════════════════════════════════════════════════════════════════════════
//  MESSAGE CREATE — prefix commands + AI + XP + trivia + sticky
// ═══════════════════════════════════════════════════════════════════════════

client.on("messageCreate", async msg=>{
  if (msg.author.bot||!msg.guild) return;

  // Sticky
  if (msg.channel.id===STICKY_CHANNEL_ID) refreshSticky(msg.channel).catch(()=>{});

  // Partnership ad waiting
  if (partnerAwaitAd.has(msg.channel.id)) {
    const pd=partnerAwaitAd.get(msg.channel.id);
    if (msg.author.id===pd.member.id&&msg.content.trim().length>=20) {
      partnerAwaitAd.delete(msg.channel.id);
      setImmediate(async()=>{
        try {
          const {formAnswers}=pd, adText=msg.content.trim(), banner=msg.attachments.first()?.url||null;
          if (!PARTNER_AD_CHANNEL_ID) return;
          const g=client.guilds.cache.get(HOME_GUILD_ID); if (!g)return;
          const ch=await g.channels.fetch(PARTNER_AD_CHANNEL_ID).catch(()=>null); if (!ch?.isTextBased())return;
          const emb=new EmbedBuilder().setColor(0x9b59b6).setTitle(formAnswers.serverName||"New Partner")
            .setDescription(`${adText}\n\u200b`).addFields({name:"👥 Members",value:formAnswers.memberCount||"—",inline:true},{name:"🎯 Focus",value:formAnswers.focus||"—",inline:true},{name:"🤝 Offering",value:formAnswers.offering||"—"},{name:"🔗 Join",value:formAnswers.invite||"—"})
            .setFooter({text:`${BOT_NAME} Partnerships`}).setTimestamp();
          if (banner) emb.setImage(banner);
          await ch.send({embeds:[emb]});
          await msg.channel.send({embeds:[E.success("✅ Partnership Posted!").setDescription(`Your ad is live in <#${PARTNER_AD_CHANNEL_ID}>! 💗\n\nThis ticket closes in 15 seconds.`)]});
          setTimeout(()=>msg.channel.delete("Partnership posted").catch(()=>{}),15_000);
        } catch(err){console.error("[PartnerAd]",err.message);}
      });
      return;
    }
  }

  // Forum support AI
  if (FORUM_SUPPORT_CHANNEL_ID&&msg.channel.isThread?.()&&msg.channel.parentId===FORUM_SUPPORT_CHANNEL_ID&&GROQ_API_KEY) {
    const key=`forum:${msg.channel.id}:${msg.author.id}`, last=aiCooldowns.get(key)||0;
    if (Date.now()-last>=8_000) {
      aiCooldowns.set(key,Date.now());
      setImmediate(async()=>{const {text,model}=await callTicketAI(`forum_${msg.channel.id}`,msg.content,"inquiry",null);if(text)await msg.channel.send({embeds:[aiEmbed(text,model,msg.author.username,"inquiry")]}).catch(()=>{});});
    }
    return;
  }

  // Ticket AI
  if (msg.channel.name?.startsWith("ticket-")&&!msg.content.startsWith(PREFIX)) {
    const s=getSettings(msg.guild.id);
    const staff=isStaff(msg.member);
    const typeMatch=msg.channel.topic?.match(/^\[(\w+)\]/);
    const ticketType=typeMatch?typeMatch[1]:"inquiry";
    if (!staff&&s.ticketAI!==false&&GROQ_API_KEY&&!ticketAIOff.has(msg.channel.id)&&ticketType!=="order") {
      const key=`${msg.channel.id}:${msg.author.id}`, last=aiCooldowns.get(key)||0;
      if (Date.now()-last>=8_000) {
        aiCooldowns.set(key,Date.now());
        setImmediate(async()=>{const {text,model}=await callTicketAI(msg.channel.id,msg.content,ticketType,null);if(text)await msg.channel.send({embeds:[aiEmbed(text,model,msg.author.username,ticketType)]}).catch(()=>{});});
      }
    }
  }

  // XP / coins / trivia
  if (!msg.content.startsWith(PREFIX)) {
    grantXP(msg).catch(()=>{});
    grantCoins(msg).catch(()=>{});
    if (data.triviaActive[msg.channel.id]) {
      const tv=data.triviaActive[msg.channel.id];
      if (tv.answers.some(a=>msg.content.trim().toLowerCase().includes(a.toLowerCase()))) {
        getEco(msg.author.id).coins=(getEco(msg.author.id).coins||0)+tv.coins;
        delete data.triviaActive[msg.channel.id]; saveData();
        await msg.reply({embeds:[E.success("🧠 Correct!").setDescription(`**+${tv.coins} 🪙**`)]}).catch(()=>{});
      }
    }
    return;
  }

  // ── PREFIX COMMANDS ─────────────────────────────────────────────────────
  if (data.blacklist.includes(msg.author.id)) return;
  const rawArgs=msg.content.slice(PREFIX.length).trim().split(/\s+/);
  const cmd=rawArgs.shift()?.toLowerCase();
  if (!cmd) return;

  // Build context — shift args for subcommand-style commands
  const ctx=makePrefixCtx(msg,rawArgs);

  try {
    await execCommand(cmd,ctx);
  } catch(err) {
    console.error(`[Prefix ${cmd}]`,err.message);
    await sendErrorLog(err,`Prefix: s!${cmd}`);
  }
});

// ═══════════════════════════════════════════════════════════════════════════
//  FORUM THREAD CREATE
// ═══════════════════════════════════════════════════════════════════════════

client.on("threadCreate", async thread=>{
  try {
    if (!FORUM_SUPPORT_CHANNEL_ID||thread.parentId!==FORUM_SUPPORT_CHANNEL_ID) return;
    await thread.join().catch(()=>{});
    if (!GROQ_API_KEY) return;
    const {text,model}=await callTicketAI(`forum_${thread.id}`,`New support thread: "${thread.name}". Greet the user warmly, introduce yourself as Snuggles AI, and ask them to describe their Roblox scripting issue in detail. Keep it short. 💗`,"inquiry",null);
    if (text) await thread.send({embeds:[aiEmbed(text,model,"Support","inquiry")]});
  } catch(err){console.error("[threadCreate]",err.message);}
});

// ═══════════════════════════════════════════════════════════════════════════
//  GUILD EVENTS
// ═══════════════════════════════════════════════════════════════════════════

client.on("guildCreate", async g=>{
  console.log(`Joined: ${g.name}`); updateStatus();
  await cacheInvites(g).catch(()=>{});
  const ch=g.channels.cache.filter(c=>c.type===ChannelType.GuildText&&c.permissionsFor(g.members.me)?.has(PermissionFlagsBits.SendMessages)).sort((a,b)=>a.rawPosition-b.rawPosition).first();
  if (ch) await ch.send({embeds:[new EmbedBuilder().setColor(BRAND_COLOR).setTitle(`🧸 ${BOT_NAME} v${BOT_VERSION} — Thanks for adding me!`)
    .setDescription(["**Quick Setup:**","","`/setlog #channel` — mod log","`/setreviews #channel` — reviews","`/settranscripts #channel` — transcripts","`/setverifyrole @role` — Roblox verify","`/setscamchannel #channel` — scam reports","`/ticketpanel` — post ticket panel","","`s!setup` — full guide | `s!help` — all commands"].join("\n"))
    .setFooter({text:`${BOT_NAME} v${BOT_VERSION} • Made with 💗 by ${BOT_OWNER}`}).setTimestamp()]}).catch(()=>{});
});

client.on("guildDelete", g=>{console.log(`Left: ${g.name}`);updateStatus();});

client.on("inviteCreate", inv=>{if(!inv.guild)return;if(!data.inviteCache[inv.guild.id])data.inviteCache[inv.guild.id]={};data.inviteCache[inv.guild.id][inv.code]=inv.uses||0;saveData();});
client.on("inviteDelete", inv=>{if(!inv.guild)return;if(data.inviteCache[inv.guild.id])delete data.inviteCache[inv.guild.id][inv.code];saveData();});

client.on("guildMemberAdd", async member=>{
  try {
    await handleAntiRaidJoin(member);
    const g=member.guild;
    const newInv=await g.invites.fetch().catch(()=>null);
    if (newInv) {
      const cached=data.inviteCache[g.id]||{};
      let inviterId=null;
      newInv.forEach(inv=>{if((inv.uses||0)>(cached[inv.code]||0)){inviterId=inv.inviter?.id;}cached[inv.code]=inv.uses||0;});
      data.inviteCache[g.id]=cached;
      if (inviterId){if(!data.invites[g.id])data.invites[g.id]={};if(!data.invites[g.id][inviterId])data.invites[g.id][inviterId]={invited:0,left:0};data.invites[g.id][inviterId].invited++;}
      saveData();
    }
    await logMod(g,E.success("📥 Member Joined").addFields({name:"User",value:`<@${member.id}> (${member.user.tag})`},{name:"Account Age",value:`<t:${Math.floor(member.user.createdTimestamp/1000)}:R>`}).setThumbnail(member.user.displayAvatarURL()).setTimestamp());
  } catch {}
});

client.on("guildMemberRemove", async member=>{
  try {
    if (data.invites[member.guild.id]) { for (const inv of Object.values(data.invites[member.guild.id])){inv.left++;break;} saveData(); }
    await logMod(member.guild,E.error("📤 Member Left").addFields({name:"User",value:`<@${member.id}> (${member.user.tag})`}).setThumbnail(member.user.displayAvatarURL()).setTimestamp());
  } catch {}
});

client.on("messageDelete", async msg=>{try{if(!msg.guild||msg.author?.bot||msg.partial||!msg.content)return;await logMod(msg.guild,E.error("🗑️ Message Deleted").addFields({name:"Author",value:`<@${msg.author.id}>`,inline:true},{name:"Channel",value:`<#${msg.channel.id}>`,inline:true},{name:"Content",value:msg.content.slice(0,1024)}).setTimestamp());}catch{}});
client.on("messageUpdate", async(o,n)=>{try{if(!n.guild||n.author?.bot||o.partial||n.partial||o.content===n.content)return;await logMod(n.guild,E.warn("✏️ Message Edited").addFields({name:"Author",value:`<@${n.author.id}>`,inline:true},{name:"Channel",value:`<#${n.channel.id}>`,inline:true},{name:"Before",value:(o.content||"—").slice(0,1024)},{name:"After",value:(n.content||"—").slice(0,1024)},{name:"Link",value:`[Jump](${n.url})`,inline:true}).setTimestamp());}catch{}});
client.on("channelDelete", async ch=>{try{if(!ch.guild)return;await logMod(ch.guild,E.error("💬 Channel Deleted").addFields({name:"Name",value:ch.name,inline:true}).setTimestamp());const logs=await ch.guild.fetchAuditLogs({type:AuditLogEvent.ChannelDelete,limit:1}).catch(()=>null);if(logs){const e=logs.entries.first();if(e)await checkNuke(ch.guild,e.executor.id,"channelDelete");}}catch{}});
client.on("roleDelete", async r=>{try{await logMod(r.guild,E.error("🎭 Role Deleted").addFields({name:"Name",value:r.name,inline:true}).setTimestamp());const logs=await r.guild.fetchAuditLogs({type:AuditLogEvent.RoleDelete,limit:1}).catch(()=>null);if(logs){const e=logs.entries.first();if(e)await checkNuke(r.guild,e.executor.id,"roleDelete");}}catch{}});
client.on("guildBanAdd", async ban=>{try{await logMod(ban.guild,E.error("🔨 Member Banned").addFields({name:"User",value:`${ban.user.tag}`},{name:"Reason",value:ban.reason||"No reason"}).setTimestamp());const logs=await ban.guild.fetchAuditLogs({type:AuditLogEvent.MemberBanAdd,limit:1}).catch(()=>null);if(logs){const e=logs.entries.first();if(e)await checkNuke(ban.guild,e.executor.id,"ban");}}catch{}});
client.on("guildBanRemove", async ban=>{try{await logMod(ban.guild,E.success("🔓 Member Unbanned").addFields({name:"User",value:`${ban.user.tag}`}).setTimestamp());}catch{}});

// ═══════════════════════════════════════════════════════════════════════════
//  ERROR HANDLERS
// ═══════════════════════════════════════════════════════════════════════════

client.on("error", err=>{console.error("Client error:",err.message);sendErrorLog(err,"Client error");});
process.on("unhandledRejection", err=>{
  const msg=String(err?.message||err);
  if (msg.includes("Sign in to confirm")||msg.includes("live stream")) return;
  console.error("Unhandled rejection:",msg);
  sendErrorLog(err,"Unhandled rejection");
});
process.on("uncaughtException", err=>{console.error("Uncaught exception:",err);sendErrorLog(err,"Uncaught exception");});

// ═══════════════════════════════════════════════════════════════════════════
//  LOGIN
// ═══════════════════════════════════════════════════════════════════════════

client.login(TOKEN);
