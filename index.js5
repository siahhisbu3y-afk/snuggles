// ═══════════════════════════════════════════════════════════════════════════
//  AI — GROQ
//  FIX: Rate limit (429) flood — add proper backoff, don't log to error
//  channel for 429s, cap retries, use AbortSignal timeout
// ═══════════════════════════════════════════════════════════════════════════

const ticketConvos    = new Map();
const ticketAIOff     = new Set();
const partnerAwaitAd  = new Map();
const aiCooldowns     = new Map();
const userChatHistory = new Map();

// Global rate-limit state — shared across all AI calls
let groqRateLimitUntil = 0;

async function callGroq(messages, systemPrompt, opts = {}) {
  if (!GROQ_API_KEY) return { text:null, model:null };

  // If we hit a rate limit recently, wait before trying again
  const now = Date.now();
  if (groqRateLimitUntil > now) {
    const waitMs = groqRateLimitUntil - now;
    console.warn(`[AI] Rate limited — waiting ${Math.ceil(waitMs/1000)}s`);
    await new Promise(r => setTimeout(r, waitMs));
  }

  const maxTokens = opts.maxTokens || 900;
  const temp      = opts.temperature ?? 0.72;

  for (const model of GROQ_MODELS) {
    try {
      const res = await fetch("https://api.groq.com/openai/v1/chat/completions", {
        method:"POST",
        headers:{ "Content-Type":"application/json", "Authorization":`Bearer ${GROQ_API_KEY}` },
        body:JSON.stringify({ model:model.id, max_tokens:maxTokens, temperature:temp, messages:[{ role:"system", content:systemPrompt }, ...messages] }),
        signal:AbortSignal.timeout(20_000),
      });

      if (res.status === 429) {
        // Back off for 60 seconds on rate limit — don't spam retries
        const retryAfter = parseInt(res.headers.get("retry-after") || "60", 10);
        groqRateLimitUntil = Date.now() + (retryAfter * 1000);
        console.warn(`[AI] 429 rate limited — backing off ${retryAfter}s`);
        // Only try one more model then give up to avoid more 429s
        await new Promise(r => setTimeout(r, 2000));
        continue;
      }
      if (!res.ok) { console.error(`[AI] ${model.id} HTTP ${res.status}`); continue; }

      const json = await res.json();
      const text = json.choices?.[0]?.message?.content?.trim() || null;
      if (text) return { text, model:model.label };
    } catch (err) {
      if (err.name === "TimeoutError") { console.warn(`[AI] ${model.id} timeout`); continue; }
      console.error(`[AI] ${model.id}:`, err.message);
    }
  }
  return { text:null, model:null };
}

async function callTicketAI(channelId, userMsg, ticketType, formCtx) {
  if (!ticketConvos.has(channelId)) ticketConvos.set(channelId, []);
  const history = ticketConvos.get(channelId);
  history.push({ role:"user", content:userMsg });
  while (history.length > 20) history.shift();
  const sys = AI_TICKET_SYSTEM + (formCtx ? `\n\n## Ticket Details\nType: ${ticketType}\n${formCtx}` : "");
  const result = await callGroq(history, sys, { maxTokens:800 });
  if (result.text) history.push({ role:"assistant", content:result.text });
  return result;
}

// ═══════════════════════════════════════════════════════════════════════════
//  IMAGE GENERATION
//  FIX: Pollinations unreliable — use flux model, retry with fallback,
//  validate response is actually an image, set cooldown ONLY on success
// ═══════════════════════════════════════════════════════════════════════════

async function enhanceImagePrompt(prompt) {
  if (!GROQ_API_KEY) return prompt;
  const { text } = await callGroq(
    [{ role:"user", content:`Enhance this into a detailed image generation prompt: "${prompt}"` }],
    AI_IMAGE_SYSTEM, { maxTokens:200, temperature:0.85 }
  );
  return text || prompt;
}

async function generateImageStability(prompt, style) {
  const full = `${prompt}${style ? `, ${IMG_STYLES[style]}` : ""}`;
  const stylePreset = { anime:"anime", realistic:"photographic", fantasy:"fantasy-art", oil:"analog-film" }[style];
  const res = await fetch("https://api.stability.ai/v1/generation/stable-diffusion-xl-1024-v1-0/text-to-image", {
    method:"POST",
    headers:{ "Content-Type":"application/json", "Authorization":`Bearer ${STABILITY_API_KEY}`, "Accept":"application/json" },
    body:JSON.stringify({
      text_prompts:[
        { text:full, weight:1 },
        { text:"blurry, low quality, distorted, ugly, nsfw, watermark", weight:-1 },
      ],
      cfg_scale:8, height:1024, width:1024, steps:30, samples:1,
      ...(stylePreset ? { style_preset:stylePreset } : {}),
    }),
    signal:AbortSignal.timeout(60_000),
  });
  if (!res.ok) throw new Error(`Stability ${res.status}`);
  const json = await res.json();
  const b64 = json.artifacts?.[0]?.base64;
  if (!b64) throw new Error("No image from Stability");
  return { buffer:Buffer.from(b64, "base64"), ext:"png", source:"Stability AI SDXL" };
}

async function generateImageDALLE(prompt) {
  const res = await fetch("https://api.openai.com/v1/images/generations", {
    method:"POST",
    headers:{ "Content-Type":"application/json", "Authorization":`Bearer ${OPENAI_API_KEY}` },
    body:JSON.stringify({ model:"dall-e-3", prompt, n:1, size:"1024x1024", quality:"hd", response_format:"b64_json" }),
    signal:AbortSignal.timeout(90_000),
  });
  if (!res.ok) throw new Error(`DALL-E ${res.status}`);
  const json = await res.json();
  const b64 = json.data?.[0]?.b64_json;
  if (!b64) throw new Error("No image from DALL-E");
  return { buffer:Buffer.from(b64, "base64"), ext:"png", source:"OpenAI DALL-E 3 HD" };
}

async function generateImagePollinations(prompt, style) {
  // Pick best model for the style
  const modelMap = { anime:"flux-anime", realistic:"flux-realism", default:"flux" };
  const model    = modelMap[style] || modelMap.default;
  const quality  = "masterpiece, best quality, highly detailed, sharp focus";
  const full     = `${prompt}${style ? `, ${IMG_STYLES[style]}` : ""}, ${quality}`;
  const encoded  = encodeURIComponent(full);
  const seed     = Math.floor(Math.random() * 2_147_483_647);
  const url      = `https://image.pollinations.ai/prompt/${encoded}?width=1024&height=1024&seed=${seed}&model=${model}&nologo=true&enhance=true&safe=true`;

  const controller = new AbortController();
  const timeout    = setTimeout(() => controller.abort(), 90_000);

  try {
    const res = await fetch(url, { signal:controller.signal, headers:{ "User-Agent":"SnugglesBot/7.2" } });
    clearTimeout(timeout);
    if (!res.ok) throw new Error(`HTTP ${res.status}`);

    const ct = res.headers.get("content-type") || "";
    if (!ct.includes("image")) {
      // Try turbo fallback
      const fb = await fetch(`https://image.pollinations.ai/prompt/${encoded}?width=1024&height=1024&seed=${seed}&model=turbo&nologo=true`, { signal:AbortSignal.timeout(60_000) });
      if (!fb.ok) throw new Error(`Fallback HTTP ${fb.status}`);
      const buf = Buffer.from(await fb.arrayBuffer());
      if (buf.length < 5000) throw new Error("Response too small");
      return { buffer:buf, ext:"png", source:"Pollinations AI (Turbo)" };
    }

    const buffer = Buffer.from(await res.arrayBuffer());
    if (buffer.length < 5000) throw new Error("Image too small — likely error page");
    return { buffer, ext:"png", source:`Pollinations AI (${model})` };
  } catch (err) {
    clearTimeout(timeout);
    throw err;
  }
}

async function generateImage(prompt, style) {
  if (STABILITY_API_KEY) { try { return await generateImageStability(prompt, style); } catch (e) { console.warn("[ImgGen] Stability:", e.message); } }
  if (OPENAI_API_KEY)    { try { return await generateImageDALLE(prompt); }            catch (e) { console.warn("[ImgGen] DALL-E:", e.message); } }
  return await generateImagePollinations(prompt, style);
}

// ═══════════════════════════════════════════════════════════════════════════
//  VOICE / LOFI — COMPLETELY REWRITTEN
//
//  KEY FIXES:
//  1. Don't use ytdl for live streams — use direct internet radio MP3 URLs
//  2. Use @discordjs/voice createAudioResource with StreamType.Arbitrary
//  3. Robust reconnection loop that never gives up
//  4. Bot never leaves VC — reconnects automatically on disconnect
//  5. Music play command also fixed to use proper connection handling
// ═══════════════════════════════════════════════════════════════════════════

let voiceLib         = null;
let lofiConn         = null;
let lofiPlayer       = null;
let lofiCurrentTrack = null;
let lofiRetryTimer   = null;
let lofiRunning      = false;
let lofiStreamIdx    = 0;

function loadVoiceLib() {
  if (voiceLib) return voiceLib;
  try { voiceLib = require("@discordjs/voice"); return voiceLib; }
  catch { return null; }
}

// Start lofi VC — uses internet radio streams, no ytdl needed
async function startLofiVC() {
  clearTimeout(lofiRetryTimer);
  if (lofiRunning) return;

  const vl = loadVoiceLib();
  if (!vl) {
    console.error("❌ @discordjs/voice not installed. Run: npm install @discordjs/voice libsodium-wrappers ffmpeg-static");
    return;
  }

  lofiRunning = true;
  const { joinVoiceChannel, createAudioPlayer, createAudioResource, AudioPlayerStatus, VoiceConnectionStatus, StreamType, getVoiceConnection, entersState } = vl;

  async function connect() {
    const guild = client.guilds.cache.get(HOME_GUILD_ID);
    if (!guild) { console.warn("[Lofi] Guild not found"); return null; }
    const vc = guild.channels.cache.get(LOFI_VC_CHANNEL_ID);
    if (!vc) { console.warn("[Lofi] VC channel not found"); return null; }

    // Clean up any stale connection
    try { const old = getVoiceConnection(HOME_GUILD_ID); if (old) old.destroy(); } catch {}
    await new Promise(r => setTimeout(r, 500));

    try {
      const conn = joinVoiceChannel({ channelId:LOFI_VC_CHANNEL_ID, guildId:HOME_GUILD_ID, adapterCreator:guild.voiceAdapterCreator, selfDeaf:false, selfMute:false });
      await entersState(conn, VoiceConnectionStatus.Ready, 20_000);
      return conn;
    } catch (err) {
      console.error("[Lofi] Connect failed:", err.message);
      return null;
    }
  }

  async function playStream(trackIdx) {
    const track = LOFI_RADIO_STREAMS[trackIdx % LOFI_RADIO_STREAMS.length];
    lofiCurrentTrack = track;
    console.log("[Lofi] ▶", track.title, "→", track.url);

    try {
      // Fetch the radio stream as a raw HTTP stream — no ytdl needed!
      const res = await fetch(track.url, {
        headers:{ "User-Agent":"Mozilla/5.0 SnugglesBot/7.2", "Icy-MetaData":"1" },
        signal:AbortSignal.timeout(15_000),
      });
      if (!res.ok) throw new Error(`HTTP ${res.status}`);
      if (!res.body) throw new Error("No response body");

      // Convert web ReadableStream to Node.js stream
      const { Readable } = require("stream");
      const nodeStream = Readable.fromWeb(res.body);

      const resource = createAudioResource(nodeStream, {
        inputType:StreamType.Arbitrary,
        inlineVolume:true,
      });
      resource.volume?.setVolume(0.4);
      lofiPlayer.play(resource);
      return true;
    } catch (err) {
      console.error("[Lofi] Stream error:", err.message);
      return false;
    }
  }

  async function run() {
    const conn = await connect();
    if (!conn) {
      lofiRunning = false;
      lofiRetryTimer = setTimeout(startLofiVC, 30_000);
      return;
    }
    lofiConn = conn;

    const player = createAudioPlayer();
    lofiPlayer   = player;
    conn.subscribe(player);

    // Handle disconnection — reconnect immediately, never give up
    conn.on(VoiceConnectionStatus.Disconnected, async () => {
      console.log("[Lofi] Disconnected — attempting immediate reconnect");
      try {
        await Promise.race([
          entersState(conn, VoiceConnectionStatus.Signalling, 5_000),
          entersState(conn, VoiceConnectionStatus.Connecting, 5_000),
        ]);
        // Reconnected successfully, keep playing
      } catch {
        // Full reconnect needed
        conn.destroy();
        lofiConn    = null;
        lofiRunning = false;
        console.log("[Lofi] Full reconnect in 5s");
        lofiRetryTimer = setTimeout(startLofiVC, 5_000);
      }
    });

    conn.on("error", err => {
      console.error("[Lofi] Conn error:", err.message);
      lofiConn    = null;
      lofiRunning = false;
      lofiRetryTimer = setTimeout(startLofiVC, 8_000);
    });

    // When track ends or errors, play next stream
    player.on(AudioPlayerStatus.Idle, () => {
      lofiStreamIdx = (lofiStreamIdx + 1) % LOFI_RADIO_STREAMS.length;
      setTimeout(() => playStream(lofiStreamIdx), 2000);
    });

    player.on("error", err => {
      console.error("[Lofi] Player error:", err.message);
      lofiStreamIdx = (lofiStreamIdx + 1) % LOFI_RADIO_STREAMS.length;
      setTimeout(() => playStream(lofiStreamIdx), 3000);
    });

    // Start playing
    const ok = await playStream(lofiStreamIdx);
    if (!ok) {
      // Try next stream if first one fails
      lofiStreamIdx = 1;
      await playStream(lofiStreamIdx);
    }
    console.log("🎵 24/7 Lofi VC started!");
  }

  await run();
}

// ─── Guild Music Player (for s!play command) ─────────────────────────────────
const guildMusic = new Map();
function getGuildMusic(gid) {
  if (!guildMusic.has(gid)) guildMusic.set(gid, { queue:[], current:null, connection:null, player:null, volume:0.5, loop:false, textChannel:null });
  return guildMusic.get(gid);
}

// Play music via ytdl for non-lofi guild music
async function playNextTrack(guildId) {
  const m = getGuildMusic(guildId);
  if (!m.queue.length && !m.loop) { m.current = null; return; }
  const track = m.loop && m.current ? m.current : m.queue.shift();
  m.current = track;
  const vl = loadVoiceLib();
  if (!vl) return;

  try {
    const { createAudioResource, StreamType } = vl;
    let ytdl;
    try { ytdl = require("@distube/ytdl-core"); } catch { throw new Error("@distube/ytdl-core not installed"); }

    const url = track.url;
    if (!url) { await playNextTrack(guildId); return; }

    const stream   = ytdl(url, { filter:"audioonly", quality:"highestaudio", highWaterMark:1<<25 });
    const resource = createAudioResource(stream, { inputType:StreamType.Arbitrary, inlineVolume:true });
    resource.volume?.setVolume(m.volume);
    m.player.play(resource);

    if (m.textChannel) {
      await m.textChannel.send({ embeds:[new EmbedBuilder().setColor(MUSIC_COLOR).setTitle("🎵 Now Playing")
        .setDescription(`**[${track.title}](${url})**`)
        .addFields({ name:"Source", value:track.source||"—", inline:true }, { name:"Volume", value:`${Math.round(m.volume*100)}%`, inline:true }, { name:"Loop", value:m.loop?"On":"Off", inline:true })
        .setTimestamp()] }).catch(() => {});
    }
  } catch (err) {
    console.error("[Music]", err.message);
    if (m.textChannel) await m.textChannel.send({ content:`❌ Failed to play **${track.title}**: ${err.message}` }).catch(() => {});
    setTimeout(() => playNextTrack(guildId), 2000);
  }
}

async function resolveQuery(query) {
  if (query.match(/youtu(?:\.be|be\.com)/)) return [{ title:"YouTube Track", url:query, source:"YouTube ▶️" }];
  try {
    const ytsr = require("@distube/ytsr");
    const res  = await ytsr(query, { limit:1 });
    if (res.items?.[0]) return [{ title:res.items[0].title, url:res.items[0].url, source:"YouTube ▶️" }];
  } catch {}
  return null;
}

// ─── Spotify ─────────────────────────────────────────────────────────────────
let spotifyToken = null, spotifyExp = 0;
async function getSpotifyToken() {
  if (spotifyToken && Date.now() < spotifyExp) return spotifyToken;
  if (!SPOTIFY_CLIENT_ID || !SPOTIFY_CLIENT_SECRET) return null;
  try {
    const creds = Buffer.from(`${SPOTIFY_CLIENT_ID}:${SPOTIFY_CLIENT_SECRET}`).toString("base64");
    const res = await fetch("https://accounts.spotify.com/api/token", { method:"POST", headers:{ "Authorization":`Basic ${creds}`, "Content-Type":"application/x-www-form-urlencoded" }, body:"grant_type=client_credentials" });
    if (!res.ok) return null;
    const j = await res.json(); spotifyToken = j.access_token; spotifyExp = Date.now() + (j.expires_in - 60) * 1000; return spotifyToken;
  } catch { return null; }
}

