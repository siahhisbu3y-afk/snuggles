async function callGroq(messages, system, opts={}) {
  if (!GROQ_API_KEY) return { text:null, model:null };
  for (const model of GROQ_MODELS) {
    try {
      const res = await fetch("https://api.groq.com/openai/v1/chat/completions", {
        method:"POST",
        headers:{"Content-Type":"application/json","Authorization":`Bearer ${GROQ_API_KEY}`},
        body:JSON.stringify({ model, max_tokens:opts.maxTokens||800, temperature:opts.temp??0.7, messages:[{role:"system",content:system},...messages] }),
      });
      if (!res.ok) continue;
      const j = await res.json();
      const text = j.choices?.[0]?.message?.content?.trim()||null;
      if (text) return { text, model };
    } catch(e) { console.error(`[Groq ${model}]`, e.message); }
  }
  return { text:null, model:null };
}

async function callTicketAI(channelId, userMsg, ticketType, formCtx) {
  if (!ticketConvos.has(channelId)) ticketConvos.set(channelId, []);
  const hist = ticketConvos.get(channelId);
  hist.push({ role:"user", content:userMsg });
  while (hist.length>20) hist.shift();
  const sys = (SYS[ticketType]||SYS.inquiry)
    +(formCtx?`\n\n## Ticket Form\n${formCtx}`:"")
    +"\n\nIMPORTANT: Respond in ONE complete message.";
  const r = await callGroq(hist, sys, { maxTokens:900 });
  if (r.text) hist.push({ role:"assistant", content:r.text });
  return r;
}

// ─── IMAGE GENERATION ─────────────────────────────────────────────────────────
async function enhancePrompt(raw) {
  const { text } = await callGroq([{role:"user",content:`Enhance: "${raw}"`}], SYS.imgEnhance, { maxTokens:220, temp:0.8 });
  return text||raw;
}

async function generateImage(prompt, style) {
  const full = style ? `${prompt}, ${IMG_STYLES[style]||""}` : prompt;
  if (STABILITY_API_KEY) {
    try {
      const res = await fetch("https://api.stability.ai/v1/generation/stable-diffusion-xl-1024-v1-0/text-to-image", {
        method:"POST",
        headers:{"Content-Type":"application/json","Authorization":`Bearer ${STABILITY_API_KEY}`,"Accept":"application/json"},
        body:JSON.stringify({ text_prompts:[{text:full,weight:1},{text:"blurry, bad quality, distorted, nsfw, ugly",weight:-1}], cfg_scale:7, height:1024, width:1024, steps:30, samples:1 }),
      });
      if (res.ok) {
        const j = await res.json();
        const b64 = j.artifacts?.[0]?.base64;
        if (b64) return { buffer:Buffer.from(b64,"base64"), ext:"png", source:"Stability AI SDXL" };
      }
    } catch(e) { console.warn("[ImgGen] Stability failed:", e.message); }
  }
  const encoded = encodeURIComponent(full);
  const seed = randInt(0, 999999);
  const url = `https://image.pollinations.ai/prompt/${encoded}?width=1024&height=1024&nologo=true&seed=${seed}&enhance=true`;
  const res = await fetch(url);
  if (!res.ok) throw new Error(`Pollinations error: ${res.status}`);
  return { buffer:Buffer.from(await res.arrayBuffer()), ext:"png", source:"Pollinations AI" };
}

// ─── ROBLOX API ───────────────────────────────────────────────────────────────
async function fetchRobloxUser(username) {
  try {
    const res = await fetch("https://users.roblox.com/v1/usernames/users", {
      method:"POST", headers:{"Content-Type":"application/json"},
      body:JSON.stringify({ usernames:[username], excludeBannedUsers:false })
    });
    if (!res.ok) return null;
    return (await res.json()).data?.[0]||null;
  } catch { return null; }
}

async function fetchRobloxProfile(userId) {
  try {
    const [uRes, statsRes, followRes] = await Promise.all([
      fetch(`https://users.roblox.com/v1/users/${userId}`),
      fetch(`https://friends.roblox.com/v1/users/${userId}/friends/count`).catch(()=>null),
      fetch(`https://friends.roblox.com/v1/users/${userId}/followers/count`).catch(()=>null),
    ]);
    const u = uRes.ok ? await uRes.json() : null;
    const stats = statsRes?.ok ? await statsRes.json() : null;
    const follows = followRes?.ok ? await followRes.json() : null;
    if (!u) return null;
    return {
      id:u.id, name:u.name, displayName:u.displayName,
      description:u.description||"", created:u.created,
      isBanned:u.isBanned, friendCount:stats?.count??null,
      followerCount:follows?.count??null,
    };
  } catch { return null; }
}

async function fetchRobloxAvatar(userId) {
  try {
    const res = await fetch(`https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds=${userId}&size=150x150&format=Png`);
    if (!res.ok) return null;
    return (await res.json()).data?.[0]?.imageUrl||null;
  } catch { return null; }
}

function genVerifyCode() { return "SNUG-"+Math.random().toString(36).substring(2,8).toUpperCase(); }

// ─── BOT STATUS ───────────────────────────────────────────────────────────────
const STATUS_CYCLE = [
  n => ({ name:`${n} server${n!==1?"s":""} 💗`, type:ActivityType.Watching }),
  _  => ({ name:`s!help • ${BOT_NAME}`,          type:ActivityType.Playing  }),
  _  => ({ name:`commissions open! 💗`,           type:ActivityType.Playing  }),
  _  => ({ name:`${Object.keys(data.robloxVerified).length} verified scripters`, type:ActivityType.Watching }),
];
let _si = 0;
