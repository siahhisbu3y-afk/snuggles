  review:3600000, meme:8000, "8ball":3000, rate:5000, quote:5000,
  tip:5000, daily:86400000, snippet:5000, dowork:3600000,
  trivia:5000, coinflip:3000, roll:3000, rps:3000, serverinfo:5000,
  imagine:30000, verify:300000, reportscammer:60000, ai:3000,
};
const checkCD = (cmd,uid) => { const r=(_cds.get(`${cmd}:${uid}`)||0)-Date.now(); return r>0?Math.ceil(r/1000):0; };
const useCD   = (cmd,uid) => { const ms=CD_CONFIG[cmd]; if(ms)_cds.set(`${cmd}:${uid}`,Date.now()+ms); };

