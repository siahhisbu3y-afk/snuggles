const E = {
  make:    (color,title) => new EmbedBuilder().setColor(color).setTitle(title||null),
  brand:   t => new EmbedBuilder().setColor(C.brand).setTitle(t||null),
  success: t => new EmbedBuilder().setColor(C.success).setTitle(t||null),
