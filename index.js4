  new SlashCommandBuilder().setName("warns").setDescription("📋 View warnings").addUserOption(o=>o.setName("user").setDescription("User").setRequired(true)),
  new SlashCommandBuilder().setName("unwarn").setDescription("✅ Remove a warning").addIntegerOption(o=>o.setName("id").setDescription("Warning ID").setRequired(true)),
  new SlashCommandBuilder().setName("clearwarns").setDescription("🗑️ Clear all warnings").addUserOption(o=>o.setName("user").setDescription("User").setRequired(true)),
  new SlashCommandBuilder().setName("modlogs").setDescription("📓 Moderation history").addUserOption(o=>o.setName("user").setDescription("User").setRequired(true)),
  new SlashCommandBuilder().setName("purge").setDescription("🗑️ Bulk delete messages")
    .addIntegerOption(o=>o.setName("count").setDescription("1-100").setMinValue(1).setMaxValue(100).setRequired(true))
    .addUserOption(o=>o.setName("user").setDescription("Only delete from this user")),
  new SlashCommandBuilder().setName("lock").setDescription("🔒 Lock channel"),
  new SlashCommandBuilder().setName("unlock").setDescription("🔓 Unlock channel"),
  new SlashCommandBuilder().setName("slowmode").setDescription("🐢 Set slowmode").addIntegerOption(o=>o.setName("seconds").setDescription("0-21600").setMinValue(0).setMaxValue(21600).setRequired(true)),
  new SlashCommandBuilder().setName("nick").setDescription("✏️ Set nickname")
    .addUserOption(o=>o.setName("user").setDescription("User").setRequired(true))
    .addStringOption(o=>o.setName("name").setDescription("New nickname (leave blank to clear)")),
  new SlashCommandBuilder().setName("announce").setDescription("📢 Post an announcement")
    .addStringOption(o=>o.setName("message").setDescription("Content").setRequired(true))
    .addChannelOption(o=>o.setName("channel").setDescription("Target channel")),
  new SlashCommandBuilder().setName("say").setDescription("💬 Send a message as the bot").addStringOption(o=>o.setName("message").setDescription("Message").setRequired(true)),
  new SlashCommandBuilder().setName("embed").setDescription("📋 Send a custom embed")
    .addStringOption(o=>o.setName("title").setDescription("Title").setRequired(true))
    .addStringOption(o=>o.setName("body").setDescription("Body").setRequired(true))
    .addStringOption(o=>o.setName("color").setDescription("Hex color e.g. FF8FB1")),
  new SlashCommandBuilder().setName("poll").setDescription("📊 Create a poll")
    .addStringOption(o=>o.setName("question").setDescription("Question").setRequired(true))
    .addStringOption(o=>o.setName("options").setDescription("Options separated by |").setRequired(true)),
  new SlashCommandBuilder().setName("giveaway").setDescription("🎉 Start a giveaway")
    .addStringOption(o=>o.setName("duration").setDescription("e.g. 1h, 1d").setRequired(true))
    .addStringOption(o=>o.setName("prize").setDescription("Prize").setRequired(true))
    .addIntegerOption(o=>o.setName("winners").setDescription("Number of winners (default 1)").setMinValue(1).setMaxValue(10)),
  new SlashCommandBuilder().setName("addorder").setDescription("📦 Add an order (admin)")
    .addUserOption(o=>o.setName("user").setDescription("Customer").setRequired(true))
    .addStringOption(o=>o.setName("details").setDescription("Order details").setRequired(true)),
  new SlashCommandBuilder().setName("updateorder").setDescription("🔄 Update order status")
    .addIntegerOption(o=>o.setName("id").setDescription("Order ID").setRequired(true))
    .addStringOption(o=>o.setName("status").setDescription("Status").setRequired(true).addChoices(...Object.entries(ORDER_STATUSES).map(([v,s])=>({name:`${s.emoji} ${s.label}`,value:v}))))
    .addStringOption(o=>o.setName("note").setDescription("Optional note")),
  new SlashCommandBuilder().setName("complete").setDescription("✅ Mark order complete").addIntegerOption(o=>o.setName("id").setDescription("Order ID").setRequired(true)),
  new SlashCommandBuilder().setName("blacklist").setDescription("🚫 Toggle user blacklist").addUserOption(o=>o.setName("user").setDescription("User").setRequired(true)),
  new SlashCommandBuilder().setName("setlog").setDescription("📓 Set mod log channel").addChannelOption(o=>o.setName("channel").setDescription("Channel")),
  new SlashCommandBuilder().setName("setreviews").setDescription("⭐ Set reviews channel").addChannelOption(o=>o.setName("channel").setDescription("Channel")),
  new SlashCommandBuilder().setName("settranscripts").setDescription("📄 Set transcripts channel").addChannelOption(o=>o.setName("channel").setDescription("Channel")),
  new SlashCommandBuilder().setName("setverifyrole").setDescription("🟣 Set Roblox verify role").addRoleOption(o=>o.setName("role").setDescription("Role").setRequired(true)),
  new SlashCommandBuilder().setName("setlevelupchannel").setDescription("📊 Set level-up channel").addChannelOption(o=>o.setName("channel").setDescription("Channel").setRequired(true)),
  new SlashCommandBuilder().setName("ticketpanel").setDescription("🎫 Post ticket panel"),
  new SlashCommandBuilder().setName("close").setDescription("🔒 Close a ticket").addStringOption(o=>o.setName("reason").setDescription("Reason").setRequired(true)),
  new SlashCommandBuilder().setName("addnote").setDescription("📝 Add staff note to ticket").addStringOption(o=>o.setName("text").setDescription("Note").setRequired(true)),
  new SlashCommandBuilder().setName("givecoins").setDescription("💰 Give coins to a user")
    .addUserOption(o=>o.setName("user").setDescription("User").setRequired(true))
    .addIntegerOption(o=>o.setName("amount").setDescription("Amount").setMinValue(1).setRequired(true)),
  new SlashCommandBuilder().setName("backup").setDescription("💾 Server backup")
    .addSubcommand(s=>s.setName("create").setDescription("Create a backup"))
    .addSubcommand(s=>s.setName("list").setDescription("List saved backups"))
    .addSubcommand(s=>s.setName("view").setDescription("View a backup").addStringOption(o=>o.setName("id").setDescription("Backup ID").setRequired(true))),
].map(c => c.toJSON());

async function registerSlashCommands() {
  if (!CLIENT_ID || !TOKEN) return console.warn("⚠️ Skipping slash command registration");
  try {
    const rest = new REST({ version:"10" }).setToken(TOKEN);
    console.log(`📡 Registering ${slashCommands.length} slash commands…`);
    await rest.put(Routes.applicationCommands(CLIENT_ID), { body:slashCommands });
    console.log(`✅ Registered ${slashCommands.length} slash commands`);
  } catch(e) { console.error("Slash registration failed:", e.message); }
}

// ─── COMMAND EXECUTOR ─────────────────────────────────────────────────────────
async function execCommand(cmdName, ctx) {
  const {guild,member,user} = ctx;
  if(data.blacklist.includes(user.id)&&cmdName!=="blacklist")
    return ctx.reply({embeds:[E.error("🚫 You Are Blacklisted").setDescription("You are not allowed to use this bot.")]},true);
  if(CD_CONFIG[cmdName]){
    const w=checkCD(cmdName,user.id);
    if(w>0)return ctx.reply({embeds:[E.warn("⏰ Cooldown").setDescription(`Please wait **${w}s** before using this again.`)]},true);
    useCD(cmdName,user.id);
  }

  switch(cmdName){

    // ── GENERAL ──────────────────────────────────────────────────────────────
    case "help":{
      const page=ctx.getInteger("page")||parseInt(ctx.getArg(0)||"1")||1;
      return ctx.reply({embeds:[buildHelp(page)]});
    }
    case "setup":return ctx.reply({embeds:[E.brand("⚙️ Server Setup Guide")
      .setDescription("Follow these steps to fully configure the bot.")
      .addFields(
        {name:"**Step 1 — Logging**",            value:"`/setlog #ch` · `/setreviews #ch` · `/settranscripts #ch`"},
        {name:"**Step 2 — Roblox Verification**", value:"`/setverifyrole @role` then `/verifypanel #channel`"},
        {name:"**Step 3 — Tickets**",             value:"Run `/ticketpanel` in your support channel"},
        {name:"**Step 4 — Level-Up Channel**",    value:"`/setlevelupchannel #channel`"},
        {name:"**Step 5 — Scam Reports**",        value:"`/setscamchannel #channel`"},
        {name:"**Step 6 — Security**",            value:"`/antiraid enable` → configure\n`/antinuke enable` → configure\n`/antinuke trust @youradmin`"},
        {name:"**Optional .env Overrides**",      value:"`HOME_GUILD_ID` `ERROR_CHANNEL_ID` `LEVELUP_CHANNEL_ID`\n`STICKY_CHANNEL_ID` `ORDER_CHANNEL_ID` `FORUM_SUPPORT_CHANNEL_ID`"},
      ).setFooter(ft()).setTimestamp()]});

    case "info":{
      const up=process.uptime(),h=Math.floor(up/3600),m=Math.floor((up%3600)/60),s2=Math.floor(up%60);
      return ctx.reply({embeds:[E.brand(`🧸 ${BOT_NAME}`)
        .setThumbnail(client.user?.displayAvatarURL())
        .addFields(
          {name:"🤖 Tag",          value:client.user?.tag||"—",                          inline:true},
          {name:"📦 Version",      value:`v${BOT_VERSION}`,                              inline:true},
          {name:"👑 Owner",        value:BOT_OWNER,                                      inline:true},
          {name:"🌐 Servers",      value:`${client.guilds.cache.size}`,                  inline:true},
          {name:"⏱️ Uptime",       value:`${h}h ${m}m ${s2}s`,                          inline:true},
          {name:"📋 Orders",       value:`${data.orders.length}`,                        inline:true},
          {name:"🤖 AI",           value:GROQ_API_KEY?"✅ Groq":"❌ Disabled",          inline:true},
          {name:"🖼️ Images",       value:STABILITY_API_KEY?"Stability AI":"Pollinations",inline:true},
          {name:"🟣 Verified",     value:`${Object.keys(data.robloxVerified).length}`,   inline:true},
        ).setFooter(ft()).setTimestamp()]});
    }
    case "ping":{
      if(ctx.isSlash){
        const sent=await ctx.interaction.reply({embeds:[E.info("🏓 Measuring…")],fetchReply:true});
        const ms=sent.createdTimestamp-ctx.interaction.createdTimestamp;
        return ctx.interaction.editReply({embeds:[E.success("🏓 Pong!").addFields({name:"⏱️ Round-trip",value:`${ms}ms`,inline:true},{name:"💓 Gateway",value:`${Math.round(client.ws.ping)}ms`,inline:true}).setFooter(ft()).setTimestamp()]});
      }
      return ctx.reply({embeds:[E.success("🏓 Pong!").addFields({name:"💓 Gateway",value:`${Math.round(client.ws.ping)}ms`,inline:true}).setFooter(ft())]});
    }
    case "status":{
      if(ctx.isSlash)await ctx.interaction.deferReply().catch(()=>{});
      const ar=guild?getAntiRaid(guild.id):null, an=guild?getAntiNuke(guild.id):null;
      return ctx.reply({embeds:[E.success("🟢 All Systems Operational")
        .addFields(
          {name:"🤖 Bot",           value:`🟢 Online · ${Math.round(client.ws.ping)}ms`, inline:true},
          {name:"📋 Active Orders", value:`${data.orders.filter(o=>o.status!=="completed"&&o.status!=="cancelled").length}`,inline:true},
          {name:"🤖 Groq AI",       value:GROQ_API_KEY?"🟢 Ready":"🔴 No Key",         inline:true},
          {name:"🖼️ Image Gen",     value:STABILITY_API_KEY?"🟢 Stability":"🟡 Pollinations",inline:true},
          {name:"🟣 Verified",      value:`${Object.keys(data.robloxVerified).length} users`,inline:true},
          {name:"🛡️ Anti-Raid",     value:ar?.enabled?"🟢 Active":"🔴 Off",            inline:true},
          {name:"☢️ Anti-Nuke",     value:an?.enabled?"🟢 Active":"🔴 Off",            inline:true},
          {name:"🌐 Servers",       value:`${client.guilds.cache.size}`,                 inline:true},
        ).setFooter(ft()).setTimestamp()]});
    }
    case "rules":  return ctx.reply({embeds:[E.brand("📜 Server Rules").setDescription(SERVER_RULES.join("\n\n")).setFooter(ft()).setTimestamp()]});
    case "uptime": return ctx.reply({embeds:[E.brand("⏱️ Uptime").setDescription(`Online for **${fmtDuration(Math.floor(process.uptime()*1000))}**`).setFooter(ft())]});
    case "invite": return ctx.reply({embeds:[E.brand("🔗 Invite the Bot").setDescription(`[**Click here to invite ${BOT_NAME}**](https://discord.com/api/oauth2/authorize?client_id=${CLIENT_ID}&permissions=8&scope=bot%20applications.commands)`).setFooter(ft())]});

    // ── AI ────────────────────────────────────────────────────────────────────
    case "ai":{
      if(!GROQ_API_KEY)return ctx.reply({embeds:[E.error("AI Disabled").setDescription("No `GROQ_API_KEY` configured.")]},true);
      const prompt=ctx.getString("message")||ctx.getArgs().join(" ");
      if(!prompt)return ctx.reply({embeds:[E.warn("Please provide a message.")]});
      if(ctx.isSlash)await ctx.interaction.deferReply().catch(()=>{});
      else ctx.channel.sendTyping().catch(()=>{});
      if(!userChatHistory.has(user.id))userChatHistory.set(user.id,[]);
      const hist=userChatHistory.get(user.id);
      hist.push({role:"user",content:prompt});
      while(hist.length>20)hist.shift();
      const {text,model}=await callGroq(hist,SYS.chat,{maxTokens:1000,temp:0.75});
      if(!text)return ctx.reply({content:"❌ AI is currently busy — please try again shortly."});
      hist.push({role:"assistant",content:text});
      return ctx.reply({embeds:[aiEmbed(text,model,user.username,"chat")],allowedMentions:{users:[]}});
    }
    case "ai-reset":
      userChatHistory.delete(user.id);
      return ctx.reply({embeds:[E.success("✅ AI Memory Cleared").setDescription("Your conversation history has been wiped.")]},true);
    case "aioff":
    case "aion":{
      if(!isStaff(member))return ctx.reply({embeds:[E.error("Staff only.")]},true);
      if(!ctx.channel?.name?.startsWith("ticket-"))return ctx.reply({embeds:[E.warn("Only works inside ticket channels.")]},true);
      if(cmdName==="aioff")ticketAIOff.add(ctx.channel.id);
      else ticketAIOff.delete(ctx.channel.id);
      return ctx.reply({content:cmdName==="aioff"?"🔇 AI disabled for this ticket.":"🔊 AI re-enabled for this ticket."});
    }
    case "imagine":{
      const prompt=ctx.getString("prompt")||ctx.getArgs().join(" ");
      const style=ctx.getString("style")||null;
      if(!prompt)return ctx.reply({embeds:[E.warn("Please provide a prompt.")]});
      if(ctx.isSlash)await ctx.interaction.deferReply().catch(()=>{});
      else ctx.channel.sendTyping().catch(()=>{});
      try{
        const enhanced=await enhancePrompt(`${prompt}${style?`, ${IMG_STYLES[style]}`:""}`);
        const {buffer,ext,source}=await generateImage(enhanced,style);
        const ts=Date.now();
        const att=new AttachmentBuilder(buffer,{name:`snuggles-ai-${ts}.${ext}`});
        data.stats.imagesGenerated=(data.stats.imagesGenerated||0)+1; saveData();
        return ctx.reply({embeds:[E.img("🎨 Image Generated!")
          .setAuthor({name:"Snuggles AI — Image Generator",iconURL:client.user?.displayAvatarURL()})
          .setDescription(`**Prompt:** ${prompt}${style?`\n**Style:** \`${style}\``:""}\n*Enhanced with AI prompt engineering*`)
          .setImage(`attachment://snuggles-ai-${ts}.${ext}`)
          .addFields({name:"🔧 Engine",value:source,inline:true},{name:"📐 Resolution",value:"1024×1024",inline:true})
          .setFooter({text:`Snuggles AI · @${user.username}`}).setTimestamp()],files:[att]});
      }catch(e){return ctx.reply({embeds:[E.error("Image Generation Failed").setDescription(e.message)]});}
    }

    // ── COMMISSIONS ───────────────────────────────────────────────────────────
    case "services": return ctx.reply({embeds:[E.brand("🛍️ Services Offered").addFields(SERVICES).setFooter(ft()).setTimestamp()]});
    case "prices":   return ctx.reply({embeds:[E.success("💳 Pricing & Payment").addFields(...PAYMENT_INFO.methods,{name:"⚠️ Refund Policy",value:PAYMENT_INFO.note}).setFooter(ft()).setTimestamp()]});
    case "pay":      return ctx.reply({embeds:[E.brand("💸 Payment Details").addFields({name:"💵 CashApp",value:"[$siahhispaid](https://cash.app/$siahhispaid)",inline:true},{name:"🅿️ PayPal",value:"[paypal.me/snugglesscripting](https://paypal.me/snugglesscripting)",inline:true},{name:"⚠️ Important",value:"**Friends & Family only.** All sales are final — no refunds."}).setFooter(ft())]});
    case "orderinfo":{
      const id=ctx.getInteger("id")||parseInt(ctx.getArg(0),10);
      const o=findOrder(id);
      if(!o)return ctx.reply({embeds:[E.error("Order Not Found").setDescription("No order with that ID exists.")]},true);
      const si=getOrderStatus(o.status);
      const emb=E.make(si.color,`📦 Order #${o.id}`)
        .addFields(
          {name:"📊 Status",   value:`${si.emoji} ${si.label}`,                                   inline:true},
          {name:"👤 Customer", value:`<@${o.userId}>`,                                             inline:true},
          {name:"📅 Created",  value:`<t:${Math.floor(new Date(o.createdAt).getTime()/1000)}:f>`,  inline:true},
          {name:"🔄 Updated",  value:`<t:${Math.floor(new Date(o.updatedAt).getTime()/1000)}:R>`,  inline:true},
          {name:"📝 Details",  value:o.details},
        );
      if(o.note)emb.addFields({name:"📋 Staff Note",value:o.note});
      return ctx.reply({embeds:[emb.setFooter(ft()).setTimestamp()]});
    }
    case "discount":{
      const orders=data.orders.filter(o=>o.userId===user.id);
      if(!orders.length)return ctx.reply({embeds:[E.info("🎟️ Loyalty Discount").setDescription("No orders yet! After your first commission you'll receive **5% off** all future orders. 💗")]});
      return ctx.reply({embeds:[E.success("🎟️ Loyalty Discount Active!").setDescription("You qualify for **5% off** your next commission!\n\nOpen a ticket and mention this when ordering.").addFields({name:"Your Orders",value:`${orders.length} total`,inline:true}).setFooter(ft()).setTimestamp()]});
    }
    case "ticket":    return ctx.reply({embeds:[E.brand("🎫 Opening a Ticket").setDescription("Use the **ticket panel** in the support channel.\n\n📦 **Order** — Commission work *(staff reviewed)*\n🤝 **Partnership** — Partner with us *(AI handled, 45 member min)*\n❓ **Inquiry** — Questions & support *(AI 24/7)*").setFooter(ft())]});
    case "portfolio":{
      if(!data.portfolio.length)return ctx.reply({embeds:[E.brand("🎨 Portfolio").setDescription("No portfolio entries yet.").setFooter(ft())]});
      const total=data.portfolio.length;
      let page=ctx.getInteger("page")||parseInt(ctx.getArg(0)||"1")||1;
      if(page>total)page=total;
      const work=[...data.portfolio].reverse()[page-1];
      const isVid=/\.(mov|mp4|webm)(?:\?|$)/i.test(work.url||"");
      const emb=E.brand(`🎨 ${work.title||`Portfolio #${work.id}`}`).setURL(work.url).addFields({name:"🆔 ID",value:`#${work.id}`,inline:true},{name:"📁 Type",value:isVid?"🎥 Video":"🖼️ Image",inline:true}).setFooter({text:`Page ${page}/${total} · ${FOOTER}`});
      if(!isVid)emb.setImage(work.url);
      return ctx.reply({embeds:[emb]});
    }

    // ── SCRIPTING ─────────────────────────────────────────────────────────────
    case "script":{
      const t=(ctx.getString("type")||ctx.getArg(0)||"").toLowerCase();
      const ex=SCRIPT_EXAMPLES[t];
      if(!ex)return ctx.reply({embeds:[E.warn("Invalid Type").setDescription("Available: `ui` · `datastore` · `remote` · `movement` · `admin`")]},true);
      return ctx.reply({embeds:[E.brand(`📜 ${ex.title}`).setDescription("```lua\n"+ex.code+"\n```").setFooter(ft())]});
    }
    case "snippet":{
      const SNIPS=[
        {title:"Safe WaitForChild",code:`local part = workspace:WaitForChild("MyPart", 5)\nif not part then warn("MyPart did not appear!") end`},
        {title:"Smooth Tween",     code:`local TS = game:GetService("TweenService")\nlocal info = TweenInfo.new(0.5, Enum.EasingStyle.Quad)\nTS:Create(part, info, {Position = part.Position + Vector3.new(0, 5, 0)}):Play()`},
        {title:"Touch Debounce",   code:`local db = {}\npart.Touched:Connect(function(hit)\n  if db[hit.Parent] then return end\n  db[hit.Parent] = true\n  print(hit.Parent.Name, "touched!")\n  task.wait(1)\n  db[hit.Parent] = nil\nend)`},
        {title:"Iterate Players",  code:`for _, player in game.Players:GetPlayers() do\n  print(player.Name, player.UserId)\nend`},
      ];
      const s2=SNIPS[randInt(0,SNIPS.length-1)];
      return ctx.reply({embeds:[E.info(`💡 ${s2.title}`).setDescription("```lua\n"+s2.code+"\n```").setFooter(ft())]});
    }
    case "docs":  return ctx.reply({embeds:[E.brand("📚 Roblox Resources").addFields(DOCS.map(d=>({name:d.name,value:d.value}))).setFooter(ft())]});
    case "debug": return ctx.reply({embeds:[E.warn("🐛 Bug Report Template").setDescription("```\nGoal:\n<what you're trying to achieve>\n\nProblem:\n<what's going wrong>\n\nError Message:\n<paste from Output window>\n\nRelevant Code:\n<the broken section>\n\nWhat I Tried:\n<steps already attempted>\n```").setFooter(ft())]});
    case "tip":   return ctx.reply({embeds:[E.brand("💡 Scripting Tip").setDescription(TIPS[randInt(0,TIPS.length-1)]).setFooter(ft())]});

    // ── LEVELING / ECONOMY ────────────────────────────────────────────────────
    case "level":{
      const target=ctx.getUser("user")||user;
      const lv=getLv(target.id), needed=xpForLevel(lv.level);
      const prog=Math.min(20,Math.floor((lv.xp/needed)*20));
      const bar="█".repeat(prog)+"░".repeat(20-prog);
      return ctx.reply({embeds:[E.xp(`📊 Level — ${target.username}`)
        .setThumbnail(target.displayAvatarURL())
        .addFields(
          {name:"🏆 Level",    value:`${lv.level}`,           inline:true},
          {name:"✨ XP",       value:`${lv.xp} / ${needed}`,  inline:true},
          {name:"💬 Messages", value:`${lv.totalMessages||0}`, inline:true},
          {name:"📈 Progress", value:`\`${bar}\` ${Math.floor((lv.xp/needed)*100)}%`},
        ).setFooter(ft()).setTimestamp()]});
    }
    case "rank":{
      const target=ctx.getUser("user")||user;
      const lv=getLv(target.id), eco=getEco(target.id), needed=xpForLevel(lv.level);
      const sorted=Object.entries(data.leveling).sort((a,b)=>b[1].level!==a[1].level?b[1].level-a[1].level:b[1].xp-a[1].xp);
      const rank=sorted.findIndex(([id])=>id===target.id)+1;
      const roblox=data.robloxVerified[target.id];
      return ctx.reply({embeds:[E.xp(`🏅 Stats — ${target.username}`)
        .setThumbnail(target.displayAvatarURL())
        .addFields(
          {name:"🌍 Server Rank",value:rank>0?`#${rank}`:"Unranked",inline:true},
          {name:"🏆 Level",      value:`${lv.level}`,             inline:true},
          {name:"✨ XP",         value:`${lv.xp} / ${needed}`,    inline:true},
          {name:"💰 Coins",      value:`${eco.coins||0} 🪙`,      inline:true},
          {name:"💬 Messages",   value:`${lv.totalMessages||0}`,   inline:true},
          {name:"⚠️ Warnings",   value:`${(data.warns[target.id]||[]).length}`,inline:true},
          ...(roblox?[{name:"🟣 Roblox",value:`[${roblox.robloxName}](https://www.roblox.com/users/${roblox.robloxId}/profile)`,inline:true}]:[]),
        ).setFooter(ft()).setTimestamp()]});
    }
    case "leaderboard":{
      if(ctx.isSlash)await ctx.interaction.deferReply().catch(()=>{});
      const top=Object.entries(data.leveling).map(([id,d])=>({id,level:d.level||1,xp:d.xp||0})).sort((a,b)=>b.level!==a.level?b.level-a.level:b.xp-a.xp).slice(0,10);
      if(!top.length)return ctx.reply({embeds:[E.brand("📊 Leaderboard").setDescription("No data yet!").setFooter(ft())]});
      const medals=["🥇","🥈","🥉"];
      const lines=await Promise.all(top.map(async(e,i)=>{let name=`<@${e.id}>`;try{const u=await client.users.fetch(e.id);name=`**${u.username}**`;}catch{}return `${medals[i]||`**${i+1}.**`} ${name} — Level **${e.level}** · ${e.xp} XP`;}));
      return ctx.reply({embeds:[E.gold("🏆 XP Leaderboard").setDescription(lines.join("\n")).setFooter(ft()).setTimestamp()]});
    }
    case "balance":{
      const target=ctx.getUser("user")||user;
      const eco=getEco(target.id);
      const items=(eco.inventory||[]).map(id=>SHOP_ITEMS.find(i=>i.id===id)?.emoji||id).join(" ")||"None";
      return ctx.reply({embeds:[E.gold(`💰 Balance — ${target.username}`)
        .setThumbnail(target.displayAvatarURL())
        .addFields({name:"💰 Coins",value:`${eco.coins||0} 🪙`,inline:true},{name:"🎒 Inventory",value:items,inline:true})
        .setFooter(ft()).setTimestamp()]});
    }
    case "dowork":{
      const eco=getEco(user.id);
      const job=WORK_RESPONSES[randInt(0,WORK_RESPONSES.length-1)];
      const earned=randInt(job.range[0],job.range[1]);
      eco.coins=(eco.coins||0)+earned; saveData();
      return ctx.reply({embeds:[E.success("💼 Work Complete!")
        .setDescription(`> *${job.text}*\n\n**+${earned} 🪙 earned!**`)
        .addFields({name:"💰 New Balance",value:`${eco.coins} 🪙`,inline:true})
        .setFooter(ft()).setTimestamp()]});
    }
    case "daily":{
      const uid=user.id, last=data.dailyClaims[uid]||0, elapsed=Date.now()-last;
      if(elapsed<86400000){const r=86400000-elapsed;return ctx.reply({embeds:[E.warn("⏰ Already Claimed").setDescription(`Come back in **${Math.floor(r/3600000)}h ${Math.floor((r%3600000)/60000)}m**!`)]},true);}
      data.dailyClaims[uid]=Date.now();
      const reward=DAILY_REWARDS[randInt(0,DAILY_REWARDS.length-1)];
      getEco(uid).coins=(getEco(uid).coins||0)+reward.coins; saveData();
      return ctx.reply({embeds:[E.success("🎁 Daily Reward Claimed!").setDescription(`${reward.text}\n\n**+${reward.coins} 🪙**`).setFooter(ft()).setTimestamp()]});
    }
    case "shop":return ctx.reply({embeds:[E.gold("🛒 Coin Shop").setDescription("Use `s!buy <id>` or `/buy <id>` to purchase.").addFields(SHOP_ITEMS.map(i=>({name:`${i.emoji} ${i.name} — ${i.price} 🪙`,value:`${i.desc}\n\`ID: ${i.id}\``}))).setFooter(ft()).setTimestamp()]});
    case "buy":{
      const id=(ctx.getString("item")||ctx.getArg(0)||"").toLowerCase();
      const item=SHOP_ITEMS.find(i=>i.id===id);
      if(!item)return ctx.reply({embeds:[E.error("Item Not Found").setDescription("Use `s!shop` to browse available items.")]},true);
      const eco=getEco(user.id);
      if((eco.coins||0)<item.price)return ctx.reply({embeds:[E.error("Insufficient Coins").setDescription(`You need **${item.price} 🪙** but only have **${eco.coins||0} 🪙**.`)]},true);
      if((eco.inventory||[]).includes(id))return ctx.reply({embeds:[E.warn("Already Owned").setDescription("You already own this item.")]},true);
      eco.coins-=item.price; if(!eco.inventory)eco.inventory=[]; eco.inventory.push(id); saveData();
      return ctx.reply({embeds:[E.success(`✅ Purchased — ${item.emoji} ${item.name}`)
        .addFields({name:"How to Redeem",value:item.desc},{name:"Remaining Balance",value:`${eco.coins} 🪙`,inline:true})
        .setFooter(ft()).setTimestamp()]});
    }

    // ── REVIEWS ───────────────────────────────────────────────────────────────
    case "review":{
      if(!guild)return ctx.reply({embeds:[E.error("Server only.")]},true);
      const rating=ctx.getInteger("rating")||parseInt(ctx.getArg(0),10);
      const type=ctx.getString("type")||ctx.getArg(1)||"General";
      const txt=ctx.getString("message")||ctx.getArgs().slice(2).join(" ");
      if(!rating||rating<1||rating>5)return ctx.reply({embeds:[E.warn("Rating must be between 1 and 5.")]},true);
      if(!txt||txt.length<10)return ctx.reply({embeds:[E.error("Review must be at least 10 characters.")]},true);
      const ck=`review:${user.id}:${guild.id}`, last=_cds.get(ck)||0;
      if(Date.now()-last<3600000&&last!==0)return ctx.reply({embeds:[E.warn("⏰ Review cooldown (1hr)")]},true);
      _cds.set(ck,Date.now());
      const rev={id:data.nextReviewId++,userId:user.id,username:user.tag,commissionType:type,rating,message:txt,at:new Date().toISOString()};
      data.reviews.push(rev); data.stats.reviewsSubmitted=(data.stats.reviewsSubmitted||0)+1; saveData();
      const stars="⭐".repeat(rating)+"☆".repeat(5-rating);
      const emb=E.brand("⭐ New Review").setThumbnail(user.displayAvatarURL())
        .addFields({name:"👤 From",value:user.tag,inline:true},{name:"🛠️ Type",value:type,inline:true},{name:"📊 Rating",value:stars,inline:true},{name:"💬 Review",value:txt})
        .setFooter(ft()).setTimestamp();
      const s2=getSettings(guild.id);
      if(s2.reviewsChannelId){const ch=await guild.channels.fetch(s2.reviewsChannelId).catch(()=>null);if(ch?.isTextBased()){await ch.send({embeds:[emb]});return ctx.reply({embeds:[E.success("✅ Review Submitted!").setDescription(`Posted in <#${s2.reviewsChannelId}>! 💗`)]});}}
      return ctx.reply({embeds:[emb]});
    }
    case "vouch":{
      if(!guild)return ctx.reply({embeds:[E.error("Server only.")]},true);
      const t=ctx.getString("text")||ctx.getArgs().join(" ");
      if(!t)return ctx.reply({embeds:[E.warn("Usage: `s!vouch <text>`")]},true);
      const emb=E.success("✅ Vouch").setDescription(`> ${t}`).setThumbnail(user.displayAvatarURL()).setFooter({text:`by ${user.tag}`}).setTimestamp();
      const s2=getSettings(guild.id);
      if(s2.reviewsChannelId){const ch=await guild.channels.fetch(s2.reviewsChannelId).catch(()=>null);if(ch?.isTextBased()){await ch.send({embeds:[emb]});return ctx.reply({embeds:[E.success("✅ Vouch Posted!")]});}}
      return ctx.reply({embeds:[emb]});
    }

    // ── FUN ───────────────────────────────────────────────────────────────────
    case "quote":    return ctx.reply({embeds:[E.brand("💭 Quote").setDescription(`*"${QUOTES[randInt(0,QUOTES.length-1)]}"*`).setFooter(ft())]});
    case "meme":{
      try{const r=await fetch("https://meme-api.com/gimme/wholesomememes");const m=await r.json();if(m.nsfw||m.spoiler)throw new Error();return ctx.reply({embeds:[E.brand(m.title||"😂 Meme").setURL(m.postLink).setImage(m.url).setFooter(ft())]});}
      catch{return ctx.reply({embeds:[E.error("Couldn't load a meme. Try again!")]});}
    }
    case "8ball":{
      const q=ctx.getString("question")||ctx.getArgs().join(" ");
      if(!q)return ctx.reply({embeds:[E.warn("Usage: `s!8ball <question>`")]},true);
      const ans=EIGHT_BALL[randInt(0,EIGHT_BALL.length-1)];
      const positive=EIGHT_BALL.indexOf(ans)<5;
      return ctx.reply({embeds:[E.make(positive?C.success:C.error,"🎱 Magic 8-Ball")
        .addFields({name:"❓ Question",value:q.slice(0,1000)},{name:"🎱 Answer",value:`**${ans}**`})
        .setFooter(ft())]});
    }
    case "rate":{
      const t=ctx.getString("thing")||ctx.getArgs().join(" ");
      if(!t)return ctx.reply({embeds:[E.warn("Usage: `s!rate <thing>`")]},true);
      const s2=randInt(0,10);
      const e=s2>=8?"🔥 Incredible":s2>=6?"😊 Pretty Good":s2>=4?"😐 Meh":s2>=2?"😬 Not Great":"💀 Terrible";
      return ctx.reply({embeds:[E.brand("📊 Rate-O-Meter").setDescription(`**${t}**\n\n${e} — **${s2}/10**\n\`${"█".repeat(s2)}${"░".repeat(10-s2)}\``).setFooter(ft())]});
    }
    case "coinflip":{const r=Math.random()<.5?"Heads":"Tails";return ctx.reply({embeds:[E.brand("🪙 Coin Flip").setDescription(`**${r}!** ${r==="Heads"?"👑":"🌊"}`).setFooter(ft())]});}
    case "roll":{const max=ctx.getInteger("max")||parseInt(ctx.getArg(0)||"6")||6;return ctx.reply({embeds:[E.brand("🎲 Dice Roll").setDescription(`You rolled **${randInt(1,max)}** *(1–${max})*`).setFooter(ft())]});}
    case "rps":{
      const pick=(ctx.getString("choice")||ctx.getArg(0)||"").toLowerCase();
      if(!["rock","paper","scissors"].includes(pick))return ctx.reply({embeds:[E.warn("Choose: `rock`, `paper`, or `scissors`")]},true);
      const choices=["rock","paper","scissors"],emoji={rock:"🪨",paper:"📄",scissors:"✂️"};
      const bot2=choices[randInt(0,2)];
      const win=(pick==="rock"&&bot2==="scissors")||(pick==="paper"&&bot2==="rock")||(pick==="scissors"&&bot2==="paper");
      const outcome=pick===bot2?"🤝 It's a tie!":win?"🎉 You win!":"🤖 I win!";
      return ctx.reply({embeds:[E.make(pick===bot2?C.warn:win?C.success:C.error,"🎮 Rock · Paper · Scissors")
        .addFields({name:"Your Pick",value:`${emoji[pick]} ${pick}`,inline:true},{name:"My Pick",value:`${emoji[bot2]} ${bot2}`,inline:true},{name:"Result",value:outcome})
        .setFooter(ft())]});
    }
    case "trivia":{
      if(!guild)return ctx.reply({embeds:[E.error("Server only.")]},true);
      if(data.triviaActive[ctx.channel.id])return ctx.reply({embeds:[E.warn("Trivia already active in this channel!")]},true);
      const q=TRIVIA[randInt(0,TRIVIA.length-1)];
      const coins=randInt(50,100);
      data.triviaActive[ctx.channel.id]={q:q.q,answers:q.a,coins}; saveData();
      await ctx.reply({embeds:[E.info("🧠 Scripting Trivia!").setDescription(`**${q.q}**\n\n> *Hint: ${q.hint}*`).addFields({name:"💰 Prize",value:`${coins} 🪙`,inline:true},{name:"⏰ Time Limit",value:"60 seconds",inline:true}).setFooter(ft())]});
      setTimeout(async()=>{if(data.triviaActive[ctx.channel.id]){delete data.triviaActive[ctx.channel.id];saveData();ctx.channel.send({embeds:[E.warn("⏰ Trivia Timed Out").setDescription(`The answer was: **${q.a[0]}**`).setFooter(ft())]}).catch(()=>{});}},60000);
      break;
    }
    case "remindme":{
      const timeStr=ctx.getString("time")||ctx.getArg(0);
      const text=ctx.getString("message")||ctx.getArgs().slice(1).join(" ");
      if(!timeStr||!text)return ctx.reply({embeds:[E.warn("Usage: `s!remindme 10m <message>`")]},true);
      const ms=parseDuration(timeStr);
      if(!ms||ms>7*TIME.d)return ctx.reply({embeds:[E.error("Invalid duration. Max is 7 days.")]},true);
      await ctx.reply({embeds:[E.success("⏰ Reminder Set!").setDescription(`I'll ping you in **${fmtDuration(ms)}**\n> ${text}`).setFooter(ft())]});
      setTimeout(()=>ctx.channel.send({content:`<@${user.id}>`,embeds:[E.brand("⏰ Reminder!").setDescription(`> ${text}`).setFooter(ft()).setTimestamp()]}).catch(()=>{}),ms);
      break;
    }
    case "color":{
      const hex=(ctx.getString("hex")||ctx.getArg(0)||"").replace("#","").trim();
      if(!/^[0-9A-Fa-f]{6}$/.test(hex))return ctx.reply({embeds:[E.warn("Invalid hex code. Example: `FF8FB1`")]},true);
      const r=parseInt(hex.slice(0,2),16),g=parseInt(hex.slice(2,4),16),b=parseInt(hex.slice(4,6),16);
      return ctx.reply({embeds:[E.make(parseInt(hex,16),`🎨 #${hex.toUpperCase()}`)
        .addFields({name:"HEX",value:`#${hex.toUpperCase()}`,inline:true},{name:"RGB",value:`rgb(${r}, ${g}, ${b})`,inline:true},{name:"INT",value:`${parseInt(hex,16)}`,inline:true})
        .setImage(`https://singlecolorimage.com/get/${hex}/300x80`).setFooter(ft())]});
    }
    case "calc":{
      const expr=(ctx.getString("expression")||ctx.getArgs().join(" ")||"").replace(/[^0-9+\-*/.() %^]/g,"");
      if(!expr)return ctx.reply({embeds:[E.warn("Usage: `s!calc 2+2`")]},true);
      try{
        // eslint-disable-next-line no-new-func
        const result=Function('"use strict";return('+expr+')')();
        if(!isFinite(result))throw new Error("Not finite");
        return ctx.reply({embeds:[E.brand("🧮 Calculator").addFields({name:"Expression",value:`\`${expr}\``,inline:true},{name:"Result",value:`\`${result}\``,inline:true}).setFooter(ft())]});
      }catch{return ctx.reply({embeds:[E.error("Invalid expression.")]},true);}
    }

    // ── INFO ──────────────────────────────────────────────────────────────────
    case "userinfo":{
      if(!guild)return ctx.reply({embeds:[E.error("Server only.")]},true);
      const target=ctx.getUser("user")||user;
      const gm=await guild.members.fetch(target.id).catch(()=>null);
      const lv=getLv(target.id), eco=getEco(target.id);
      const emb=E.brand(`👤 ${target.username}`).setThumbnail(target.displayAvatarURL({size:256}))
        .addFields({name:"🆔 User ID",value:target.id,inline:true},{name:"🤖 Bot",value:target.bot?"Yes":"No",inline:true},{name:"📅 Account Created",value:`<t:${Math.floor(target.createdTimestamp/1000)}:F>`});
      if(gm){
        if(gm.joinedTimestamp)emb.addFields({name:"📥 Joined Server",value:`<t:${Math.floor(gm.joinedTimestamp/1000)}:F>`});
        const roles=gm.roles.cache.filter(r=>r.id!==guild.id).sort((a,b)=>b.position-a.position).map(r=>`<@&${r.id}>`).slice(0,15);
        if(roles.length)emb.addFields({name:`🎭 Roles [${gm.roles.cache.size-1}]`,value:roles.join(" ")});
        emb.addFields({name:"🏆 Level",value:`${lv.level}`,inline:true},{name:"✨ XP",value:`${lv.xp}`,inline:true},{name:"💰 Coins",value:`${eco.coins||0} 🪙`,inline:true},{name:"⚠️ Warnings",value:`${(data.warns[target.id]||[]).length}`,inline:true});
      }
      const roblox=data.robloxVerified[target.id];
      if(roblox)emb.addFields({name:"🟣 Roblox Account",value:`[${roblox.robloxName}](https://www.roblox.com/users/${roblox.robloxId}/profile)`,inline:true});
      return ctx.reply({embeds:[emb.setFooter(ft()).setTimestamp()]});
    }
    case "serverinfo":{
      if(!guild)return ctx.reply({embeds:[E.error("Server only.")]},true);
      if(ctx.isSlash)await ctx.interaction.deferReply().catch(()=>{});
      const owner=await guild.fetchOwner().catch(()=>null);
      const chs=guild.channels.cache;
      const verMap={0:"None",1:"Low",2:"Medium",3:"High",4:"Very High"};
      return ctx.reply({embeds:[E.brand(`🏠 ${guild.name}`)
        .setThumbnail(guild.iconURL({size:256})||null)
        .addFields(
          {name:"🆔 Server ID",     value:guild.id,                                               inline:true},
          {name:"👑 Owner",         value:owner?.user.tag||"—",                                   inline:true},
          {name:"📅 Created",       value:`<t:${Math.floor(guild.createdTimestamp/1000)}:F>`},
          {name:"👥 Members",       value:`${guild.memberCount}`,                                 inline:true},
          {name:"🎭 Roles",         value:`${guild.roles.cache.size}`,                            inline:true},
          {name:"😄 Emojis",        value:`${guild.emojis.cache.size}`,                           inline:true},
          {name:"💬 Text Channels", value:`${chs.filter(c=>c.type===ChannelType.GuildText).size}`,inline:true},
          {name:"🔊 Voice Channels",value:`${chs.filter(c=>c.type===ChannelType.GuildVoice).size}`,inline:true},
          {name:"🛡️ Verification",  value:verMap[guild.verificationLevel]||"—",                  inline:true},
        ).setFooter(ft()).setTimestamp()]});
    }
    case "avatar":{const target=ctx.getUser("user")||user;const url=target.displayAvatarURL({size:1024,extension:"png"});return ctx.reply({embeds:[E.brand(`🖼️ ${target.username}'s Avatar`).setURL(url).setImage(url).setFooter(ft())]});}
    case "banner":{const target=ctx.getUser("user")||user;const u2=await client.users.fetch(target.id,{force:true}).catch(()=>null);if(!u2?.bannerURL())return ctx.reply({embeds:[E.warn("This user has no banner.")]},true);const url=u2.bannerURL({size:1024});return ctx.reply({embeds:[E.brand(`🖼️ ${u2.username}'s Banner`).setURL(url).setImage(url).setFooter(ft())]});}
    case "servericon":{if(!guild?.iconURL())return ctx.reply({embeds:[E.error("This server has no icon.")]},true);const url=guild.iconURL({size:1024,extension:"png"});return ctx.reply({embeds:[E.brand(`🖼️ ${guild.name}`).setURL(url).setImage(url).setFooter(ft())]});}
    case "stats":{
      const done=data.orders.filter(o=>o.status==="completed").length;
      const avg=data.reviews.length?(data.reviews.reduce((s2,r)=>s2+r.rating,0)/data.reviews.length).toFixed(2):"—";
      return ctx.reply({embeds:[E.brand("📈 Bot Statistics")
        .addFields(
          {name:"📋 Active Orders",    value:`${data.orders.filter(o=>o.status!=="completed"&&o.status!=="cancelled").length}`,inline:true},
          {name:"✅ Completed",        value:`${done}`,                              inline:true},
          {name:"🎟️ Tickets Opened",  value:`${data.stats.ticketsOpened||0}`,       inline:true},
          {name:"⭐ Reviews",          value:`${data.reviews.length} (avg ${avg}⭐)`,inline:true},
          {name:"🖼️ Images Generated",value:`${data.stats.imagesGenerated||0}`,     inline:true},
          {name:"🟣 Verified Users",   value:`${Object.keys(data.robloxVerified).length}`,inline:true},
        ).setFooter(ft()).setTimestamp()]});
    }
    case "invites":{
      if(!guild)return ctx.reply({embeds:[E.error("Server only.")]},true);
      const target=ctx.getUser("user")||user;
      const inv=(data.invites[guild.id]||{})[target.id]||{invited:0,left:0};
      return ctx.reply({embeds:[E.info(`📨 Invites — ${target.username}`).addFields({name:"📬 Total Invited",value:`${inv.invited}`,inline:true},{name:"🚪 Left",value:`${inv.left}`,inline:true},{name:"✅ Net",value:`${inv.invited-inv.left}`,inline:true}).setFooter(ft()).setTimestamp()]});
    }
    case "inviteleaderboard":{
      if(!guild)return ctx.reply({embeds:[E.error("Server only.")]},true);
      const inv=data.invites[guild.id]||{};
      const entries=Object.entries(inv).map(([id,d])=>({id,net:d.invited-d.left})).sort((a,b)=>b.net-a.net).slice(0,10);
      return ctx.reply({embeds:[E.gold("📨 Invite Leaderboard").setDescription(entries.length?entries.map((e,i)=>`**${i+1}.** <@${e.id}> — **${e.net}** net invites`).join("\n"):"No invite data.").setFooter(ft()).setTimestamp()]});
    }

    // ── ROBLOX VERIFICATION ───────────────────────────────────────────────────
    case "verify":{
      const username=ctx.getString("username")||ctx.getArg(0);
      if(!username)return ctx.reply({embeds:[E.warn("Usage: `s!verify <robloxUsername>`")]},true);
      if(ctx.isSlash)await ctx.interaction.deferReply({flags:MessageFlags.Ephemeral}).catch(()=>{});
      else ctx.channel.sendTyping().catch(()=>{});
      const robloxUser=await fetchRobloxUser(username);
      if(!robloxUser)return ctx.reply({embeds:[E.error("Roblox User Not Found").setDescription(`Could not find **${username}** on Roblox. Check the spelling.`)]},true);
      const code=genVerifyCode();
      data.verificationCodes[user.id]={code,robloxName:robloxUser.name,robloxId:robloxUser.id,expiresAt:Date.now()+10*60000}; saveData();
      return ctx.reply({embeds:[E.roblox("🟣 Roblox Verification — Step 1")
        .setDescription([
          `**Found:** [${robloxUser.name}](https://www.roblox.com/users/${robloxUser.id}/profile) *(ID: \`${robloxUser.id}\`)*\n`,
          "**How to Verify:**",
          "① Copy the code below",
          "② Go to [roblox.com/my/account](https://www.roblox.com/my/account) → **About** tab",
          "③ Paste the code anywhere in your bio and **save**",
          "④ Run `/checkverify <code>` here\n",
          "> ⏰ Code expires in **10 minutes**",
        ].join("\n"))
        .addFields({name:"🔑 Your Verification Code",value:`\`\`\`${code}\`\`\``})
        .setFooter({text:"Paste in Roblox bio → /checkverify"}).setTimestamp()]},true);
    }
    case "checkverify":{
      const code=(ctx.getString("code")||ctx.getArg(0)||"").toUpperCase();
      if(!code)return ctx.reply({embeds:[E.warn("Usage: `s!checkverify <code>`")]},true);
      if(ctx.isSlash)await ctx.interaction.deferReply({flags:MessageFlags.Ephemeral}).catch(()=>{});
      const pending=data.verificationCodes[user.id];
      if(!pending)return ctx.reply({embeds:[E.error("No Pending Verification").setDescription("Start with `/verify <username>` first.")]},true);
      if(Date.now()>pending.expiresAt){delete data.verificationCodes[user.id];saveData();return ctx.reply({embeds:[E.error("Code Expired").setDescription("Run `/verify` again to get a new code.")]},true);}
      if(code!==pending.code)return ctx.reply({embeds:[E.error("Incorrect Code").setDescription(`Your code is: \`${pending.code}\``)]},true);
      const profile=await fetchRobloxProfile(pending.robloxId);
      if(!profile||!profile.description.includes(pending.code))
        return ctx.reply({embeds:[E.warn("Code Not Found in Bio").setDescription(`We checked **${pending.robloxName}**'s profile but couldn't find the code.\n\nMake sure \`${pending.code}\` is in your **About** section, save it, then try again.`)]},true);
      const avatar=await fetchRobloxAvatar(pending.robloxId);
      data.robloxVerified[user.id]={robloxId:pending.robloxId,robloxName:pending.robloxName,robloxDisplayName:profile.displayName,verifiedAt:new Date().toISOString(),discordTag:user.tag};
      delete data.verificationCodes[user.id]; saveData();
      if(guild){
        const gm=await guild.members.fetch(user.id).catch(()=>null);
        if(gm){
          // Update nickname to Roblox display name
          await gm.setNickname(profile.displayName||pending.robloxName,"Roblox verification").catch(()=>{});
          const s2=getSettings(guild.id);
          if(s2.verifyRoleId){const role=guild.roles.cache.get(s2.verifyRoleId);if(role)gm.roles.add(role,"Roblox Verified").catch(()=>{});}
        }
      }
      const emb=E.success("✅ Roblox Account Verified!")
        .setDescription(`You are now verified as **[${pending.robloxName}](https://www.roblox.com/users/${pending.robloxId}/profile)**!\n\nYour nickname has been updated to your Roblox display name.`)
        .addFields({name:"🟣 Roblox Username",value:pending.robloxName,inline:true},{name:"🆔 Roblox ID",value:`${pending.robloxId}`,inline:true})
        .setFooter(ft()).setTimestamp();
      if(avatar)emb.setThumbnail(avatar);
      return ctx.reply({embeds:[emb]},true);
    }
    case "whois":{
      const target=ctx.getUser("user")||user;
      const roblox=data.robloxVerified[target.id];
      if(!roblox)return ctx.reply({embeds:[E.warn("Not Verified").setDescription(`**${target.username}** has not linked a Roblox account.\n\nThey can use \`/verify <username>\` to do so.`)]},true);
      if(ctx.isSlash)await ctx.interaction.deferReply().catch(()=>{});
      const profile=await fetchRobloxProfile(roblox.robloxId);
      const avatar=await fetchRobloxAvatar(roblox.robloxId);
      const emb=E.roblox(`🟣 Roblox Profile — ${target.username}`)
        .setThumbnail(avatar||target.displayAvatarURL())
        .setURL(`https://www.roblox.com/users/${roblox.robloxId}/profile`)
        .addFields(
          {name:"🟣 Roblox Username",value:`[${roblox.robloxName}](https://www.roblox.com/users/${roblox.robloxId}/profile)`,inline:true},
          {name:"🆔 Roblox ID",      value:`${roblox.robloxId}`,                                                              inline:true},
          {name:"✅ Verified",       value:`<t:${Math.floor(new Date(roblox.verifiedAt).getTime()/1000)}:R>`,                 inline:true},
        );
      if(profile){
        if(profile.displayName&&profile.displayName!==profile.name)emb.addFields({name:"📛 Display Name",value:profile.displayName,inline:true});
        if(profile.friendCount!=null)emb.addFields({name:"👥 Friends",        value:`${profile.friendCount}`,inline:true});
        if(profile.followerCount!=null)emb.addFields({name:"👁️ Followers",    value:`${profile.followerCount}`,inline:true});
        if(profile.created)           emb.addFields({name:"📅 Account Created",value:`<t:${Math.floor(new Date(profile.created).getTime()/1000)}:D>`,inline:true});
        if(profile.description)       emb.addFields({name:"📝 About",          value:profile.description.slice(0,300)+(profile.description.length>300?"…":"")});
        if(profile.isBanned)          emb.addFields({name:"⚠️ Status",         value:"⛔ This account is **banned**."});
      }
      return ctx.reply({embeds:[emb.setFooter(ft()).setTimestamp()]});
    }
    case "unverify":{
      if(!data.robloxVerified[user.id])return ctx.reply({embeds:[E.warn("You don't have a linked Roblox account.")]},true);
      const name=data.robloxVerified[user.id].robloxName;
      delete data.robloxVerified[user.id]; saveData();
      return ctx.reply({embeds:[E.success("✅ Roblox Account Unlinked").setDescription(`**${name}** has been unlinked from your Discord account.`).setFooter(ft())]});
    }
    case "verifypanel":{
      if(!guild)return ctx.reply({embeds:[E.error("Server only.")]},true);
      if(!isAdmin(member))return ctx.reply({embeds:[E.error("Administrator only.")]},true);
      const ch=ctx.getChannel("channel")||guild.channels.cache.get(ctx.getArg(0)?.replace(/[<#>]/g,""));
      if(!ch?.isTextBased())return ctx.reply({embeds:[E.warn("Please provide a valid text channel.")]},true);
      const {emb,row}=buildVerifyPanel();
      await ch.send({embeds:[emb],components:[row]});
      return ctx.reply({embeds:[E.success(`✅ Verification panel posted in <#${ch.id}>!`).setFooter(ft())]});
    }

    // ── SCAM REPORTS ──────────────────────────────────────────────────────────
    case "reportscammer":{
      if(!guild)return ctx.reply({embeds:[E.error("Server only.")]},true);
      if(!isStaff(member))return ctx.reply({embeds:[E.error("Staff only.")]},true);
      if(ctx.isSlash)await ctx.interaction.deferReply({flags:MessageFlags.Ephemeral}).catch(()=>{});
      const target=ctx.getUser("user");if(!target)return ctx.reply({embeds:[E.warn("Provide a user.")]},true);
      const evidence=ctx.getString("evidence")||ctx.getArgs().slice(1).join(" ")||"No evidence provided";
      const amount=ctx.getString("amount")||"Unknown";
      const roblox=ctx.getString("roblox")||"Unknown";
      const report={id:data.nextScamId++,userId:target.id,userTag:target.tag,robloxName:roblox,evidence,amount,reportedBy:user.id,reporterTag:user.tag,guildId:guild.id,at:new Date().toISOString()};
      data.scamReports.push(report); saveData();
      const emb=E.scam(`🚨 Scammer Report #${report.id}`)
        .setThumbnail(target.displayAvatarURL())
        .setDescription("⚠️ **DO NOT** pay, trade with, or engage with this person.")
        .addFields(
          {name:"👤 Discord",        value:`${target.tag} (<@${target.id}>)`,     inline:true},
          {name:"🆔 Discord ID",     value:target.id,                              inline:true},
          {name:"🟣 Roblox",         value:roblox,                                 inline:true},
          {name:"💸 Amount Scammed", value:amount,                                 inline:true},
          {name:"🔖 Reported By",    value:user.tag,                               inline:true},
          {name:"📅 Date",           value:`<t:${Math.floor(Date.now()/1000)}:F>`, inline:true},
          {name:"📋 Evidence",       value:evidence},
        ).setFooter(ft()).setTimestamp();
      const s2=getSettings(guild.id);
      if(s2.scamChannelId){const ch=await guild.channels.fetch(s2.scamChannelId).catch(()=>null);if(ch?.isTextBased()){await ch.send({embeds:[emb]});return ctx.reply({embeds:[E.success(`✅ Report #${report.id} posted in <#${s2.scamChannelId}>`)]});}}
      await ctx.reply({embeds:[E.warn("No scam channel set. Use `/setscamchannel`.")]});
      await ctx.channel.send({embeds:[emb]});
      break;
    }
    case "scammerlist":{
      if(!data.scamReports.length)return ctx.reply({embeds:[E.success("✅ No Reports").setDescription("No scammers have been reported.").setFooter(ft())]});
      const recent=data.scamReports.slice(-10).reverse();
      return ctx.reply({embeds:[E.scam("🚨 Recent Scam Reports").setDescription(recent.map(r=>`**#${r.id}** — ${r.userTag} · Roblox: \`${r.robloxName}\` · Amount: ${r.amount}`).join("\n")).setFooter({text:`${data.scamReports.length} total reports · ${FOOTER}`}).setTimestamp()]});
    }
    case "setscamchannel":{
      if(!isAdmin(member))return ctx.reply({embeds:[E.error("Administrator only.")]},true);
      const ch=ctx.getChannel("channel");if(!ch)return ctx.reply({embeds:[E.warn("Usage: `/setscamchannel #channel`")]},true);
      getSettings(guild.id).scamChannelId=ch.id; saveData();
      return ctx.reply({embeds:[E.success("✅ Scam Channel Set").setDescription(`Reports will be posted in <#${ch.id}>`).setFooter(ft())]});
    }

    // ── REACTION ROLES ────────────────────────────────────────────────────────
    case "reactionrole":{
      if(!guild)return ctx.reply({embeds:[E.error("Server only.")]},true);
      if(!isAdmin(member)&&!hasPerm(member,PermissionFlagsBits.ManageRoles))return ctx.reply({embeds:[E.error("You need **Manage Roles** permission.")]},true);
      const sub=ctx.getSubcommand()||ctx.getArg(0)||"";
      if(sub==="add"){
        const msgId=ctx.getString("messageid")||ctx.getArg(1);
        const emoji=ctx.getString("emoji")||ctx.getArg(2);
        const role=ctx.getRole("role")||ctx.getMentionRole(3);
        if(!msgId||!emoji||!role)return ctx.reply({embeds:[E.warn("Usage: `s!reactionrole add <msgId> <emoji> <@role>`")]},true);
        let targetMsg=null;
        for(const ch of guild.channels.cache.filter(c=>c.isTextBased()).values()){try{targetMsg=await ch.messages.fetch(msgId);if(targetMsg)break;}catch{}}
        if(!targetMsg)return ctx.reply({embeds:[E.error("Message not found.")]},true);
        if(!data.reactionRoles[guild.id])data.reactionRoles[guild.id]={};
        if(!data.reactionRoles[guild.id][msgId])data.reactionRoles[guild.id][msgId]={};
        data.reactionRoles[guild.id][msgId][emoji]=role.id; saveData();
        await targetMsg.react(emoji).catch(()=>{});
        return ctx.reply({embeds:[E.success("✅ Reaction Role Added").addFields({name:"Message",value:`[Jump](${targetMsg.url})`,inline:true},{name:"Emoji",value:emoji,inline:true},{name:"Role",value:`<@&${role.id}>`,inline:true}).setFooter(ft())]});
      }
      if(sub==="remove"){
        const msgId=ctx.getString("messageid")||ctx.getArg(1);
        const emoji=ctx.getString("emoji")||ctx.getArg(2);
        if(!msgId||!emoji)return ctx.reply({embeds:[E.warn("Usage: `s!reactionrole remove <msgId> <emoji>`")]},true);
        if(data.reactionRoles[guild.id]?.[msgId]?.[emoji]){delete data.reactionRoles[guild.id][msgId][emoji];if(!Object.keys(data.reactionRoles[guild.id][msgId]).length)delete data.reactionRoles[guild.id][msgId];saveData();return ctx.reply({embeds:[E.success("✅ Reaction Role Removed")]});}
        return ctx.reply({embeds:[E.error("Reaction role not found.")]},true);
      }
      if(sub==="list"){
        const gRR=data.reactionRoles[guild.id];
        if(!gRR||!Object.keys(gRR).length)return ctx.reply({embeds:[E.info("No reaction roles configured yet.")]});
        const lines=[];
        for(const [msgId,emojis] of Object.entries(gRR)){lines.push(`**Message \`${msgId}\`**`);for(const [e,rId]of Object.entries(emojis))lines.push(`  ${e} → <@&${rId}>`);}
        return ctx.reply({embeds:[E.info("🎭 Reaction Roles").setDescription(lines.join("\n")).setFooter(ft()).setTimestamp()]});
      }
      if(sub==="panel"){
        const title=ctx.getString("title")||ctx.getArgs().slice(1,2).join(" ");
        const desc=ctx.getString("description")||ctx.getArgs().slice(2).join(" ");
        if(!title||!desc)return ctx.reply({embeds:[E.warn("Usage: `s!reactionrole panel <title> <description>`")]},true);
        if(ctx.isSlash)await ctx.interaction.deferReply({flags:MessageFlags.Ephemeral}).catch(()=>{});
        const sent=await ctx.channel.send({embeds:[E.brand(title).setDescription(`${desc}\n\n*React below to receive a role!*`).setFooter(ft()).setTimestamp()]});
        return ctx.reply({content:`✅ Panel posted! Add roles with \`s!reactionrole add ${sent.id} <emoji> <@role>\``,flags:MessageFlags.Ephemeral});
      }
      return ctx.reply({embeds:[E.warn("Subcommands: `add` · `remove` · `list` · `panel`")]},true);
    }

    // ── ANTI-RAID ─────────────────────────────────────────────────────────────
    case "antiraid":{
      if(!guild)return ctx.reply({embeds:[E.error("Server only.")]},true);
      if(!isAdmin(member))return ctx.reply({embeds:[E.error("Administrator only.")]},true);
      const sub=ctx.getSubcommand()||ctx.getArg(0)||"";
      const s=getAntiRaid(guild.id);
      if(sub==="enable") {s.enabled=true;saveData();return ctx.reply({embeds:[E.success("🛡️ Anti-Raid Enabled").addFields({name:"Threshold",value:`${s.threshold} joins`,inline:true},{name:"Window",value:`${s.window/1000}s`,inline:true},{name:"Action",value:s.action.toUpperCase(),inline:true}).setFooter(ft())]});}
      if(sub==="disable"){s.enabled=false;saveData();return ctx.reply({embeds:[E.warn("🛡️ Anti-Raid Disabled").setFooter(ft())]});}
      if(sub==="status"){
        return ctx.reply({embeds:[E.make(s.enabled?C.success:C.warn,`🛡️ Anti-Raid — ${s.enabled?"🟢 Active":"🔴 Disabled"}`)
          .addFields(
            {name:"⚡ Trigger Threshold",    value:`**${s.threshold}** joins`,             inline:true},
            {name:"⏱️ Detection Window",     value:`**${s.window/1000}** seconds`,         inline:true},
            {name:"🎯 Action",               value:`**${s.action.toUpperCase()}**`,         inline:true},
            {name:"🔓 Auto-Unlock",          value:s.autoUnlock?`**${fmtDuration(s.autoUnlock)}**`:"Manual only",inline:true},
            {name:"📨 DM on Action",         value:s.dmOnAction?"Yes":"No",                inline:true},
            {name:"👥 Whitelisted Users",    value:`**${s.whitelistedUsers?.length||0}**`, inline:true},
            {name:"📢 Notify Channel",       value:s.notifyChannel?`<#${s.notifyChannel}>`:"Not set",inline:true},
          ).setFooter(ft()).setTimestamp()]});
      }
      if(sub==="config"){
        const threshold=ctx.getInteger("threshold"),window=ctx.getInteger("window"),action=ctx.getString("action"),autounlock=ctx.getInteger("autounlock"),notify=ctx.getChannel("notify");
        if(threshold!=null)s.threshold=threshold;
        if(window!=null)   s.window=window*1000;
        if(action!=null)   s.action=action;
        if(autounlock!=null)s.autoUnlock=autounlock*1000;
        if(notify)         s.notifyChannel=notify.id;
        saveData();
        return ctx.reply({embeds:[E.success("🛡️ Anti-Raid Updated").addFields({name:"Threshold",value:`${s.threshold} joins`,inline:true},{name:"Window",value:`${s.window/1000}s`,inline:true},{name:"Action",value:s.action.toUpperCase(),inline:true},{name:"Auto-Unlock",value:s.autoUnlock?fmtDuration(s.autoUnlock):"Manual",inline:true}).setFooter(ft())]});
      }
      if(sub==="whitelist")  {const target=ctx.getUser("user");if(!target)return ctx.reply({embeds:[E.warn("Provide a user.")]},true);if(!s.whitelistedUsers)s.whitelistedUsers=[];if(!s.whitelistedUsers.includes(target.id))s.whitelistedUsers.push(target.id);saveData();return ctx.reply({embeds:[E.success("✅ User Whitelisted").setDescription(`<@${target.id}> is now exempt from anti-raid.`).setFooter(ft())]});}
      if(sub==="unwhitelist"){const target=ctx.getUser("user");if(!target)return ctx.reply({embeds:[E.warn("Provide a user.")]},true);s.whitelistedUsers=(s.whitelistedUsers||[]).filter(id=>id!==target.id);saveData();return ctx.reply({embeds:[E.success("✅ Removed from Whitelist").setFooter(ft())]});}
      return ctx.reply({embeds:[E.warn("Subcommands: `enable` · `disable` · `status` · `config` · `whitelist` · `unwhitelist`")]},true);
    }

    // ── ANTI-NUKE ─────────────────────────────────────────────────────────────
    case "antinuke":{
      if(!guild)return ctx.reply({embeds:[E.error("Server only.")]},true);
      if(!isAdmin(member))return ctx.reply({embeds:[E.error("Administrator only.")]},true);
      const sub=ctx.getSubcommand()||ctx.getArg(0)||"";
      const s=getAntiNuke(guild.id);
      if(sub==="enable") {s.enabled=true;saveData();return ctx.reply({embeds:[E.success("☢️ Anti-Nuke Enabled").addFields({name:"Action",value:s.action.toUpperCase(),inline:true},{name:"Ban Threshold",value:`${s.banThreshold}`,inline:true},{name:"Channel Delete",value:`${s.channelDeleteThreshold}`,inline:true}).setFooter(ft())]});}
      if(sub==="disable"){s.enabled=false;saveData();return ctx.reply({embeds:[E.warn("☢️ Anti-Nuke Disabled").setFooter(ft())]});}
      if(sub==="status"){
        return ctx.reply({embeds:[E.make(s.enabled?C.success:C.warn,`☢️ Anti-Nuke — ${s.enabled?"🟢 Active":"🔴 Disabled"}`)
          .addFields(
            {name:"⏱️ Detection Window",         value:`**${s.window/1000}** seconds`,      inline:true},
            {name:"🎯 Action",                    value:`**${s.action.toUpperCase()}**`,      inline:true},
            {name:"🔨 Ban Threshold",             value:`**${s.banThreshold}** bans`,         inline:true},
            {name:"💬 Channel Delete Threshold",  value:`**${s.channelDeleteThreshold}** del`,inline:true},
            {name:"🎭 Role Delete Threshold",     value:`**${s.roleDeleteThreshold}** del`,   inline:true},
            {name:"👢 Kick Threshold",            value:`**${s.kickThreshold}** kicks`,       inline:true},
            {name:"👥 Trusted Users",             value:`**${s.trustedUsers?.length||0}**`,   inline:true},
            {name:"📢 Notify Channel",            value:s.notifyChannel?`<#${s.notifyChannel}>`:"Not set",inline:true},
          ).setFooter(ft()).setTimestamp()]});
      }
      if(sub==="config"){
        const banth=ctx.getInteger("banth"),channelth=ctx.getInteger("channelth"),roleth=ctx.getInteger("roleth"),kickth=ctx.getInteger("kickth"),action=ctx.getString("action"),notify=ctx.getChannel("notify");
        if(banth!=null)    s.banThreshold=banth;
        if(channelth!=null)s.channelDeleteThreshold=channelth;
        if(roleth!=null)   s.roleDeleteThreshold=roleth;
        if(kickth!=null)   s.kickThreshold=kickth;
        if(action!=null)   s.action=action;
        if(notify)         s.notifyChannel=notify.id;
        saveData();
        return ctx.reply({embeds:[E.success("☢️ Anti-Nuke Updated").addFields({name:"Ban Threshold",value:`${s.banThreshold}`,inline:true},{name:"Channel Threshold",value:`${s.channelDeleteThreshold}`,inline:true},{name:"Role Threshold",value:`${s.roleDeleteThreshold}`,inline:true},{name:"Kick Threshold",value:`${s.kickThreshold}`,inline:true},{name:"Action",value:s.action.toUpperCase(),inline:true}).setFooter(ft())]});
      }
      if(sub==="trust")  {const target=ctx.getUser("user");if(!target)return ctx.reply({embeds:[E.warn("Provide a user.")]},true);if(!s.trustedUsers)s.trustedUsers=[];if(!s.trustedUsers.includes(target.id))s.trustedUsers.push(target.id);saveData();return ctx.reply({embeds:[E.success("✅ User Trusted").setDescription(`<@${target.id}> is now exempt from anti-nuke.`).setFooter(ft())]});}
      if(sub==="untrust"){const target=ctx.getUser("user");if(!target)return ctx.reply({embeds:[E.warn("Provide a user.")]},true);s.trustedUsers=(s.trustedUsers||[]).filter(id=>id!==target.id);saveData();return ctx.reply({embeds:[E.success("✅ Trust Removed").setFooter(ft())]});}
      return ctx.reply({embeds:[E.warn("Subcommands: `enable` · `disable` · `status` · `config` · `trust` · `untrust`")]},true);
    }

    // ── MODERATION ────────────────────────────────────────────────────────────
    case "ban":{
      if(!hasPerm(member,PermissionFlagsBits.BanMembers))return ctx.reply({embeds:[E.error("You need **Ban Members** permission.")]},true);
      const target=ctx.getUser("user");if(!target)return ctx.reply({embeds:[E.warn("Provide a user.")]},true);
      const reason=ctx.getString("reason")||"No reason provided";
      const days=ctx.getInteger("days")??0;
      const tm=await guild.members.fetch(target.id).catch(()=>null);
      if(tm&&!tm.bannable)return ctx.reply({embeds:[E.error("I cannot ban this user — they may have a higher role than me.")]},true);
      try{await guild.bans.create(target.id,{reason:`By ${user.tag}: ${reason}`,deleteMessageSeconds:days*86400});}
      catch{return ctx.reply({embeds:[E.error("Ban failed — check my permissions.")]},true);}
      if(!data.warns[target.id])data.warns[target.id]=[];
      data.warns[target.id].push({id:data.nextWarnId++,type:"ban",reason,modId:user.id,at:new Date().toISOString()}); saveData();
      try{await target.send({embeds:[E.error(`🔨 Banned from ${guild.name}`).addFields({name:"Reason",value:reason},{name:"Moderator",value:user.tag}).setTimestamp()]});}catch{}
      const emb=modEmbed("🔨 Member Banned",C.error,[
        {name:"👤 User",             value:`${target.tag} (<@${target.id}>)`,inline:true},
        {name:"👮 Moderator",        value:`${user.tag}`,                    inline:true},
        {name:"🗑️ Messages Deleted", value:days>0?`${days} day(s)`:"None",  inline:true},
        {name:"📋 Reason",           value:reason},
      ]);
      await ctx.reply({embeds:[emb]}); await logMod(guild,emb); break;
    }
    case "softban":{
      if(!hasPerm(member,PermissionFlagsBits.BanMembers))return ctx.reply({embeds:[E.error("You need **Ban Members** permission.")]},true);
      const target=ctx.getUser("user");if(!target)return ctx.reply({embeds:[E.warn("Provide a user.")]},true);
      const reason=ctx.getString("reason")||"Softban";
      try{
        await guild.bans.create(target.id,{reason:`Softban by ${user.tag}: ${reason}`,deleteMessageSeconds:7*86400});
        await guild.bans.remove(target.id,"Softban unban");
      }catch{return ctx.reply({embeds:[E.error("Softban failed — check my permissions.")]},true);}
      const emb=modEmbed("🧹 Member Softbanned",C.warn,[
        {name:"👤 User",      value:`${target.tag} (<@${target.id}>)`,inline:true},
        {name:"👮 Moderator", value:`${user.tag}`,                    inline:true},
        {name:"📋 Reason",    value:reason},
      ],"Ban + unban to clear 7 days of messages.");
      await ctx.reply({embeds:[emb]}); await logMod(guild,emb); break;
    }
    case "kick":{
      if(!hasPerm(member,PermissionFlagsBits.KickMembers))return ctx.reply({embeds:[E.error("You need **Kick Members** permission.")]},true);
      const target=ctx.getUser("user");if(!target)return ctx.reply({embeds:[E.warn("Provide a user.")]},true);
      const reason=ctx.getString("reason")||"No reason provided";
      const m2=await guild.members.fetch(target.id).catch(()=>null);
      if(!m2?.kickable)return ctx.reply({embeds:[E.error("Cannot kick this user.")]},true);
      await m2.kick(`By ${user.tag}: ${reason}`);
      const emb=modEmbed("👢 Member Kicked",C.warn,[
        {name:"👤 User",      value:`${target.tag} (<@${target.id}>)`,inline:true},
        {name:"👮 Moderator", value:`${user.tag}`,                    inline:true},
        {name:"📋 Reason",    value:reason},
      ]);
      await ctx.reply({embeds:[emb]}); await logMod(guild,emb); break;
    }
    case "mute":{
      if(!hasPerm(member,PermissionFlagsBits.ModerateMembers))return ctx.reply({embeds:[E.error("You need **Moderate Members** permission.")]},true);
      const target=ctx.getUser("user");const durStr=ctx.getString("duration")||ctx.getArg(1)||"";const reason=ctx.getString("reason")||"No reason provided";
      if(!target||!durStr)return ctx.reply({embeds:[E.warn("Usage: `/mute @user <duration> [reason]`")]},true);
      const ms=parseDuration(durStr);if(!ms||ms>28*TIME.d)return ctx.reply({embeds:[E.error("Invalid duration. Max is 28 days.")]},true);
      const m2=await guild.members.fetch(target.id).catch(()=>null);if(!m2?.moderatable)return ctx.reply({embeds:[E.error("Cannot timeout this user.")]},true);
      await m2.timeout(ms,`By ${user.tag}: ${reason}`);
      const emb=modEmbed("🔇 Member Timed Out",C.warn,[
        {name:"👤 User",      value:`${target.tag} (<@${target.id}>)`,inline:true},
        {name:"⏱️ Duration",  value:fmtDuration(ms),                  inline:true},
        {name:"👮 Moderator", value:`${user.tag}`,                    inline:true},
        {name:"📋 Reason",    value:reason},
      ]);
      await ctx.reply({embeds:[emb]}); await logMod(guild,emb); break;
    }
    case "unmute":{
      if(!hasPerm(member,PermissionFlagsBits.ModerateMembers))return ctx.reply({embeds:[E.error("You need **Moderate Members** permission.")]},true);
      const target=ctx.getUser("user");if(!target)return ctx.reply({embeds:[E.warn("Provide a user.")]},true);
      const m2=await guild.members.fetch(target.id).catch(()=>null);if(!m2)return ctx.reply({embeds:[E.error("User not found in server.")]},true);
      await m2.timeout(null,`Timeout removed by ${user.tag}`);
      return ctx.reply({embeds:[E.success("🔊 Timeout Removed").addFields({name:"👤 User",value:`<@${target.id}>`,inline:true},{name:"👮 By",value:user.tag,inline:true}).setFooter(ft()).setTimestamp()]});
    }
    case "warn":{
      if(!hasPerm(member,PermissionFlagsBits.ModerateMembers))return ctx.reply({embeds:[E.error("You need **Moderate Members** permission.")]},true);
      const target=ctx.getUser("user");const reason=ctx.getString("reason")||ctx.getArgs().slice(1).join(" ");
      if(!target||!reason)return ctx.reply({embeds:[E.warn("Usage: `/warn @user <reason>`")]},true);
      const w={id:data.nextWarnId++,type:"warn",reason,modId:user.id,at:new Date().toISOString()};
      if(!data.warns[target.id])data.warns[target.id]=[];data.warns[target.id].push(w); saveData();
      const emb=modEmbed("⚠️ Member Warned",C.warn,[
        {name:"👤 User",       value:`${target.tag} (<@${target.id}>)`, inline:true},
        {name:"🔢 Warn ID",    value:`#${w.id}`,                        inline:true},
        {name:"📊 Total Warns",value:`${data.warns[target.id].length}`, inline:true},
        {name:"👮 Moderator",  value:user.tag,                          inline:true},
        {name:"📋 Reason",     value:reason},
      ]);
      await ctx.reply({embeds:[emb]}); await logMod(guild,emb);
      try{const u2=await client.users.fetch(target.id);u2.send({embeds:[E.warn(`⚠️ You were warned in ${guild.name}`).addFields({name:"Reason",value:reason},{name:"Total Warnings",value:`${data.warns[target.id].length}`}).setFooter(ft()).setTimestamp()]});}catch{}
      break;
    }
    case "warns":{
      if(!hasPerm(member,PermissionFlagsBits.ModerateMembers))return ctx.reply({embeds:[E.error("You need **Moderate Members** permission.")]},true);
      const target=ctx.getUser("user");if(!target)return ctx.reply({embeds:[E.warn("Provide a user.")]},true);
      const list=(data.warns[target.id]||[]).filter(w=>!w.type||w.type==="warn");
      const emb=E.make(list.length?C.warn:C.success,`⚠️ Warnings — ${target.username}`).setThumbnail(target.displayAvatarURL());
      if(!list.length)emb.setDescription("✅ This user has no warnings.");
      else list.slice(-10).forEach(w=>emb.addFields({name:`⚠️ Warning #${w.id}`,value:`**Reason:** ${w.reason||"—"}\n**By:** <@${w.modId}> · <t:${Math.floor(new Date(w.at).getTime()/1000)}:R>`,inline:true}));
      return ctx.reply({embeds:[emb.setFooter(ft()).setTimestamp()]});
    }
    case "unwarn":{
      if(!hasPerm(member,PermissionFlagsBits.ModerateMembers))return ctx.reply({embeds:[E.error("You need **Moderate Members** permission.")]},true);
      const id=ctx.getInteger("id")||parseInt(ctx.getArg(0),10);if(!id)return ctx.reply({embeds:[E.warn("Provide a warning ID.")]},true);
      let found=false;
      for(const [uid,list] of Object.entries(data.warns)){const i=list.findIndex(w=>w.id===id);if(i!==-1){list.splice(i,1);if(!list.length)delete data.warns[uid];saveData();await ctx.reply({embeds:[E.success("✅ Warning Removed").addFields({name:"Warning ID",value:`#${id}`,inline:true},{name:"User",value:`<@${uid}>`,inline:true}).setFooter(ft())]});found=true;break;}}
      if(!found)return ctx.reply({embeds:[E.error("Warning not found.")]},true);
      break;
    }
    case "clearwarns":{
      if(!hasPerm(member,PermissionFlagsBits.ModerateMembers))return ctx.reply({embeds:[E.error("You need **Moderate Members** permission.")]},true);
      const target=ctx.getUser("user");if(!target)return ctx.reply({embeds:[E.warn("Provide a user.")]},true);
      const count=(data.warns[target.id]||[]).filter(w=>!w.type||w.type==="warn").length;
      delete data.warns[target.id]; saveData();
      return ctx.reply({embeds:[E.success("✅ Warnings Cleared").addFields({name:"User",value:`<@${target.id}>`,inline:true},{name:"Removed",value:`${count} warning(s)`,inline:true}).setFooter(ft()).setTimestamp()]});
    }
    case "modlogs":{
      if(!hasPerm(member,PermissionFlagsBits.ModerateMembers))return ctx.reply({embeds:[E.error("You need **Moderate Members** permission.")]},true);
      const target=ctx.getUser("user");if(!target)return ctx.reply({embeds:[E.warn("Provide a user.")]},true);
      const logs=data.warns[target.id]||[];
      if(!logs.length)return ctx.reply({embeds:[E.success(`📓 Mod Logs — ${target.username}`).setDescription("✅ No moderation actions on record.").setFooter(ft())]});
      const emb=E.mod(`📓 Mod Logs — ${target.username}`).setThumbnail(target.displayAvatarURL());
      logs.slice(-10).forEach(a=>emb.addFields({name:`${a.type?.toUpperCase()||"WARN"} #${a.id}`,value:`**Reason:** ${a.reason||"—"}\n**By:** <@${a.modId}> · <t:${Math.floor(new Date(a.at).getTime()/1000)}:R>`}));
      return ctx.reply({embeds:[emb.setFooter({text:`${logs.length} total actions · ${FOOTER}`}).setTimestamp()]});
    }
    case "purge":{
      if(!hasPerm(member,PermissionFlagsBits.ManageMessages))return ctx.reply({embeds:[E.error("You need **Manage Messages** permission.")]},true);
      const count=ctx.getInteger("count")||parseInt(ctx.getArg(0),10)||0;
      if(count<1||count>100)return ctx.reply({embeds:[E.warn("Count must be between 1 and 100.")]},true);
      const filterUser=ctx.getUser("user")||null;
      if(ctx.isSlash)await ctx.interaction.deferReply({ephemeral:true}).catch(()=>{});
      try{
        let messages=await ctx.channel.messages.fetch({limit:100});
        if(filterUser)messages=messages.filter(m=>m.author.id===filterUser.id);
        messages=messages.first(count);
        const deleted=await ctx.channel.bulkDelete(messages,true);
        return ctx.reply({content:`✅ Deleted **${deleted.size}** message(s)${filterUser?` from **${filterUser.username}**`:""}.`});
      }catch{return ctx.reply({embeds:[E.error("Purge failed — messages may be older than 14 days.")]});}
    }
    case "lock":    {if(!hasPerm(member,PermissionFlagsBits.ManageChannels))return ctx.reply({embeds:[E.error("You need **Manage Channels** permission.")]},true);await ctx.channel.permissionOverwrites.edit(guild.roles.everyone,{SendMessages:false});return ctx.reply({embeds:[E.error("🔒 Channel Locked").setDescription("Only staff can send messages here.").setFooter(ft())]});}
    case "unlock":  {if(!hasPerm(member,PermissionFlagsBits.ManageChannels))return ctx.reply({embeds:[E.error("You need **Manage Channels** permission.")]},true);await ctx.channel.permissionOverwrites.edit(guild.roles.everyone,{SendMessages:null});return ctx.reply({embeds:[E.success("🔓 Channel Unlocked").setDescription("Everyone can send messages again.").setFooter(ft())]});}
    case "slowmode":{if(!hasPerm(member,PermissionFlagsBits.ManageChannels))return ctx.reply({embeds:[E.error("You need **Manage Channels** permission.")]},true);const secs=ctx.getInteger("seconds")||parseInt(ctx.getArg(0)||"0");await ctx.channel.setRateLimitPerUser(secs);return ctx.reply({embeds:[E.success("🐢 Slowmode Updated").setDescription(secs===0?"Slowmode disabled.":`Set to **${secs}s**`).setFooter(ft())]});}
    case "nick":    {if(!hasPerm(member,PermissionFlagsBits.ManageNicknames))return ctx.reply({embeds:[E.error("You need **Manage Nicknames** permission.")]},true);const target=ctx.getUser("user");if(!target)return ctx.reply({embeds:[E.warn("Provide a user.")]},true);const nick=ctx.getString("name")||null;const m2=await guild.members.fetch(target.id).catch(()=>null);if(!m2?.manageable)return ctx.reply({embeds:[E.error("Cannot edit this member.")]},true);await m2.setNickname(nick);return ctx.reply({embeds:[E.success("✅ Nickname Updated").addFields({name:"User",value:`<@${target.id}>`,inline:true},{name:"Nickname",value:nick||"*(cleared)*",inline:true}).setFooter(ft())]});}

    // ── ADMIN ─────────────────────────────────────────────────────────────────
    case "announce":{
      if(!isAdmin(member)&&!hasPerm(member,PermissionFlagsBits.ManageGuild))return ctx.reply({embeds:[E.error("You need **Manage Guild** permission.")]},true);
      const text=ctx.getString("message")||ctx.getArgs().join(" ");if(!text)return ctx.reply({embeds:[E.warn("Provide a message.")]},true);
      const channel=ctx.getChannel("channel")||ctx.channel;
      if(ctx.isSlash)ctx.interaction.reply({content:"✅ Announcement sent!",flags:MessageFlags.Ephemeral}).catch(()=>{});
      await channel.send({content:"@everyone",embeds:[E.brand("📢 Announcement")
        .setDescription(text)
        .setAuthor({name:guild.name,iconURL:guild.iconURL()||undefined})
        .setFooter({text:`Posted by ${user.tag}`})
        .setTimestamp()],allowedMentions:{parse:["everyone"]}});
      if(!ctx.isSlash)ctx.reply({content:"✅ Announced!"});
      break;
    }
    case "say":{
      if(!isAdmin(member)&&!hasPerm(member,PermissionFlagsBits.ManageMessages))return ctx.reply({embeds:[E.error("Permission denied.")]},true);
      const text=ctx.getString("message")||ctx.getArgs().join(" ");if(!text)return ctx.reply({embeds:[E.warn("Provide a message.")]},true);
      if(ctx.isSlash)ctx.interaction.reply({content:"✅",flags:MessageFlags.Ephemeral}).catch(()=>{});
      await ctx.channel.send({content:text,allowedMentions:{users:[]}});
      break;
    }
    case "embed":{
      if(!isAdmin(member)&&!hasPerm(member,PermissionFlagsBits.ManageMessages))return ctx.reply({embeds:[E.error("Permission denied.")]},true);
      const title=ctx.getString("title");const body=ctx.getString("body");const colorHex=ctx.getString("color")||null;
      if(!title||!body)return ctx.reply({embeds:[E.warn("Provide title and body.")]},true);
      const color=colorHex&&/^[0-9A-Fa-f]{6}$/.test(colorHex)?parseInt(colorHex,16):C.brand;
      if(ctx.isSlash)ctx.interaction.reply({content:"✅",flags:MessageFlags.Ephemeral}).catch(()=>{});
      await ctx.channel.send({embeds:[E.make(color,title).setDescription(body).setTimestamp()]});
      break;
    }
    case "poll":{
      if(!isAdmin(member)&&!hasPerm(member,PermissionFlagsBits.ManageMessages))return ctx.reply({embeds:[E.error("Permission denied.")]},true);
      const q=ctx.getString("question");const optsRaw=ctx.getString("options")||(ctx.getArgs().slice(1).join(" "));
      if(!q||!optsRaw)return ctx.reply({embeds:[E.warn("Usage: `/poll <question> | <opt1> | <opt2>`")]},true);
      const opts=optsRaw.split("|").map(s2=>s2.trim()).filter(Boolean).slice(0,9);
      if(opts.length<2)return ctx.reply({embeds:[E.warn("Need at least 2 options separated by `|`.")]},true);
      const nums=["1️⃣","2️⃣","3️⃣","4️⃣","5️⃣","6️⃣","7️⃣","8️⃣","9️⃣"];
      if(ctx.isSlash)ctx.interaction.reply({content:"✅",flags:MessageFlags.Ephemeral}).catch(()=>{});
      const sent=await ctx.channel.send({embeds:[E.info(`📊 ${q}`).setDescription(opts.map((o,i)=>`${nums[i]} ${o}`).join("\n\n")).setFooter({text:"React to cast your vote!"}).setTimestamp()]});
      for(let i=0;i<opts.length;i++)await sent.react(nums[i]).catch(()=>{});
      break;
    }
    case "giveaway":{
      if(!isAdmin(member)&&!hasPerm(member,PermissionFlagsBits.ManageGuild))return ctx.reply({embeds:[E.error("Permission denied.")]},true);
      const durStr=ctx.getString("duration")||ctx.getArg(0);
      const prize=ctx.getString("prize")||ctx.getArgs().slice(1).join(" ");
      const winners=ctx.getInteger("winners")||1;
      if(!durStr||!prize)return ctx.reply({embeds:[E.warn("Usage: `/giveaway <duration> <prize>`")]},true);
      const ms=parseDuration(durStr);if(!ms)return ctx.reply({embeds:[E.error("Invalid duration.")]},true);
      const endAt=Date.now()+ms;
      const sent=await ctx.channel.send({content:"@here",embeds:[E.gold("🎉 GIVEAWAY!")
        .setDescription(`React with 🎉 to enter!\n\n**Prize:** ${prize}`)
        .addFields({name:"⏰ Ends",value:`<t:${Math.floor(endAt/1000)}:R>`,inline:true},{name:"🏆 Winners",value:`${winners}`,inline:true},{name:"🎁 Hosted by",value:`<@${user.id}>`,inline:true})
        .setFooter(ft()).setTimestamp()],allowedMentions:{users:[]}});
      await sent.react("🎉").catch(()=>{});
      data.giveaways[sent.id]={prize,endAt,channelId:ctx.channel.id,guildId:guild.id,hostId:user.id,winners,ended:false}; saveData();
      return ctx.reply({content:"✅ Giveaway started!",...(ctx.isSlash?{flags:MessageFlags.Ephemeral}:{})});
    }
    case "addorder":{
      if(!isAdmin(member))return ctx.reply({embeds:[E.error("Administrator only.")]},true);
      const target=ctx.getUser("user");const details=ctx.getString("details")||ctx.getArgs().slice(1).join(" ");
      if(!target||!details)return ctx.reply({embeds:[E.warn("Usage: `/addorder @user <details>`")]},true);
      const now2=new Date().toISOString();
      const o={id:data.nextOrderId++,userId:target.id,details,status:"not_started",createdAt:now2,updatedAt:now2,createdBy:user.id,note:null};
      data.orders.push(o); data.stats.ordersCreated=(data.stats.ordersCreated||0)+1; saveData(); updateOrderBoard().catch(()=>{});
      return ctx.reply({embeds:[E.success(`✅ Order #${o.id} Created`).addFields({name:"Customer",value:`<@${target.id}>`},{name:"Details",value:details}).setFooter(ft()).setTimestamp()]});
    }
    case "updateorder":{
      if(!isAdmin(member)&&!hasPerm(member,PermissionFlagsBits.ManageMessages))return ctx.reply({embeds:[E.error("Permission denied.")]},true);
      const id=ctx.getInteger("id")||parseInt(ctx.getArg(0),10);const status=ctx.getString("status")||ctx.getArg(1);const note=ctx.getString("note")||null;
      if(!id||!status)return ctx.reply({embeds:[E.warn("Usage: `/updateorder <id> <status> [note]`")]},true);
      const o=findOrder(id);if(!o)return ctx.reply({embeds:[E.error("Order not found.")]},true);
      if(!ORDER_STATUSES[status])return ctx.reply({embeds:[E.warn(`Valid statuses: ${Object.keys(ORDER_STATUSES).join(", ")}`)]},true);
      const old=o.status; o.status=status; o.updatedAt=new Date().toISOString(); if(note)o.note=note;
      if(status==="completed")data.stats.ordersCompleted=(data.stats.ordersCompleted||0)+1;
      saveData(); updateOrderBoard().catch(()=>{});
      const si=getOrderStatus(status);
      await ctx.reply({embeds:[E.make(si.color,`✅ Order #${o.id} Updated`).addFields({name:"Previous",value:`${getOrderStatus(old).emoji} ${getOrderStatus(old).label}`,inline:true},{name:"New",value:`${si.emoji} ${si.label}`,inline:true},{name:"Customer",value:`<@${o.userId}>`,inline:true}).setFooter(ft()).setTimestamp()]});
      try{const u2=await client.users.fetch(o.userId);u2.send({embeds:[E.make(si.color,`📦 Order #${o.id} Update`).setDescription(`Your order status changed to **${si.emoji} ${si.label}**${note?`\n\n**Note:** ${note}`:""}`).setFooter(ft()).setTimestamp()]});}catch{}
      break;
    }
    case "complete":{
      if(!isAdmin(member))return ctx.reply({embeds:[E.error("Administrator only.")]},true);
      const id=ctx.getInteger("id")||parseInt(ctx.getArg(0),10);
      const o=findOrder(id);if(!o)return ctx.reply({embeds:[E.error("Order not found.")]},true);
      if(o.status==="completed")return ctx.reply({embeds:[E.warn("Already completed.")]},true);
      o.status="completed"; o.updatedAt=new Date().toISOString(); data.stats.ordersCompleted=(data.stats.ordersCompleted||0)+1; saveData(); updateOrderBoard().catch(()=>{});
      return ctx.reply({embeds:[E.success(`✅ Order #${o.id} Completed`).addFields({name:"Customer",value:`<@${o.userId}>`,inline:true}).setFooter(ft()).setTimestamp()]});
    }
    case "blacklist":{
      if(!isAdmin(member))return ctx.reply({embeds:[E.error("Administrator only.")]},true);
      const target=ctx.getUser("user");if(!target)return ctx.reply({embeds:[E.warn("Provide a user.")]},true);
      const i=data.blacklist.indexOf(target.id);
      if(i===-1)data.blacklist.push(target.id); else data.blacklist.splice(i,1);
      saveData();
      return ctx.reply({embeds:[E.make(i===-1?C.error:C.success,"🚫 Blacklist Updated").setDescription(`<@${target.id}> has been **${i===-1?"added to":"removed from"}** the blacklist.`).setFooter(ft())]});
    }
    case "setlog":{
      if(!isAdmin(member))return ctx.reply({embeds:[E.error("Administrator only.")]},true);
      const ch=ctx.getChannel("channel");
      if(!ch){delete data.modLogChannels[guild.id];saveData();return ctx.reply({embeds:[E.warn("Mod log cleared.")]});}
      data.modLogChannels[guild.id]=ch.id; saveData();
      return ctx.reply({embeds:[E.success("📓 Mod Log Set").setDescription(`Logging to <#${ch.id}>`).setFooter(ft())]});
    }
    case "setreviews":    {if(!isAdmin(member))return ctx.reply({embeds:[E.error("Administrator only.")]},true);const ch=ctx.getChannel("channel");getSettings(guild.id).reviewsChannelId=ch?.id||null;saveData();return ctx.reply({embeds:[E.success(`✅ Reviews channel ${ch?`set to <#${ch.id}>`:"cleared."}`).setFooter(ft())]});}
    case "settranscripts":{if(!isAdmin(member))return ctx.reply({embeds:[E.error("Administrator only.")]},true);const ch=ctx.getChannel("channel");getSettings(guild.id).transcriptsChannelId=ch?.id||null;saveData();return ctx.reply({embeds:[E.success(`✅ Transcripts channel ${ch?`set to <#${ch.id}>`:"cleared."}`).setFooter(ft())]});}
    case "setverifyrole": {if(!isAdmin(member))return ctx.reply({embeds:[E.error("Administrator only.")]},true);const role=ctx.getRole("role");if(!role)return ctx.reply({embeds:[E.warn("Provide a role.")]},true);getSettings(guild.id).verifyRoleId=role.id;saveData();return ctx.reply({embeds:[E.success("✅ Verify Role Set").setDescription(`Users receive <@&${role.id}> upon Roblox verification.`).setFooter(ft())]});}
    case "setlevelupchannel":{if(!isAdmin(member))return ctx.reply({embeds:[E.error("Administrator only.")]},true);const ch=ctx.getChannel("channel");if(!ch)return ctx.reply({embeds:[E.warn("Provide a channel.")]},true);getSettings(guild.id).levelUpChannelId=ch.id;saveData();return ctx.reply({embeds:[E.success("✅ Level-Up Channel Set").setDescription(`Level-up notifications → <#${ch.id}>`).setFooter(ft())]});}
    case "ticketpanel":{
      if(!isAdmin(member)&&!hasPerm(member,PermissionFlagsBits.ManageChannels))return ctx.reply({embeds:[E.error("Permission denied.")]},true);
      const s2=getSettings(guild.id); s2.ticketPanelChannelId=ctx.channel.id; saveData();
      const {emb,row}=buildTicketPanel();
      const sent=await ctx.channel.send({embeds:[emb],components:[row]});
      s2.ticketPanelMsgId=sent.id; saveData();
      return ctx.reply({content:"✅ Ticket panel posted!",...(ctx.isSlash?{flags:MessageFlags.Ephemeral}:{})});
    }
    case "close":{
      if(!ctx.channel?.name?.startsWith("ticket-"))return ctx.reply({embeds:[E.error("This command only works inside ticket channels.")]},true);
      const reason=ctx.getString("reason")||ctx.getArgs().join(" ")||"No reason provided";
      if(ctx.isSlash)ctx.interaction.reply({content:"🔒 Closing ticket…",flags:MessageFlags.Ephemeral}).catch(()=>{});
      await closeTicket(ctx.channel,member||user,reason,guild); break;
    }
    case "addnote":{
      if(!ctx.channel?.name?.startsWith("ticket-"))return ctx.reply({embeds:[E.error("Ticket channels only.")]},true);
      if(!isStaff(member))return ctx.reply({embeds:[E.error("Staff only.")]},true);
      const text=ctx.getString("text")||ctx.getArgs().join(" ");if(!text)return ctx.reply({embeds:[E.warn("Provide note text.")]},true);
      if(ctx.isSlash)ctx.interaction.reply({content:"✅ Note added.",flags:MessageFlags.Ephemeral}).catch(()=>{});
      await ctx.channel.send({embeds:[E.make(C.note,"📝 Staff Note").setDescription(text).setFooter({text:`by ${user.tag}`}).setTimestamp()]});
      break;
    }
    case "givecoins":{
      if(!isAdmin(member))return ctx.reply({embeds:[E.error("Administrator only.")]},true);
      const target=ctx.getUser("user");const amt=ctx.getInteger("amount")||parseInt(ctx.getArg(1),10)||0;
      if(!target||amt<1)return ctx.reply({embeds:[E.warn("Usage: `/givecoins @user <amount>`")]},true);
      const eco=getEco(target.id); eco.coins=(eco.coins||0)+amt; saveData();
      return ctx.reply({embeds:[E.success("💰 Coins Granted").addFields({name:"User",value:`<@${target.id}>`,inline:true},{name:"Amount",value:`${amt} 🪙`,inline:true},{name:"New Balance",value:`${eco.coins} 🪙`,inline:true}).setFooter(ft()).setTimestamp()]});
    }

    // ── BACKUP ────────────────────────────────────────────────────────────────
    case "backup":{
      if(!guild)return ctx.reply({embeds:[E.error("Server only.")]},true);
      if(!isAdmin(member))return ctx.reply({embeds:[E.error("Administrator only.")]},true);
      const sub=ctx.getSubcommand()||ctx.getArg(0)||"";
      if(sub==="create"){
        if(ctx.isSlash)await ctx.interaction.deferReply().catch(()=>{});
        const backup=await createServerBackup(guild);
        return ctx.reply({embeds:[E.success("💾 Backup Created!")
          .addFields(
            {name:"🆔 Backup ID",  value:`\`${backup.id}\``,                                                                         inline:true},
            {name:"📅 Created",    value:`<t:${Math.floor(new Date(backup.createdAt).getTime()/1000)}:F>`,                            inline:true},
            {name:"💬 Channels",   value:`${backup.channels.length}`,                                                                  inline:true},
            {name:"🎭 Roles",      value:`${backup.roles.length}`,                                                                     inline:true},
            {name:"⚠️ Note",       value:"Saves channel/role metadata and settings. Up to **5 backups** stored — oldest deleted first."},
          ).setFooter(ft()).setTimestamp()]});
      }
      if(sub==="list"){
        const backups=data.serverBackups[guild.id]||[];
        if(!backups.length)return ctx.reply({embeds:[E.warn("No backups found. Run `backup create` first.").setFooter(ft())]});
        return ctx.reply({embeds:[E.brand("💾 Server Backups").setDescription(backups.map((b,i)=>`**${i+1}.** \`${b.id}\`\n${b.channels.length} channels · ${b.roles.length} roles · <t:${Math.floor(new Date(b.createdAt).getTime()/1000)}:R>`).join("\n\n")).setFooter(ft()).setTimestamp()]});
      }
      if(sub==="view"){
        const id=ctx.getString("id")||ctx.getArg(1);
        const backup=(data.serverBackups[guild.id]||[]).find(b=>b.id===id);
        if(!backup)return ctx.reply({embeds:[E.error("Backup not found.")]},true);
        const channels=backup.channels.slice(0,10).map(c=>`\`${c.name}\``).join(", ");
        const roles=backup.roles.slice(0,10).map(r=>`\`${r.name}\``).join(", ");
        return ctx.reply({embeds:[E.brand(`💾 Backup — ${backup.id}`)
          .addFields(
            {name:"📅 Created",      value:`<t:${Math.floor(new Date(backup.createdAt).getTime()/1000)}:F>`,inline:true},
            {name:"💬 Channels",     value:`${backup.channels.length}`,                                     inline:true},
            {name:"🎭 Roles",        value:`${backup.roles.length}`,                                        inline:true},
            {name:"Channel Preview", value:channels+(backup.channels.length>10?` +${backup.channels.length-10} more`:"")||"None"},
            {name:"Role Preview",    value:roles+(backup.roles.length>10?` +${backup.roles.length-10} more`:"")   ||"None"},
          ).setFooter(ft()).setTimestamp()]});
      }
      return ctx.reply({embeds:[E.warn("Subcommands: `create` · `list` · `view <id>`")]},true);
    }

    default:return ctx.reply({content:`❓ Unknown command: \`${cmdName}\`. Try \`s!help\`.`},true);
  }
}

// ─── CONTEXT FACTORIES ────────────────────────────────────────────────────────
function makeSlashCtx(interaction) {
  return {
    isSlash:true, guild:interaction.guild, member:interaction.member,
    user:interaction.user, channel:interaction.channel, interaction,
    getString:     k => interaction.options?.getString?.(k)??null,
    getInteger:    k => interaction.options?.getInteger?.(k)??null,
    getUser:       k => interaction.options?.getUser?.(k)??null,
    getRole:       k => interaction.options?.getRole?.(k)??null,
    getChannel:    k => interaction.options?.getChannel?.(k)??null,
    getSubcommand: () => { try{return interaction.options?.getSubcommand();}catch{return null;} },
    getArg:        () => null,
    getArgs:       () => [],
    getMentionRole:() => null,
    reply: async (payload, ephemeral=false) => sendReply(interaction, payload, ephemeral),
  };
}

function makePrefixCtx(msg, args) {
  return {
    isSlash:false, guild:msg.guild, member:msg.member,
    user:msg.author, channel:msg.channel, interaction:null,
    getString:     (_k,_r,idx=0) => args[idx]||null,
    getInteger:    (_k,_r,idx=0) => args[idx]?parseInt(args[idx],10)||null:null,
    getUser:       (_k,idx=0)    => { const id=(args[idx]||"").replace(/[<@!>]/g,""); return id?client.users.cache.get(id)||null:null; },
    getRole:       (_k,idx=0)    => { if(!msg.guild)return null; const id=(args[idx]||"").replace(/[<@&>]/g,""); return id?msg.guild.roles.cache.get(id)||null:null; },
    getChannel:    (_k,idx=0)    => { if(!msg.guild)return null; const id=(args[idx]||"").replace(/[<#>]/g,""); return id?msg.guild.channels.cache.get(id)||null:null; },
    getSubcommand: ()             => args[0]?.toLowerCase()||null,
    getArg:        idx            => args[idx]||null,
    getArgs:       ()             => args,
    getMentionRole:(idx)          => { if(!msg.guild)return null; const id=(args[idx]||"").replace(/[<@&>]/g,""); return id?msg.guild.roles.cache.get(id)||null:null; },
    reply: async (payload) => {
      try{
        if(typeof payload==="string")return msg.channel.send({content:payload});
        const {flags:_f,...rest}=payload;
        return msg.channel.send({...rest,allowedMentions:{...rest.allowedMentions}});
      }catch(e){console.error("[prefixReply]",e.message);}
    },
  };
}

// ─── INTERACTION CREATE ───────────────────────────────────────────────────────
client.on("interactionCreate", async interaction=>{
  try{
    if(data.blacklist.includes(interaction.user.id)&&interaction.isRepliable()){
      interaction.reply({content:"🚫 You are blacklisted.",flags:MessageFlags.Ephemeral}).catch(()=>{}); return;
    }

    if(interaction.isChatInputCommand()) return execCommand(interaction.commandName,makeSlashCtx(interaction));

    if(interaction.isButton()){
      const typeMap={ticket_order:"order",ticket_partner:"partnership",ticket_inquiry:"inquiry"};
      if(typeMap[interaction.customId]){
        const type=typeMap[interaction.customId];
        let modal;
        if(type==="order"){
          modal=new ModalBuilder().setCustomId("modal_order").setTitle("📦 Commission Order");
          modal.addComponents(
            new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("username").setLabel("Your Roblox Username").setStyle(TextInputStyle.Short).setMaxLength(100).setRequired(true)),
            new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("service").setLabel("Service Needed").setPlaceholder("e.g. UI, datastore, admin system…").setStyle(TextInputStyle.Short).setMaxLength(200).setRequired(true)),
            new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("description").setLabel("Detailed Description").setStyle(TextInputStyle.Paragraph).setMaxLength(1000).setRequired(true)),
            new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("budget").setLabel("Your Budget").setPlaceholder("e.g. $25 USD, 5000 Robux…").setStyle(TextInputStyle.Short).setMaxLength(100).setRequired(true)),
            new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("payment").setLabel("Payment Method").setPlaceholder("PayPal F&F, CashApp, Robux, Gift Card…").setStyle(TextInputStyle.Short).setMaxLength(100).setRequired(true)),
          );
        } else if(type==="partnership"){
          modal=new ModalBuilder().setCustomId("modal_partner").setTitle("🤝 Partnership Request");
          modal.addComponents(
            new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("serverName").setLabel("Server Name").setStyle(TextInputStyle.Short).setMaxLength(100).setRequired(true)),
            new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("invite").setLabel("Permanent Invite Link").setStyle(TextInputStyle.Short).setMaxLength(200).setRequired(true)),
            new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("memberCount").setLabel("Member Count").setPlaceholder("Minimum 45 required").setStyle(TextInputStyle.Short).setMaxLength(50).setRequired(true)),
            new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("focus").setLabel("Server Focus / Niche").setPlaceholder("e.g. Roblox scripting, game dev…").setStyle(TextInputStyle.Short).setMaxLength(200).setRequired(true)),
            new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("offering").setLabel("What Can You Offer?").setPlaceholder("e.g. Ad in announcements, promotion…").setStyle(TextInputStyle.Paragraph).setMaxLength(500).setRequired(true)),
          );
        } else {
          modal=new ModalBuilder().setCustomId("modal_inquiry").setTitle("❓ Support Inquiry");
          modal.addComponents(
            new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("name").setLabel("Your Name or Username").setStyle(TextInputStyle.Short).setMaxLength(100).setRequired(true)),
            new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("topic").setLabel("Topic / Question Summary").setStyle(TextInputStyle.Short).setMaxLength(200).setRequired(true)),
            new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("details").setLabel("Full Details").setStyle(TextInputStyle.Paragraph).setMaxLength(1000).setRequired(true)),
            new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("urgency").setLabel("Urgency (optional)").setPlaceholder("Not urgent / Within a few days / ASAP").setStyle(TextInputStyle.Short).setMaxLength(100).setRequired(false)),
          );
        }
        return interaction.showModal(modal);
      }
      if(interaction.customId==="ticket_close_btn"){
        const modal=new ModalBuilder().setCustomId("modal_close").setTitle("🔒 Close Ticket");
        modal.addComponents(new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("reason").setLabel("Reason for closing").setStyle(TextInputStyle.Paragraph).setMaxLength(500).setRequired(true)));
        return interaction.showModal(modal);
      }
      if(interaction.customId==="verify_start"){
        const modal=new ModalBuilder().setCustomId("modal_verify_start").setTitle("🟣 Roblox Verification");
        modal.addComponents(new ActionRowBuilder().addComponents(new TextInputBuilder().setCustomId("username").setLabel("Your Roblox Username").setStyle(TextInputStyle.Short).setMaxLength(50).setRequired(true)));
        return interaction.showModal(modal);
      }
    }

    if(interaction.isModalSubmit()){
      const typeMap={modal_order:"order",modal_partner:"partnership",modal_inquiry:"inquiry"};
      if(typeMap[interaction.customId]){
        await interaction.deferReply({flags:MessageFlags.Ephemeral});
        const type=typeMap[interaction.customId]; let answers={};
        if(type==="order")       answers={username:interaction.fields.getTextInputValue("username"),service:interaction.fields.getTextInputValue("service"),description:interaction.fields.getTextInputValue("description"),budget:interaction.fields.getTextInputValue("budget"),payment:interaction.fields.getTextInputValue("payment")};
        else if(type==="partnership") answers={serverName:interaction.fields.getTextInputValue("serverName"),invite:interaction.fields.getTextInputValue("invite"),memberCount:interaction.fields.getTextInputValue("memberCount"),focus:interaction.fields.getTextInputValue("focus"),offering:interaction.fields.getTextInputValue("offering")};
        else answers={name:interaction.fields.getTextInputValue("name"),topic:interaction.fields.getTextInputValue("topic"),details:interaction.fields.getTextInputValue("details"),urgency:interaction.fields.getTextInputValue("urgency")};
        const memberObj=interaction.member??await interaction.guild?.members.fetch(interaction.user.id).catch(()=>null);
        const result=await openTicket(interaction.guild,memberObj,type,answers);
        if(!result.ok)return interaction.editReply({content:`❌ ${result.error}`});
        return interaction.editReply({content:`✅ Your ticket has been created: <#${result.channel.id}>`});
      }
      if(interaction.customId==="modal_close"){
        const reason=interaction.fields.getTextInputValue("reason");
        if(!interaction.channel?.name?.startsWith("ticket-"))return interaction.reply({content:"❌ Not a ticket channel.",flags:MessageFlags.Ephemeral});
        await interaction.deferReply({flags:MessageFlags.Ephemeral});
        await interaction.editReply({content:"🔒 Closing ticket…"});
        await closeTicket(interaction.channel,interaction.member||interaction.user,reason,interaction.guild); return;
      }
      if(interaction.customId==="modal_verify_start"){
        await interaction.deferReply({flags:MessageFlags.Ephemeral});
        const username=interaction.fields.getTextInputValue("username");
        const robloxUser=await fetchRobloxUser(username);
        if(!robloxUser)return interaction.editReply({content:"❌ Roblox user not found. Check the spelling."});
        const code=genVerifyCode();
        data.verificationCodes[interaction.user.id]={code,robloxName:robloxUser.name,robloxId:robloxUser.id,expiresAt:Date.now()+10*60000}; saveData();
        const avatar=await fetchRobloxAvatar(robloxUser.id);
        const emb=E.roblox("🟣 Verification Code — Step 2")
          .setDescription([
            `**Found:** [${robloxUser.name}](https://www.roblox.com/users/${robloxUser.id}/profile)\n`,
            "**Steps:**",
            "① Copy the code below",
            "② Go to [roblox.com/my/account](https://www.roblox.com/my/account) → **About** tab",
            "③ Paste the code in your bio and **save**",
            `④ Run \`/checkverify ${code}\` here\n`,
            "> ⏰ Expires in **10 minutes**",
          ].join("\n"))
          .addFields({name:"🔑 Your Code",value:`\`\`\`${code}\`\`\``})
          .setFooter({text:"Paste in Roblox bio → /checkverify"}).setTimestamp();
        if(avatar)emb.setThumbnail(avatar);
        return interaction.editReply({embeds:[emb]});
      }
    }
  }catch(err){
    console.error("[Interaction]",err.message);
    await sendErrorLog(err,"Interaction handler");
    try{if(interaction.isRepliable()&&!interaction.replied&&!interaction.deferred)await interaction.reply({content:"❌ An error occurred.",flags:MessageFlags.Ephemeral});}catch{}
  }
});

// ─── REACTION ADD / REMOVE ────────────────────────────────────────────────────
client.on("messageReactionAdd",    async(r,u)=>{if(u.bot)return;if(r.partial)try{await r.fetch();}catch{return;}await handleReactionRole(r,u,true);});
client.on("messageReactionRemove", async(r,u)=>{if(u.bot)return;if(r.partial)try{await r.fetch();}catch{return;}await handleReactionRole(r,u,false);});

// ─── MESSAGE CREATE ───────────────────────────────────────────────────────────
client.on("messageCreate", async msg=>{
  if(msg.author.bot||!msg.guild)return;
  if(msg.channel.id===ENV.STICKY_CH)refreshSticky(msg.channel).catch(()=>{});

  // Partnership ad waiting
  if(partnerAwaitAd.has(msg.channel.id)){
    const pd=partnerAwaitAd.get(msg.channel.id);
    if(msg.author.id===pd.member.id&&msg.content.trim().length>=20){
      partnerAwaitAd.delete(msg.channel.id);
      setImmediate(async()=>{
        try{
          const {formAnswers}=pd, adText=msg.content.trim(), banner=msg.attachments.first()?.url||null;
          if(!ENV.PARTNER_AD_CH)return;
          const g=client.guilds.cache.get(ENV.HOME_GUILD); if(!g)return;
          const ch=await g.channels.fetch(ENV.PARTNER_AD_CH).catch(()=>null); if(!ch?.isTextBased())return;
          const emb=new EmbedBuilder().setColor(C.note).setTitle(formAnswers.serverName||"New Partner")
            .setDescription(`${adText}\n\u200b`).addFields({name:"👥 Members",value:formAnswers.memberCount||"—",inline:true},{name:"🎯 Focus",value:formAnswers.focus||"—",inline:true},{name:"🤝 Offering",value:formAnswers.offering||"—"},{name:"🔗 Join",value:formAnswers.invite||"—"})
            .setFooter(ft("Partnerships")).setTimestamp();
          if(banner)emb.setImage(banner);
          await ch.send({embeds:[emb]});
          await msg.channel.send({embeds:[E.success("✅ Partnership Posted!").setDescription(`Your ad is live in <#${ENV.PARTNER_AD_CH}>! 💗\n\nThis ticket closes in 15 seconds.`)]});
          setTimeout(()=>msg.channel.delete("Partnership posted").catch(()=>{}),15000);
        }catch(err){console.error("[PartnerAd]",err.message);}
      });
      return;
    }
  }

  // Forum AI
  if(ENV.FORUM_CH&&msg.channel.isThread?.()&&msg.channel.parentId===ENV.FORUM_CH&&GROQ_API_KEY){
    const key=`forum:${msg.channel.id}:${msg.author.id}`, last=aiCooldowns.get(key)||0;
    if(Date.now()-last>=8000){
      aiCooldowns.set(key,Date.now());
      setImmediate(async()=>{const {text,model}=await callTicketAI(`forum_${msg.channel.id}`,msg.content,"inquiry",null);if(text)await msg.channel.send({embeds:[aiEmbed(text,model,msg.author.username,"forum")]}).catch(()=>{});});
    }
    return;
  }

  // Ticket AI
  if(msg.channel.name?.startsWith("ticket-")&&!msg.content.startsWith(PREFIX)){
    const s=getSettings(msg.guild.id);
    const staff=isStaff(msg.member);
    const typeMatch=msg.channel.topic?.match(/^\[(\w+)\]/);
    const ticketType=typeMatch?typeMatch[1]:"inquiry";
    if(!staff&&s.ticketAI!==false&&GROQ_API_KEY&&!ticketAIOff.has(msg.channel.id)&&ticketType!=="order"){
      const key=`${msg.channel.id}:${msg.author.id}`, last=aiCooldowns.get(key)||0;
      if(Date.now()-last>=8000){
        aiCooldowns.set(key,Date.now());
        setImmediate(async()=>{const {text,model}=await callTicketAI(msg.channel.id,msg.content,ticketType,null);if(text)await msg.channel.send({embeds:[aiEmbed(text,model,msg.author.username,ticketType)]}).catch(()=>{});});
      }
    }
  }

  // XP / coins / trivia
  if(!msg.content.startsWith(PREFIX)){
    grantXP(msg).catch(()=>{});
    grantCoins(msg).catch(()=>{});
    if(data.triviaActive[msg.channel.id]){
      const tv=data.triviaActive[msg.channel.id];
      if(tv.answers.some(a=>msg.content.trim().toLowerCase().includes(a.toLowerCase()))){
        getEco(msg.author.id).coins=(getEco(msg.author.id).coins||0)+tv.coins;
        delete data.triviaActive[msg.channel.id]; saveData();
        await msg.reply({embeds:[E.success("🧠 Correct!").setDescription(`**+${tv.coins} 🪙** added to your balance!`).setFooter(ft())]}).catch(()=>{});
      }
    }
    return;
  }

  // Prefix commands
  if(data.blacklist.includes(msg.author.id))return;
  const rawArgs=msg.content.slice(PREFIX.length).trim().split(/\s+/);
  const cmd=rawArgs.shift()?.toLowerCase();
  if(!cmd)return;
  try{ await execCommand(cmd,makePrefixCtx(msg,rawArgs)); }
  catch(err){ console.error(`[Prefix ${cmd}]`,err.message); await sendErrorLog(err,`Prefix: s!${cmd}`); }
});

// ─── FORUM THREAD CREATE ──────────────────────────────────────────────────────
client.on("threadCreate", async thread=>{
  try{
    if(!ENV.FORUM_CH||thread.parentId!==ENV.FORUM_CH)return;
    await thread.join().catch(()=>{});
    if(!GROQ_API_KEY)return;
    const {text,model}=await callTicketAI(`forum_${thread.id}`,`New support thread: "${thread.name}". Greet the user warmly, introduce yourself as Snuggles AI, and ask them to describe their Roblox scripting issue in detail.`,"inquiry",null);
    if(text)await thread.send({embeds:[aiEmbed(text,model,"Support","forum")]});
  }catch(err){console.error("[threadCreate]",err.message);}
});

// ─── GUILD EVENTS ─────────────────────────────────────────────────────────────
client.on("guildCreate", async g=>{
  console.log(`Joined: ${g.name}`); updateStatus();
  await cacheInvites(g).catch(()=>{});
  const ch=g.channels.cache.filter(c=>c.type===ChannelType.GuildText&&c.permissionsFor(g.members.me)?.has(PermissionFlagsBits.SendMessages)).sort((a,b)=>a.rawPosition-b.rawPosition).first();
  if(ch)await ch.send({embeds:[new EmbedBuilder().setColor(C.brand).setTitle(`🧸 ${BOT_NAME} v${BOT_VERSION} — Thanks for adding me!`)
    .setDescription(["**Quick Setup:**","","`/setlog #channel` — mod log","`/setreviews #channel` — reviews","`/settranscripts #channel` — transcripts","`/setverifyrole @role` — Roblox verify","`/setscamchannel #channel` — scam reports","`/ticketpanel` — post ticket panel","","Run `s!setup` for the full guide | `s!help` for all commands"].join("\n"))
    .setFooter({text:`${BOT_NAME} v${BOT_VERSION} · Made with 💗 by ${BOT_OWNER}`}).setTimestamp()]}).catch(()=>{});
});
client.on("guildDelete", g=>{console.log(`Left: ${g.name}`);updateStatus();});

client.on("inviteCreate", inv=>{if(!inv.guild)return;if(!data.inviteCache[inv.guild.id])data.inviteCache[inv.guild.id]={};data.inviteCache[inv.guild.id][inv.code]=inv.uses||0;saveData();});
client.on("inviteDelete", inv=>{if(!inv.guild)return;if(data.inviteCache[inv.guild.id])delete data.inviteCache[inv.guild.id][inv.code];saveData();});

client.on("guildMemberAdd", async member=>{
  try{
    await handleAntiRaidJoin(member);
    const g=member.guild;
    const newInv=await g.invites.fetch().catch(()=>null);
    if(newInv){
      const cached=data.inviteCache[g.id]||{};
      let inviterId=null;
      newInv.forEach(inv=>{if((inv.uses||0)>(cached[inv.code]||0)){inviterId=inv.inviter?.id;}cached[inv.code]=inv.uses||0;});
      data.inviteCache[g.id]=cached;
      if(inviterId){if(!data.invites[g.id])data.invites[g.id]={};if(!data.invites[g.id][inviterId])data.invites[g.id][inviterId]={invited:0,left:0};data.invites[g.id][inviterId].invited++;}
      saveData();
    }
    await logMod(g,E.success("📥 Member Joined")
      .setThumbnail(member.user.displayAvatarURL())
      .addFields(
        {name:"👤 User",        value:`<@${member.id}> (${member.user.tag})`,inline:true},
        {name:"📅 Account Age", value:`<t:${Math.floor(member.user.createdTimestamp/1000)}:R>`,inline:true},
      ).setTimestamp());
  }catch{}
});

client.on("guildMemberRemove", async member=>{
  try{
    if(data.invites[member.guild.id]){for(const inv of Object.values(data.invites[member.guild.id])){inv.left++;break;}saveData();}
    await logMod(member.guild,E.error("📤 Member Left")
      .setThumbnail(member.user.displayAvatarURL())
      .addFields({name:"👤 User",value:`<@${member.id}> (${member.user.tag})`,inline:true})
      .setTimestamp());
  }catch{}
});

client.on("messageDelete", async msg=>{
  try{
    if(!msg.guild||msg.author?.bot||msg.partial||!msg.content)return;
    await logMod(msg.guild,E.error("🗑️ Message Deleted")
      .addFields({name:"Author",value:`<@${msg.author.id}>`,inline:true},{name:"Channel",value:`<#${msg.channel.id}>`,inline:true},{name:"Content",value:msg.content.slice(0,1024)})
      .setTimestamp());
  }catch{}
});

client.on("messageUpdate", async(o,n)=>{
  try{
    if(!n.guild||n.author?.bot||o.partial||n.partial||o.content===n.content)return;
    await logMod(n.guild,E.warn("✏️ Message Edited")
      .addFields({name:"Author",value:`<@${n.author.id}>`,inline:true},{name:"Channel",value:`<#${n.channel.id}>`,inline:true},{name:"Before",value:(o.content||"—").slice(0,1024)},{name:"After",value:(n.content||"—").slice(0,1024)},{name:"Link",value:`[Jump](${n.url})`,inline:true})
      .setTimestamp());
  }catch{}
});

client.on("channelDelete", async ch=>{
  try{
    if(!ch.guild)return;
    await logMod(ch.guild,E.error("💬 Channel Deleted").addFields({name:"Name",value:ch.name,inline:true}).setTimestamp());
    const logs=await ch.guild.fetchAuditLogs({type:AuditLogEvent.ChannelDelete,limit:1}).catch(()=>null);
    if(logs){const e=logs.entries.first();if(e)await checkNuke(ch.guild,e.executor.id,"channelDelete");}
  }catch{}
});

client.on("roleDelete", async r=>{
  try{
    await logMod(r.guild,E.error("🎭 Role Deleted").addFields({name:"Name",value:r.name,inline:true}).setTimestamp());
    const logs=await r.guild.fetchAuditLogs({type:AuditLogEvent.RoleDelete,limit:1}).catch(()=>null);
    if(logs){const e=logs.entries.first();if(e)await checkNuke(r.guild,e.executor.id,"roleDelete");}
  }catch{}
});

client.on("guildBanAdd", async ban=>{
  try{
    await logMod(ban.guild,E.error("🔨 Member Banned").addFields({name:"User",value:`${ban.user.tag}`},{name:"Reason",value:ban.reason||"No reason"}).setTimestamp());
    const logs=await ban.guild.fetchAuditLogs({type:AuditLogEvent.MemberBanAdd,limit:1}).catch(()=>null);
    if(logs){const e=logs.entries.first();if(e)await checkNuke(ban.guild,e.executor.id,"ban");}
  }catch{}
});

client.on("guildBanRemove", async ban=>{
  try{await logMod(ban.guild,E.success("🔓 Member Unbanned").addFields({name:"User",value:`${ban.user.tag}`}).setTimestamp());}catch{}
});

// ─── BOT READY ────────────────────────────────────────────────────────────────
client.once("clientReady", async()=>{
  console.log(`✅  ${BOT_NAME} v${BOT_VERSION} — ${client.user.tag}`);
  console.log(`🤖  AI: ${GROQ_API_KEY?"Groq Enabled":"Disabled"}`);
  console.log(`🖼️   Images: ${STABILITY_API_KEY?"Stability AI":"Pollinations (fallback)"}`);
  await registerSlashCommands();
  for(const [,g] of client.guilds.cache) await cacheInvites(g).catch(()=>{});
  updateStatus();
  setInterval(updateStatus,     5*60000);
  setInterval(checkGiveaways,   10000);
  setInterval(updateOrderBoard, 3*3600000);
  setTimeout(updateOrderBoard,  6000);
});

// ─── ERROR HANDLERS ───────────────────────────────────────────────────────────
client.on("error", err=>{console.error("Client error:",err.message);sendErrorLog(err,"Client error");});
process.on("unhandledRejection", err=>{
  const msg=String(err?.message||err);
  if(msg.includes("Sign in to confirm")||msg.includes("live stream"))return;
  console.error("Unhandled rejection:",msg);
  sendErrorLog(err,"Unhandled rejection");
});
process.on("uncaughtException", err=>{console.error("Uncaught exception:",err);sendErrorLog(err,"Uncaught exception");});

// ─── LOGIN ────────────────────────────────────────────────────────────────────
client.login(TOKEN);
