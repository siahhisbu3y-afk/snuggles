};

// ─── ECONOMY / XP CONSTANTS ───────────────────────────────────────────────────
const XP_PER_MSG   = 15, XP_COOLDOWN = 60_000, XP_VARIANCE = 10;
const BASE_XP      = 100, XP_SCALE   = 1.35;
const COINS_PER_MSG= 5,   COINS_CD   = 30_000;
const xpForLevel   = lv => Math.floor(BASE_XP * Math.pow(XP_SCALE, lv - 1));
const randInt      = (min, max) => Math.floor(Math.random() * (max - min + 1)) + min;

const TIME = { s:1000, m:60000, h:3600000, d:86400000 };
function parseDuration(str) {
  const m = String(str || "").toLowerCase().trim().match(/^(\d+)\s*(s|m|h|d)?$/);
  if (!m) return null;
  const ms = parseInt(m[1]) * (TIME[m[2] || "m"]);
  return Number.isFinite(ms) && ms > 0 ? ms : null;
}
function fmtDuration(ms) {
  const d=Math.floor(ms/TIME.d), h=Math.floor((ms%TIME.d)/TIME.h),
        m=Math.floor((ms%TIME.h)/TIME.m), s=Math.floor((ms%TIME.m)/TIME.s);
  return [d&&`${d}d`,h&&`${h}h`,m&&`${m}m`,(!d&&!h&&s)?`${s}s`:null].filter(Boolean).join(" ")||"0s";
}

