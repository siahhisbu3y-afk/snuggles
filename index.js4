async function openTicket(guild, member, ticketType, formAnswers) {
  if (!guild||!member) return {ok:false,error:"Must be used in a server."};
  const s = getSettings(guild.id);
  const safeName = member.user.username.toLowerCase().replace(/[^a-z0-9]/g,"").slice(0,16)||"user";
  let chanName = `ticket-${safeName}`;
  const maxOpen = s.maxOpenTickets||1;
  const existing = guild.channels.cache.filter(c=>c.type===ChannelType.GuildText&&c.name.startsWith("ticket-")&&c.permissionOverwrites.cache.has(member.id));
  if (existing.size>=maxOpen) return {ok:false,error:`You already have **${existing.size}** open ticket(s). Max is **${maxOpen}**.`};
  if (guild.channels.cache.find(c=>c.name===chanName)) chanName+=`-${Date.now().toString(36).slice(-4)}`;
  const staffRoles = s.ticketStaffRoles||[];
  const overwrites = [
    {id:guild.roles.everyone.id, deny:[PermissionFlagsBits.ViewChannel]},
    {id:member.id, allow:[PermissionFlagsBits.ViewChannel,PermissionFlagsBits.SendMessages,PermissionFlagsBits.ReadMessageHistory,PermissionFlagsBits.AttachFiles]},
    {id:client.user.id, allow:[PermissionFlagsBits.ViewChannel,PermissionFlagsBits.SendMessages,PermissionFlagsBits.ManageChannels,PermissionFlagsBits.ReadMessageHistory]},
  ];
  for (const r of staffRoles) overwrites.push({id:r,allow:[PermissionFlagsBits.ViewChannel,PermissionFlagsBits.SendMessages,PermissionFlagsBits.ReadMessageHistory,PermissionFlagsBits.AttachFiles,PermissionFlagsBits.ManageMessages]});
  guild.roles.cache.forEach(r=>{if(r.permissions.has(PermissionFlagsBits.ManageMessages)&&!r.managed&&!staffRoles.includes(r.id))overwrites.push({id:r.id,allow:[PermissionFlagsBits.ViewChannel,PermissionFlagsBits.SendMessages,PermissionFlagsBits.ReadMessageHistory]});});
  let created;
  try { created=await guild.channels.create({name:chanName,type:ChannelType.GuildText,topic:`[${ticketType}] ${member.user.tag}`,permissionOverwrites:overwrites,parent:s.ticketCategoryId||undefined,reason:`Ticket by ${member.user.tag}`}); }
  catch { return {ok:false,error:"Failed to create channel — check **Manage Channels** permission."}; }
  data.stats.ticketsOpened=(data.stats.ticketsOpened||0)+1; saveData();

  const closeRow = new ActionRowBuilder().addComponents(
    new ButtonBuilder().setCustomId("ticket_close_btn").setLabel("Close Ticket").setStyle(ButtonStyle.Danger).setEmoji("🔒")
  );

  let detailEmb, formCtx="";
  if (ticketType==="order") {
    formCtx=`Roblox: ${formAnswers.username}\nService: ${formAnswers.service}\nDesc: ${formAnswers.description}\nBudget: ${formAnswers.budget}\nPayment: ${formAnswers.payment}`;
    detailEmb = E.brand("📦 New Commission Order")
      .setDescription(`> Welcome <@${member.id}>! Our team will review your order shortly.${hasOrdered(member.id)?"\n> 🎟️ **Returning customer — 5% loyalty discount applied!**":""}`)
      .addFields(
        {name:"👤 Roblox Username",value:formAnswers.username||"—",inline:true},
        {name:"🛠️ Service Type",   value:formAnswers.service||"—",  inline:true},
        {name:"💳 Payment Method",  value:formAnswers.payment||"—",  inline:true},
        {name:"💰 Budget",          value:formAnswers.budget||"—",   inline:true},
        {name:"📝 Description",     value:formAnswers.description||"—"},
      ).setFooter(ft(`Order · ${member.user.tag}`)).setTimestamp();
  } else if (ticketType==="partnership") {
    formCtx=`Server: ${formAnswers.serverName}\nInvite: ${formAnswers.invite}\nMembers: ${formAnswers.memberCount}\nFocus: ${formAnswers.focus}\nOffering: ${formAnswers.offering}`;
    detailEmb = E.success("🤝 Partnership Request")
      .addFields(
        {name:"🏠 Server Name",    value:formAnswers.serverName||"—",  inline:true},
        {name:"👥 Member Count",   value:formAnswers.memberCount||"—", inline:true},
        {name:"🎯 Server Focus",   value:formAnswers.focus||"—",       inline:true},
        {name:"🔗 Invite Link",    value:formAnswers.invite||"—"},
        {name:"🤝 What You Offer", value:formAnswers.offering||"—"},
      ).setFooter(ft(`Partnership · ${member.user.tag}`)).setTimestamp();
  } else {
    formCtx=`Name: ${formAnswers.name}\nTopic: ${formAnswers.topic}\nDetails: ${formAnswers.details}\nUrgency: ${formAnswers.urgency||"Not specified"}`;
    detailEmb = E.info("❓ Support Inquiry")
      .addFields(
        {name:"👤 Name",    value:formAnswers.name||"—",    inline:true},
        {name:"❓ Topic",   value:formAnswers.topic||"—",   inline:true},
        {name:"⚡ Urgency", value:formAnswers.urgency||"Not specified", inline:true},
        {name:"📝 Details", value:formAnswers.details||"—"},
      ).setFooter(ft(`Inquiry · ${member.user.tag}`)).setTimestamp();
  }

  await created.send({content:`<@${member.id}> Welcome to your ticket!${s.ticketGreeting?"\n> "+s.ticketGreeting:""}`,embeds:[detailEmb],components:[closeRow]});

  if (ticketType!=="order") {
    setImmediate(async()=>{
      try {
        if (ticketType==="partnership") {
          const count = parseInt(String(formAnswers.memberCount||"0").replace(/,/g,"").match(/\d+/)?.[0]||"0",10);
          if (count>0 && count<45) {
            await created.send({embeds:[E.error("❌ Partnership Requirement Not Met")
              .setDescription(`Thank you for your interest in partnering with **${BOT_NAME}**!\n\nWe require a minimum of **45 members**. You currently have **${count}**.\n\nFeel free to re-apply once you've grown your community! 🌸`)
              .setFooter(ft("Re-apply anytime!")).setTimestamp()]});
            setTimeout(()=>created.delete("Partnership declined").catch(()=>{}),15000);
            return;
          }
          partnerAwaitAd.set(created.id,{member,formAnswers,count});
        }
        const prompt = ticketType==="partnership"
          ? `New partnership ticket. ${formCtx}\nMember count meets the 45 minimum. Greet them warmly and ask for their server ad text.`
          : `New inquiry ticket.\n${formCtx}\nRespond helpfully and completely.`;
        const {text,model} = await callTicketAI(created.id,prompt,ticketType,formCtx);
        if (text) await created.send({embeds:[aiEmbed(text,model,member.user.username,ticketType)]});
      } catch(e) { console.error("[TicketAI]",e.message); }
    });
  }
  return {ok:true,channel:created};
}

async function closeTicket(channel, closer, reason, guild) {
  let ownerId=null;
  for (const [id,o] of channel.permissionOverwrites.cache){if(o.type===1){ownerId=id;break;}}
  const msgs=[]; let lastId;
  for (let i=0;i<10;i++){
    const b=await channel.messages.fetch({limit:100,...(lastId?{before:lastId}:{})}).catch(()=>null);
    if(!b?.size)break; msgs.push(...b.values()); lastId=b.last().id; if(b.size<100)break;
  }
  msgs.sort((a,b)=>a.createdTimestamp-b.createdTimestamp);
  const transcript=[
    `Transcript: #${channel.name}`, `Server: ${guild.name}`,
    `Closed by: ${closer.user?.tag||closer.tag||"—"}`, `Reason: ${reason}`,
    `Messages: ${msgs.length}`, `Date: ${new Date().toISOString()}`, "─".repeat(50),"",
    ...msgs.map(m=>`[${new Date(m.createdTimestamp).toISOString()}] ${m.author.tag}: ${m.content||"[no text]"}${m.embeds.length?` [${m.embeds.length} embed]`:""}`)
  ].join("\n");
  const file = {attachment:Buffer.from(transcript,"utf8"),name:`${channel.name}-transcript.txt`};
  const st=getSettings(guild.id); const tcId=st.transcriptsChannelId||data.modLogChannels[guild.id];
  if(tcId){const tc=await guild.channels.fetch(tcId).catch(()=>null);if(tc?.isTextBased())tc.send({embeds:[E.brand("🎟️ Ticket Closed").addFields({name:"Channel",value:`#${channel.name}`},{name:"Closed By",value:closer.user?.tag||closer.tag||"—",inline:true},{name:"Reason",value:reason,inline:true}).setTimestamp()],files:[file]}).catch(()=>{});}
  if(ownerId){try{const u=await client.users.fetch(ownerId);u.send({embeds:[E.brand("🎟️ Ticket Closed").setDescription(`**#${channel.name}** has been closed.\n**Reason:** ${reason}`)],files:[{attachment:Buffer.from(transcript,"utf8"),name:`${channel.name}-transcript.txt`}]});}catch{}}
  ticketConvos.delete(channel.id); ticketAIOff.delete(channel.id); partnerAwaitAd.delete(channel.id);
  data.stats.ticketsClosed=(data.stats.ticketsClosed||0)+1; saveData();
  await channel.send({embeds:[E.warn("🔒 Closing in 5 seconds…").setDescription(`**Reason:** ${reason}`)]}).catch(()=>{});
  setTimeout(()=>channel.delete(`Ticket closed: ${reason}`).catch(()=>{}),5000);
}

// ─── HELP PAGES ───────────────────────────────────────────────────────────────
function buildHelp(page=1) {
  const icon = client.user?.displayAvatarURL();
  const auth = { name:`${BOT_NAME} v${BOT_VERSION}`, iconURL:icon };
  const div = "─────────────────────────────";

  const pages = [
    // PAGE 1 — General & AI
    E.brand("📖 Help — General & AI")
      .setAuthor(auth)
      .setDescription(`> Use \`s!\` prefix **or** \`/\` slash commands!\n> \`s!help 2\` for next page\n${div}`)
      .addFields(
        {name:"🌐 General",value:"`help [1-6]` · `info` · `ping` · `status` · `rules`\n`uptime` · `invite` · `setup`"},
        {name:"🤖 AI Chat",value:"`ai <message>` — Chat with Snuggles AI (remembers history)\n`ai-reset` — Clear your conversation history"},
        {name:"🎨 Image Generation",value:"`imagine <prompt> [style]` — Generate an AI image\n**Styles:** `realistic` `anime` `cartoon` `fantasy` `minimal` `pixel` `oil` `sketch`"},
        {name:"🔊 Ticket AI Controls *(staff)*",value:"`aioff` — Disable AI in this ticket\n`aion` — Re-enable AI in this ticket"},
      )
      .setFooter({text:`Page 1/6 · ${FOOTER}`}),

    // PAGE 2 — Commissions & Scripting
    E.info("📖 Help — Commissions & Scripting")
      .setAuthor(auth)
      .setDescription(div)
      .addFields(
        {name:"💼 Commissions",value:"`services` · `prices` · `pay` · `ticket`\n`orderinfo <id>` · `discount` · `portfolio [page]`"},
        {name:"🖥️ Scripting Resources",value:"`script <ui|datastore|remote|movement|admin>`\n`snippet` · `docs` · `debug` · `tip`"},
      )
      .setFooter({text:`Page 2/6 · ${FOOTER}`}),

    // PAGE 3 — Leveling, Economy, Reviews
    E.xp("📖 Help — Leveling, Economy & Reviews")
      .setAuthor(auth)
      .setDescription(div)
      .addFields(
        {name:"📊 Leveling",value:"`level [@user]` · `rank [@user]` · `leaderboard`\n`setlevelupchannel <#ch>` *(admin)*"},
        {name:"💰 Economy",value:"`balance [@user]` · `dowork` *(1h cd)* · `daily` *(24h cd)*\n`shop` · `buy <id>` · `givecoins <@user> <amt>` *(admin)*"},
        {name:"🛍️ Shop Items",value:"`role_color` 500🪙 · `code_review` 300🪙 · `priority_queue` 750🪙\n`vip_ping` 1000🪙 · `og_badge` 2000🪙 · `ai_image` 150🪙"},
        {name:"⭐ Reviews",value:"`review <1-5> <type> <message>` · `vouch <text>`"},
      )
      .setFooter({text:`Page 3/6 · ${FOOTER}`}),

    // PAGE 4 — Fun & Info
    E.gold("📖 Help — Fun & Info")
      .setAuthor(auth)
      .setDescription(div)
      .addFields(
        {name:"🎮 Fun",value:"`8ball <q>` · `quote` · `meme` · `rate <x>` · `coinflip`\n`roll [max]` · `rps <r|p|s>` · `trivia` · `remindme <time> <msg>`\n`color <hex>` · `calc <expr>`"},
        {name:"ℹ️ Info",value:"`userinfo [@user]` · `serverinfo` · `avatar [@user]`\n`banner [@user]` · `servericon` · `stats` · `invites [@user]` · `inviteleaderboard`"},
        {name:"🟣 Roblox Verification",value:"`verify <username>` · `checkverify <code>` · `whois [@user]`\n`unverify` · `verifypanel <#ch>` *(admin)*"},
      )
      .setFooter({text:`Page 4/6 · ${FOOTER}`}),

    // PAGE 5 — Moderation & Admin
    E.make(C.error,"📖 Help — Moderation & Admin")
      .setAuthor(auth)
      .setDescription(div)
      .addFields(
        {name:"🔨 Moderation *(Manage Messages+)*",value:"`ban <@u> [reason] [days]` · `softban <@u> [reason]` · `kick <@u>`\n`mute <@u> <time> [reason]` · `unmute <@u>`\n`warn <@u> <reason>` · `warns <@u>` · `unwarn <id>` · `clearwarns <@u>`\n`modlogs <@u>` · `purge <1-100> [@u]`\n`lock` · `unlock` · `slowmode <s>` · `nick <@u> [name]`"},
        {name:"⚙️ Admin *(Administrator)*",value:"`announce <msg> [#ch]` · `say <msg>` · `embed <title> <body>`\n`poll <q> | <opt1> | <opt2>` · `giveaway <dur> <prize>`\n`ticketpanel` · `close <reason>` · `addnote <text>`\n`addorder` · `updateorder` · `complete` · `blacklist`\n`setlog` · `setreviews` · `settranscripts` · `setverifyrole`\n`setscamchannel` · `setlevelupchannel`"},
        {name:"🚨 Scam Reports *(Staff)*",value:"`reportscammer <@u> <evidence> [amount] [roblox]`\n`scammerlist`"},
        {name:"💾 Backup *(Admin)*",value:"`backup create` · `backup list` · `backup view <id>`"},
      )
      .setFooter({text:`Page 5/6 · ${FOOTER}`}),

    // PAGE 6 — Security & Tickets
    E.make(C.note,"📖 Help — Security & Tickets")
      .setAuthor(auth)
      .setDescription(div)
      .addFields(
        {name:"🛡️ Anti-Raid *(Admin)*",value:"`antiraid enable/disable/status`\n`antiraid config [threshold] [window] [action] [autounlock] [#notify]`\n`antiraid whitelist/unwhitelist <@u>`"},
        {name:"☢️ Anti-Nuke *(Admin)*",value:"`antinuke enable/disable/status`\n`antinuke config [banth] [channelth] [roleth] [kickth] [action] [#notify]`\n`antinuke trust/untrust <@u>`"},
        {name:"🎭 Reaction Roles *(Manage Roles)*",value:"`reactionrole add <msgID> <emoji> <@role>`\n`reactionrole remove <msgID> <emoji>`\n`reactionrole list` · `reactionrole panel <title> <desc>`"},
        {name:"🎫 Ticket System",value:"`ticketpanel` — Posts the ticket panel\n📦 **Order** *(staff)* · 🤝 **Partnership** *(AI)* · ❓ **Inquiry** *(AI 24/7)*\n`close <reason>` · `addnote <text>` · `aioff` · `aion`"},
      )
      .setFooter({text:`Page 6/6 · ${FOOTER}`}),
  ];
  return pages[Math.max(0, Math.min(page-1, pages.length-1))];
}

